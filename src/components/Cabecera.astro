---
/**
 * Cabecera: barra del player + navegación. Del artboard `Cabecera-Beat`.
 *
 * 🔴 El player va AQUÍ y es PERSISTENTE, y eso es requisito de producto, no
 * decisión técnica. El §4.1 del `Mapa de sitio Beat 2026.pdf` lo dice así: "la
 * decisión de producto más importante del sitio es esta: el reproductor en vivo es
 * persistente… no es un detalle técnico, es la afirmación, en la propia
 * experiencia de usuario, de que Beat sigue siendo, antes que cualquier otra cosa,
 * una estación de radio en vivo".
 *
 * Por eso lleva `transition:persist`: con View Transitions el DOM se reemplaza
 * completo en cada navegación, y sin esto la señal se cortaría al cambiar de
 * página.
 *
 * ⏳ Los controles están MAQUETADOS pero todavía no CABLEADOS: el SDK de Triton, el
 * polling del now-playing y el volumen llegan en B6, al portar el núcleo de
 * `player.js`. Los `data-*` de aquí son los enganches que ese código va a usar.
 * El texto del now-playing sí se renderiza en el servidor, con el fallback
 * documentado ("Beat 100.9") cuando la bitácora no tiene nada.
 */
import Icono from './Icono.astro';
import { SECCIONES } from '@/config/navegacion';
import type { Estacion } from '@/lib/cms/estacion';

interface Props {
  estacion: Estacion;
  /**
   * Nace con la barra oscura recogida. Lo pone `Base.astro` en los interiores.
   *
   * ⚠️ Solo vale para la PRIMERA carga. Este bloque lleva `transition:persist`, o
   * sea que al navegar el navegador conserva el nodo vivo y descarta el marcado
   * que manda el servidor — si la señal se cortara al cambiar de página no habría
   * radio persistente. De la reconciliación en cada navegación se encarga
   * `cabecera.ts`, que lee `document.body.dataset.vista`.
   */
  compacta?: boolean;
}

const { estacion, compacta = false } = Astro.props;
const ruta = Astro.url.pathname;

/**
 * El texto de partida, antes de que exista una conexión.
 *
 * 🔴 Ya NO sale del CMS. Lo que suena lo manda el SDK de Triton por el canal de
 * cue points, dentro del propio stream, así que llega alineado con lo que el
 * oyente escucha — la bitácora es la hora del playout y va 5 s por delante
 * (medido). Y consultarla costaba una petición al CMS en cada página del sitio,
 * para un dato que solo es cierto si alguien está escuchando.
 *
 * Así que hasta el primer cue point la barra dice la marca. No es un hueco: es lo
 * único verdadero que se puede decir antes de que el oyente pulse play.
 */
const sonando = estacion.nombre;

/**
 * Las barras de la onda: 72 en escritorio, 18 en móvil.
 *
 * Cada una lleva su propio periodo, amplitud y retardo. Es lo que hace que NO se
 * lea como una ola de estadio, que es como se veía cuando todas compartían la
 * misma animación con un desfase progresivo.
 *
 * Deterministas a propósito (`Math.sin` sobre el índice, sin `Math.random`): el
 * SSR y el cliente tienen que producir el mismo marcado o Astro reporta
 * desajuste de hidratación, y además el diseño se ve igual en cada carga.
 *
 * La amplitud cae hacia los agudos —las barras de la izquierda son más altas—
 * porque así se ve un espectro de verdad: la energía vive en los graves.
 */
const barras = (n: number) =>
  Array.from({ length: n }, (_, i) => {
    const t = i / n;
    // Envolvente descendente con ondulación, para que no sea una rampa limpia.
    const pico = 0.34 + 0.62 * (1 - t) ** 1.5 + 0.12 * Math.sin(i * 2.3);
    return {
      i,
      // Periodos entre ~520 y ~1180 ms, sin relación armónica entre vecinas.
      dur: Math.round(520 + 330 * (1 + Math.sin(i * 1.13)) + 60 * Math.sin(i * 0.37)),
      // Segundo ritmo, deliberadamente NO múltiplo del primero: el ciclo compuesto
      // es su mínimo común múltiplo, así que en la práctica no se repite.
      dur2: Math.round(1450 + 900 * (1 + Math.sin(i * 0.71 + 2.1))),
      peak: Math.min(1, Math.max(0.22, pico)).toFixed(3),
      delay: Math.round((i * 137) % 900),
    };
  });
const activo = (href: string) => ruta === href || ruta.startsWith(`${href}/`);
---

<div
  id="beat-cabecera"
  transition:persist="cabecera"
  data-compacta={compacta ? '' : undefined}
  class="sticky top-0 z-header"
>
  {/*
    BARRA DEL PLAYER — clara sobre un sitio oscuro. Es la única inversión de la
    paleta en todo el sitio, y es deliberada: lo que está al aire es lo que brilla.
  */}
  <div
    id="player"
    data-status="init"
    data-modo="directo"
    data-mount={estacion.tritonMount}
    class="flex h-player items-center gap-3 bg-mist-0 px-4 text-noche-0 md:gap-4 md:px-6"
  >
    {/*
      El wordmark en la barra CLARA. Aparece solo cuando la barra oscura se recoge,
      así que las dos nunca lo enseñan a la vez: se lee como que el logo pasa de una
      a la otra.

      🔴 `filter: invert(1)` y no un archivo aparte. El SVG es blanco y esta barra
      también, así que hay que darle la vuelta — pero mantener dos archivos que
      tienen que decir exactamente lo mismo es garantía de que un día dejen de
      decirlo. Un filtro no puede desincronizarse del original.
    */}
    <a
      href="/"
      class="cabecera-logo-claro flex-none"
      aria-label={`${estacion.nombrePublicacion} — Inicio`}
      tabindex={compacta ? undefined : '-1'}
    >
      <img src="/img/beat-blanco.svg" alt={estacion.nombre} width="155" height="36" />
    </a>

    <span class="solo-directo flex flex-none items-center gap-2">
      {/*
        🔴 ROJO, y es el único color de la interfaz. Es la luz de tally de un
        estudio: la convención dice «estamos emitiendo», que es exactamente lo que
        esta barra afirma. Ver el token `--rojo-aire` en `beat.css`.

        `motion-safe:` porque el parpadeo perpetuo es de lo primero que
        `prefers-reduced-motion` existe para quitar.
      */}
      <span
        class="h-[7px] w-[7px] flex-none rounded-pill bg-[var(--rojo-aire)] motion-safe:animate-pulse"
      ></span>
      <span class="t-label whitespace-nowrap text-[8px] md:text-[9px]">
        Al aire
      </span>
    </span>

    {/*
      🔴 La puerta de vuelta, y no es un adorno: mientras suena una pista a
      demanda, el oyente está FUERA de la señal. Este sitio afirma ser una radio en
      vivo —§4.1 del mapa de sitio— así que sacar a alguien del directo sin una
      salida visible sería una trampa, no una función.

      Ocupa el mismo sitio que el indicador de aire, así que la barra no cambia de
      geometría al pasar de un modo a otro: cambia lo que dice.
    */}
    <button
      type="button"
      data-accion="directo"
      aria-label="Volver a la transmisión en vivo"
      class="solo-pista player-volver flex-none items-center gap-2"
    >
      <span
        class="h-[7px] w-[7px] flex-none rounded-pill bg-[var(--rojo-aire)] motion-safe:animate-pulse"
      ></span>
      {/*
        ⚠️ Dice «EN VIVO», no «volver al directo». «Directo» es español de España;
        acá se dice en vivo, y es además la palabra que ya usa la sección
        `/en-vivo` y la que dice la propia barra cuando está al aire. Decisión de
        Carlos, 2026-09-03.

        El `aria-label` del botón sí lleva la frase completa: el texto visible
        puede ser corto porque el punto rojo y el contexto lo explican, pero quien
        lo oye sin verlo necesita la acción entera.
      */}
      <span class="t-label whitespace-nowrap text-[8px] md:text-[9px]">
        En vivo
      </span>
    </button>

    <span class="solo-directo hidden h-[18px] w-px flex-none bg-[var(--onair-rule)] md:block"></span>

    <button
      type="button"
      data-accion="play"
      aria-label={`Escuchar ${estacion.nombre} en vivo`}
      aria-pressed="false"
      disabled
      aria-busy="true"
      class="beat-play-emite grid h-[40px] w-[40px] flex-none place-items-center rounded-pill bg-noche-0 text-mist-0 disabled:opacity-60 transition-colors duration-2 ease-out hover:bg-graphite-4"
    >
      <span data-icono="play" class="contents"><Icono nombre="play" tamano={17} /></span>
      <span data-icono="pause" class="contents hidden"><Icono nombre="pause" tamano={17} /></span>
      {/* Anillo de progreso indeterminado: un arco de 3/4 girando. */}
      <span data-icono="cargando" class="hidden">
        <svg
          class="player-spinner"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M12 3a9 9 0 1 0 9 9" />
        </svg>
      </span>
    </button>

    {/*
      🔴 En ROJO, el mismo `--rojo-aire` del punto que parpadea. Decisión de
      Carlos (2026-09-03) y es coherente: el punto y este texto dicen lo mismo —
      esto es lo que está sonando AHORA— así que comparten color. Es la única
      excepción al blanco y negro y no se abre una segunda; ver movimiento.md §8.
    */}
    <span class="solo-directo player-info min-w-0 flex-1 md:flex-none">
      <span
        data-campo="sonando"
        class="player-sonando block truncate font-text text-[12px] font-semibold leading-tight md:text-[13px]"
      >{sonando}</span>
      {/*
        La hora a la que empezó a sonar, del propio cue point. Nace vacía: hasta
        que el SDK manda el primero no hay nada que decir, y un hueco reservado es
        preferible a inventar una hora.
      */}
      <span data-campo="hora" class="player-hora block truncate"></span>
    </span>

    {/*
      🔴 El título de la pista va en SU PROPIO elemento, no reutilizando el de
      arriba. `player.ts` guarda el texto original de `[data-campo="sonando"]` para
      poder restaurarlo tras un corte comercial; si la pista escribiera ahí, ese
      «original» pasaría a ser el nombre de una canción de Bonus Beat y el radio
      volvería del anuncio anunciando la pista. Dos modos, dos elementos, cero
      estado compartido.
    */}
    <span
      data-campo="pista"
      class="solo-pista min-w-0 flex-1 truncate font-text text-[12px] font-semibold leading-tight md:flex-none md:text-[13px]"
    ></span>

    {/*
      Waveform. Decorativa: el dato real es el texto de al lado.

      🔴 En MÓVIL no va. Ocupaba 52px de una barra de 343, y con eso el título de
      lo que suena se quedaba en **5 píxeles** —medido a 375px, con «Beat 100.9»
      reducido a una letra—. Es el peor reparto posible: la barra existe para
      decir qué suena, y lo que sobrevivía era el adorno. La onda vuelve a partir
      de 900px, donde sí sobra sitio.
    */}
    <span class="solo-directo hidden h-4 flex-none items-center gap-[1.5px] md:flex md:h-5 md:w-auto md:flex-1" aria-hidden="true">
      {barras(72).map((b) => (
        <span
          class="onda-barra hidden h-full flex-1 bg-[var(--onair-wave)] md:block"
          style={`--i:${b.i};--dur:${b.dur}ms;--dur2:${b.dur2}ms;--peak:${b.peak};--delay:${b.delay}ms`}
        ></span>
      ))}
    </span>

    {/*
      El avance de la pista, en el hueco que deja la onda.

      Es un `range` y no una barra pintada: así se puede BUSCAR, y además con el
      teclado, que es lo que un `div` con un ancho no da. Solo escritorio, igual
      que la onda: a 375px la barra no tiene sitio y lo que importa ahí es el
      título y el play.
    */}
    <label class="solo-pista sr-only" for="beat-progreso">Avance de la pista</label>
    <input
      id="beat-progreso"
      data-accion="progreso"
      type="range"
      min="0"
      max="0"
      value="0"
      disabled
      class="solo-pista player-progreso hidden md:flex-1"
    />

    {/* Volumen: solo escritorio. En móvil lo controla el sistema. */}
    <span class="hidden flex-none items-center gap-2 md:flex">
      <Icono nombre="volume-2" tamano={16} />
      <label class="sr-only" for="beat-volumen">Volumen</label>
      <input
        id="beat-volumen"
        data-accion="volumen"
        type="range"
        min="0"
        max="100"
        value="62"
        class="player-volumen w-[72px]"
      />
    </span>

    {/*
      ⚠️ En MÓVIL no se pinta, y es un intercambio medido: a 375px la barra no da
      para los dos, y de los dos este es el que hoy no hace nada —el
      comportamiento del player ampliado está pendiente— mientras que la
      hamburguesa es la ÚNICA forma de abrir el menú en un interior, donde la
      barra oscura va recogida. Antes de esto, en un teléfono no había manera de
      navegar el sitio salvo por el pie.
    */}
    <button
      type="button"
      data-accion="expandir"
      aria-label="Ampliar el reproductor"
      class="hidden h-7 w-7 flex-none place-items-center shadow-[inset_0_0_0_1px_var(--onair-ring)] md:grid md:h-8 md:w-8"
    >
      <Icono nombre="chevron-down" tamano={14} />
    </button>

    <button
      type="button"
      data-accion="menu"
      aria-label="Abrir el menú"
      aria-expanded="false"
      aria-controls="beat-menu"
      class="cabecera-menu-claro beat-hamburguesa grid h-8 w-8 flex-none place-items-center bg-noche-0 text-mist-0"
      tabindex={compacta ? undefined : '-1'}
    >
      {/*
        🔴 Tres barras y no un icono, para que se CONVIERTA en X en vez de
        cambiarse por otro dibujo. El demo que trajo Carlos lo hace así y tiene
        razón: el cambio de estado se lee como un solo objeto que se transforma,
        no como dos iconos que se turnan. La forma la decide el CSS mirando
        `aria-expanded`, que es el estado que ya hay que mantener de todos modos.
      */}
      <span class="hb" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>

  {/* NAVEGACIÓN */}
  {/*
    🔴 `inert={compacta}` y NO `inert={compacta ? '' : undefined}`. `inert` es un
    atributo booleano y Astro lo pinta cuando el valor es CIERTO; una cadena vacía
    es falsa, así que la versión «correcta en HTML» no se emitía nunca. Comprobado
    en el HTML servido: cero apariciones de `inert`, y la barra plegada seguía
    siendo navegable con el tabulador.
  */}
  <header
    inert={compacta}
    class="flex h-header-movil items-center gap-2 bg-surface-card px-4 shadow-[inset_0_-1px_0_var(--border-quiet)] md:h-header md:gap-6 md:px-6"
  >
    <a href="/" class="flex-none" aria-label={`${estacion.nombrePublicacion} — Inicio`}>
      <img
        src="/img/beat-blanco.svg"
        alt={estacion.nombre}
        width="155"
        height="36"
        class="beat-wordmark-emite block h-[30px] w-auto md:h-[36px]"
      />
    </a>

    <nav aria-label="Secciones" class="hidden md:flex md:gap-5">
      {/*
        Los enlaces van en BLANCO y NEGRITA (decisión de Carlos, 2026-08-24). Antes
        el activo iba en el ámbar de marca y el resto en gris.

        🔴 La sección en curso se marca en BLANCO Y NEGRITA, y el resto en gris sin
        negrita. Antes llevaba una línea coral debajo, que era el último naranja que
        quedaba en la interfaz.

        El PESO es lo que sostiene la accesibilidad: WCAG 1.4.1 pide que el color no
        sea el único portador, y la negrita no es color — es una diferencia
        tipográfica, visible también para quien no distingue tonos.

        ⚠️ Ni el color ni el peso van como utilidades de Tailwind aquí. Las
        utilidades viven en una capa POSTERIOR a `proyecto`, así que desde `beat.css`
        no habría forma de cambiarlos: `font-bold text-mist-0` en esta línea dejaba
        los cinco enlaces idénticos y sin manera de distinguir el activo salvo
        añadiéndole algo encima. Que es exactamente de dónde salió la línea coral.

        ⚠️ Y el comentario va AQUÍ, no entre los atributos del `<a>`. Astro no admite
        comentarios dentro de la lista de atributos: los parsea como atributos
        sueltos, y en este archivo eso produjo dos errores de tipo sobre la palabra
        «color» que estuvieron commiteados sin que nadie los viera. Es el cuarto
        tropiezo igual en el repo.
      */}
      {SECCIONES.map((s) =>
        s.pendiente ? (
          <span
            class="t-label cursor-default whitespace-nowrap text-[9.5px] text-state-disabled-text"
            title="En construcción"
          >{s.corto}</span>
        ) : (
          <a
            href={s.href}
            aria-current={activo(s.href) ? 'page' : undefined}
            class:list={[
              'beat-nav-enlace t-label whitespace-nowrap text-[9.5px]',
              { 'es-activo': activo(s.href) },
            ]}
          >{s.corto}</a>
        ),
      )}
    </nav>

    {/*
      Sin buscador. Beat no lo lleva (decisión de Carlos, 2026-08-24), así que el
      botón se retira en vez de dejarlo inerte: un control que no hace nada enseña
      al lector a desconfiar de los demás.

      El `ml-auto` que lo empujaba a la derecha pasa a la hamburguesa, que ahora es
      lo último de la fila.
    */}

    {/* Hamburguesa solo en móvil: en escritorio vive en la barra del player. */}
    <button
      type="button"
      data-accion="menu"
      aria-label="Abrir el menú"
      aria-expanded="false"
      aria-controls="beat-menu"
      class="beat-hamburguesa ml-auto grid h-11 w-11 flex-none place-items-center bg-mist-0 text-noche-0 md:hidden"
    >
      <span class="hb es-grande" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </header>

  {/*
    🔴 `#td_container` lo exige el SDK: es el `playerId` de su módulo MediaPlayer,
    y ahí monta el elemento de audio y el pre-roll VAST. Tiene que estar DENTRO
    del bloque con `transition:persist`, porque si el elemento de audio se
    destruye al navegar, la señal se corta.

    ⚠️ Estuvo FUERA por un `</div>` mal puesto: el comentario decía «va dentro del
    bloque persistente» y el div quedaba después del cierre. El efecto era el
    exacto contrario del que se buscaba —Astro lo reemplazaba por un div vacío en
    cada navegación—, y no se notaba porque la cabecera sí persistía: lo visible
    seguía ahí y solo se iba el audio. Comprobado con un testigo en `dataset`
    antes y después de navegar.
  */}
  <div id="td_container" class="td-contenedor" aria-hidden="true"></div>

  {/*
    El telón del anuncio. Va aquí dentro por la misma razón que el contenedor: si
    el DOM lo reemplazara al navegar, un anuncio en curso se quedaría con el telón
    puesto y sin nada detrás.
  */}
  <div id="td-telon" class="td-telon" hidden></div>
</div>

<script>
  import { prepararPlayer } from '@/scripts/player';
  prepararPlayer();
</script>

<style>
  /*
    ── La hamburguesa que se convierte en X ──

    Tres barras absolutas dentro de una caja: la de en medio se desvanece y las
    otras dos se juntan en el centro y giran. Todo el estado sale de
    `aria-expanded`, que es el atributo que de todas formas hay que mantener
    correcto — así no hay una clase que pueda desincronizarse de la accesibilidad.
  */
  /*
    ⚠️ `cursor: pointer` a mano. Tailwind 4 ya NO lo pone en los `<button>` —lo
    quitó de su preflight en la v4— así que un botón se comporta como texto: el
    puntero no cambia y el control no se anuncia como pulsable. Vale para las dos
    hamburguesas y para cualquier botón del chrome que se añada después.
  */
  .beat-hamburguesa {
    cursor: pointer;
  }
  .hb {
    position: relative;
    display: block;
    width: 16px;
    height: 12px;
  }
  .hb.es-grande {
    width: 20px;
    height: 14px;
  }
  .hb i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition:
      translate var(--dur-2) var(--ease-out),
      rotate var(--dur-2) var(--ease-out),
      opacity var(--dur-1, 120ms) var(--ease-out);
  }
  .hb i:nth-child(1) { top: 0; }
  .hb i:nth-child(2) { top: calc(50% - 1px); }
  .hb i:nth-child(3) { bottom: 0; }

  /*
    🔴 Las barras se mueven con `translate` y `rotate` INDEPENDIENTES, no con un
    `transform` compuesto. Es la regla de movimiento.md §1: dos gestos sobre el
    mismo elemento van en propiedades distintas, así ninguno pisa al otro y cada
    uno puede animarse por su cuenta.
  */
  [aria-expanded='true'] .hb i:nth-child(1) {
    translate: 0 calc(50% + 4px);
    rotate: 45deg;
  }
  [aria-expanded='true'] .hb.es-grande i:nth-child(1) {
    translate: 0 calc(50% + 5px);
  }
  [aria-expanded='true'] .hb i:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded='true'] .hb i:nth-child(3) {
    translate: 0 calc(-50% - 4px);
    rotate: -45deg;
  }
  [aria-expanded='true'] .hb.es-grande i:nth-child(3) {
    translate: 0 calc(-50% - 5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hb i {
      transition: none;
    }
  }

  /* El texto de lo que suena: el rojo de «al aire». */
  .player-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.15;
  }
  .player-sonando {
    color: var(--rojo-aire);
  }
  /*
    La hora, muy chica y en gris: es un dato de apoyo, no la afirmación. Va en el
    gris oscuro de la barra clara —no en el rojo— para que el ojo lea primero la
    canción, que es lo que se vino a saber.
  */
  .player-hora {
    margin-top: 2px;
    font: var(--type-label);
    font-size: 8px;
    letter-spacing: var(--track-label);
    color: var(--graphite-2);
  }
  .player-hora:empty {
    display: none;
  }

  /*
    ── Los dos modos de la barra ──

    🔴 Vive AQUÍ y no en `beat.css` por la misma razón que el plegado: los anchos
    y los `display` de esta barra los ponen utilidades de Tailwind, que van en una
    capa POSTERIOR a `proyecto`. Desde allí un `display: none` no gana ni con toda
    la especificidad del mundo. Los estilos de un componente Astro no llevan capa,
    así que ganan a todas.

    Es lo que permite apagar la onda (`hidden md:flex`) en modo pista sin recurrir
    a `!important`.
  */
