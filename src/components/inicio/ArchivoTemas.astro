---
/**
 * El archivo del Fenómeno Residente en el Inicio — la rejilla de tres con el
 * número gigante, y el box de 300×250 pegado al costado.
 *
 * Los temas anteriores, no el vigente: el de la semana ya tiene su bloque arriba.
 */
import Anuncio from '@/components/Anuncio.astro';
import { urlMedia } from '@/lib/cms/client';
import type { Especiale } from '@/types/payload';

interface Props {
  temas: Especiale[];
  /** El vigente, que se excluye de la rejilla porque ya está arriba. */
  excluir?: number | null;
  /**
   * Cuántos se pintan. `null` = todos.
   *
   * En el Inicio son tres —es un adelanto del archivo, no el archivo—; en
   * `/fenomeno-residente` no se corta nada, porque ahí la lista completa ES la
   * página.
   */
  limite?: number | null;
  /**
   * El box de 300×250 pegado al costado.
   *
   * Va en el Inicio, donde este bloque comparte pantalla con otras seis secciones.
   * En la sección propia se retira: la rejilla es el contenido principal de la
   * página y no debe encogerse 300px para hacerle sitio a un anuncio, que además
   * ya tiene su hueco más abajo.
   */
  riel?: boolean;
}

const { temas, excluir = null, limite = 3, riel = true } = Astro.props;

const filtrados = temas.filter((t) => t.id !== excluir);
const anteriores = limite == null ? filtrados : filtrados.slice(0, limite);
---

{
  anteriores.length > 0 && (
    <section class:list={['at', { 'sin-riel': !riel }]}>
      <div class="at-rejilla">
        {anteriores.map((t) => {
          const portada = urlMedia(t.portada, 'card');
          return (
            <a href={`/especiales/${t.slug}`} class="at-tema" data-luz>
              <div class="at-numero-caja">
                {portada && <img src={portada} alt="" loading="lazy" decoding="async" />}
                <div class="beat-grid at-trama" />
                {t.numero != null && (
                  <span class="beat-display at-numero">{String(t.numero).padStart(2, '0')}</span>
                )}
                {t.estado === 'archivado' && (
                  <span class="beat-label at-estado">CERRADO</span>
                )}
              </div>
              <div class="at-titulo">{t.titulo}</div>
              {t.etiquetaPublica && <span class="beat-label at-nota">{t.etiquetaPublica}</span>}
            </a>
          );
        })}
      </div>

      {riel && (
        <aside class="at-riel">
          <Anuncio formato="box" nombre="inicio-box" unidad="Box2" />
        </aside>
      )}
    </section>
  )
}

<style>
  .at {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px;
    align-items: start;
    margin-top: 38px;
    padding: 0 24px;
  }
  .at-rejilla {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    background: var(--border-hairline);
    padding: 2px;
  }
  .at-tema {
    display: block;
    background: var(--noche-1);
    padding-bottom: 16px;
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-2) var(--ease-out);
  }
  .at-tema:hover {
    background: var(--noche-2);
  }
  .at-tema:hover .at-titulo {
    color: var(--mist-0);
  }
  .at-numero-caja {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--grad-noche);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .at-numero-caja img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La foto va atenuada porque el protagonista es el NÚMERO: es el archivo, y
       lo que se busca ahí es «el tema 07», no una imagen. */
    opacity: 0.42;
  }
  .at-trama {
    position: absolute;
    inset: 0;
  }
  .at-numero {
    position: relative;
    font-size: 52px;
    font-weight: 800;
    color: var(--mist-1);
  }
  .at-estado {
    position: absolute;
    right: 12px;
    top: 12px;
    font-size: 9px;
    color: var(--text-faint);
  }
  .at-titulo {
    font: 600 15px / 1.25 var(--font-text);
    color: var(--mist-2);
    padding: 14px 16px 0;
    text-wrap: pretty;
  }
  .at-nota {
    display: block;
    padding: 8px 16px 0;
    font-size: 9px;
    color: var(--text-faint);
  }
  .at-riel {
    position: sticky;
    top: calc(var(--chrome-h) + 16px);
  }
  /* Sin box al lado, la rejilla ocupa el ancho entero. */
  .at.sin-riel {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 1199px) {
    .at {
      grid-template-columns: 1fr;
    }
    .at-riel {
      position: static;
      justify-self: center;
    }
  }
  @media (max-width: 899px) {
    .at {
      margin-top: 26px;
      padding: 0 16px;
      gap: 20px;
    }
    .at-rejilla {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .at-numero {
      font-size: 34px;
    }
    .at-titulo {
      font-size: 14px;
      padding: 12px 14px 0;
    }
  }
</style>
