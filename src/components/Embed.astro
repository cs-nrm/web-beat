---
/**
 * El bloque `embed` del contenido Lexical.
 *
 * El CMS guarda **solo la URL**, nunca HTML crudo del editor — es una decisión
 * de seguridad explícita de `src/blocks/Embed.ts`: *"el frontend arma el
 * <iframe>/embed real a partir de la URL, en vez de insertar HTML que venga del
 * editor"*. Este componente es esa mitad del contrato, así que la URL se **valida
 * y se reconstruye**; nunca se interpola tal cual en un atributo.
 *
 * Y todos van por `<iframe>`, sin el script de la plataforma. Instagram,
 * Facebook y X ofrecen un `embed.js` que es lo que casi todo el mundo pega, y cada
 * uno pesa entre 100 y 300 KB, corre en el documento principal y rastrea al lector
 * en toda la página. Sus rutas `/embed` hacen lo mismo dentro de un iframe aislado
 * y con `loading="lazy"` no cuestan nada hasta que se acercan.
 *
 * «Otro» es la excepción: cualquier URL https entra tal cual, porque no hay
 * patrón que reconstruir. Lo que la contiene es el `sandbox`, no la validación
 * (decisión de producto del 19 oct 2026, frente a una lista de dominios).
 */
interface Props {
  plataforma: 'youtube' | 'twitter' | 'instagram' | 'facebook' | 'otro' | null | undefined;
  url: string | null | undefined;
  /** Alto en px del iframe genérico. Lo pone la redacción; ver `ALTO_GENERICO`. */
  alto?: unknown;
}

const { plataforma, url, alto } = Astro.props;

/**
 * Alto del iframe genérico cuando el CMS no trae uno. Una página arbitraria no
 * tiene proporción conocida, así que va a alto fijo y lo que sobre se desplaza
 * dentro del marco. El registro de Xibalba mide 2372px a 1024 de ancho: ningún
 * valor por defecto lo cubre, por eso el CMS necesita el campo `alto`.
 */
const ALTO_GENERICO = 720;
const altoGenerico =
  typeof alto === 'number' && alto >= 200 && alto <= 3000 ? Math.round(alto) : ALTO_GENERICO;

/**
 * Lo que puede hacer una página de «otro». Formularios, scripts, ventanas
 * nuevas y su propio origen (sin él no guarda sesión ni cookies, y los
 * formularios de registro se rompen).
 *
 * Fuera a propósito: `allow-top-navigation` y sus variantes. Con ellas el
 * marco puede llevarse al lector fuera de la nota. Un enlace del marco que
 * quiera salir abre pestaña nueva por `allow-popups`.
 */
const SANDBOX_GENERICO =
  'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-presentation';

/**
 * Hosts que son el sitio mismo. Trampa: `allow-scripts` + `allow-same-origin`
 * en un marco de NUESTRO origen deja que la página se quite el sandbox, así que
 * «otro» nunca enmarca el propio dominio. Se miran los dos porque detrás del
 * proxy `Astro.url` puede no traer el host público.
 */
const hostsPropios = new Set([Astro.url.host, Astro.site?.host].filter(Boolean));

/**
 * Convierte la URL editorial en la URL de inserción de la plataforma.
 *
 * Devuelve `null` cuando no se reconoce, y entonces NO se pinta un iframe: se
 * degrada a un enlace. Es deliberado — un `<iframe>` a una URL que no supimos leer
 * es exactamente el agujero que el CMS quiso cerrar guardando solo la URL.
 */
function resolver(
  p: Props['plataforma'],
  crudo: string,
): {
  src: string;
  alto: string;
  /** Alto en px en vez de proporción: la página no tiene una conocida. */
  fijo?: boolean;
  /** Video en vertical: va por `aspect-ratio` y angosto. */
  vertical?: boolean;
  /** Página de un tercero sin patrón: va con `sandbox`. */
  generico?: boolean;
  titulo?: string;
} | null {
  let u: URL;
  try {
    u = new URL(crudo);
  } catch {
    return null;
  }
  // Solo https. Un `javascript:` o un `data:` en un src es ejecución en la página.
  if (u.protocol !== 'https:') return null;

  switch (p) {
    case 'youtube': {
      // Las cuatro formas que el editor puede pegar: watch?v=, youtu.be/, /shorts/, /embed/.
      const id =
        u.searchParams.get('v') ??
        (/^\/(shorts|embed|live)\//.test(u.pathname)
          ? u.pathname.split('/')[2]
          : u.hostname.endsWith('youtu.be')
            ? u.pathname.slice(1)
            : null);
      if (!id || !/^[\w-]{11}$/.test(id)) return null;
      // `-nocookie` no siembra cookies de perfilado hasta que se le da play.
      return { src: `https://www.youtube-nocookie.com/embed/${id}?rel=0`, alto: '56.25%' };
    }
    case 'instagram': {
      // /p/<code>/, /reel/<code>/ y /tv/<code>/ comparten la ruta de inserción.
      const m = u.pathname.match(/^\/(?:p|reel|tv)\/([\w-]+)/);
      if (!m) return null;
      return { src: `https://www.instagram.com/p/${m[1]}/embed/captioned/`, alto: '125%' };
    }
    case 'twitter': {
      const m = u.pathname.match(/\/status\/(\d+)/);
      if (!m) return null;
      return {
        src: `https://platform.twitter.com/embed/Tweet.html?id=${m[1]}&theme=dark`,
        alto: '80%',
      };
    }
    case 'facebook':
      return {
        src: `https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(u.href)}&show_text=true`,
        alto: '110%',
      };
    case 'otro': {
      if (hostsPropios.has(u.host)) return null;
      /*
        TikTok no está entre las plataformas del CMS y la redacción ya lo pega
        como «otro». Pero la página del video manda `X-Frame-Options: SAMEORIGIN`
        —medido el 19 oct 2026— y en un iframe se ve en blanco. Su reproductor
        `/player/v1/<id>` sí se deja enmarcar.
      */
      const tiktok = u.hostname.endsWith('tiktok.com') ? u.pathname.match(/\/video\/(\d+)/) : null;
      if (tiktok) {
        return {
          src: `https://www.tiktok.com/player/v1/${tiktok[1]}`,
          alto: '9 / 16',
          vertical: true,
          generico: true,
          titulo: 'Video de TikTok',
        };
      }
      return {
        src: u.href,
        alto: `${altoGenerico}px`,
        fijo: true,
        generico: true,
        titulo: `Contenido de ${u.hostname}`,
      };
    }
    default:
      return null;
  }
}

const insercion = url ? resolver(plataforma, url) : null;
---

{
  insercion ? (
    <figure
      class:list={[
        'embed-bloque',
        { 'es-fijo': insercion.fijo, 'es-vertical': insercion.vertical },
      ]}
      style={`--embed-alto:${insercion.alto}`}
    >
      <iframe
        src={insercion.src}
        loading="lazy"
        title={insercion.titulo ?? `Publicación de ${plataforma}`}
        allow={insercion.generico
          ? 'clipboard-write; encrypted-media; fullscreen; picture-in-picture'
          : 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture'}
        sandbox={insercion.generico ? SANDBOX_GENERICO : undefined}
        allowfullscreen
      />
    </figure>
  ) : url ? (
    /*
      Se degrada a enlace. Pasa cuando la URL no encaja con el patrón conocido,
      o cuando una de «otro» no es https o apunta al propio sitio: mejor un
      enlace que funciona que un iframe a una URL que no supimos leer.
    */
    <p class="embed-suelto">
      <a href={url} target="_blank" rel="noopener noreferrer nofollow">
        Ver la publicación en {plataforma === 'otro' ? 'el sitio original' : plataforma}
      </a>
    </p>
  ) : null
}

<style>
  .embed-bloque {
    position: relative;
    margin: var(--s-9) 0 0;
    padding-bottom: var(--embed-alto);
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
  }
  .embed-bloque iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .embed-bloque.es-fijo {
    padding-bottom: 0;
    height: var(--embed-alto);
  }
  /* Trampa: el `padding-bottom` en % se mide contra el ancho del PADRE, no del
     propio bloque, así que en un bloque angosto saldría el doble de alto. El
     vertical va por `aspect-ratio`, que sí mide contra sí mismo. */
  .embed-bloque.es-vertical {
    padding-bottom: 0;
    aspect-ratio: var(--embed-alto);
    max-width: 340px;
    margin-inline: auto;
  }
  .embed-suelto {
    margin: var(--s-9) 0 0;
    padding: var(--s-7) var(--s-8);
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    font: var(--type-body-sm);
  }
  .embed-suelto a {
    color: var(--text-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
