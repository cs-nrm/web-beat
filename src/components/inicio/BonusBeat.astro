---
/**
 * «BONUS BEAT» en el Inicio — el bloque de listas de 13a.
 *
 * Sale de `listas`, no de una colección propia: cada edición es una `lista` del
 * tipo «Bonus Beat», y su `canciones[].comentario` es la VIÑETA que el mapa de
 * sitio pedía («por qué está aquí, qué contar de ella»). Los enlaces a plataformas
 * salen gratis del catálogo de `canciones`.
 *
 * 🔴 La ruta se construye desde el SLUG del tipo, que es dato editorial. Este
 * componente no sabe que se llama «Bonus Beat»: recibe el tipo y lo usa.
 */
import Icono from '@/components/Icono.astro';
import { urlMedia, urlArchivo } from '@/lib/cms/client';
import { fechaCorta } from '@/lib/nota';
import type { Lista, TiposDeLista } from '@/types/payload';

interface Props {
  lista: Lista | null;
  tipo: TiposDeLista | null;
  /**
   * Dónde se pinta.
   *
   *   `inicio`  — con su barra de sección («BONUS BEAT · <fecha>») y el remate a
   *               todas las ediciones. Es un bloque entre otros.
   *   `edicion` — dentro de la sección: solo las canciones. El nombre y la fecha
   *               los lleva ya el encabezado de la página, y repetirlos dejaba el
   *               mismo rótulo dos veces con dos tipografías distintas.
   */
  contexto?: 'inicio' | 'edicion';
}

const { lista, tipo, contexto = 'inicio' } = Astro.props;

const enInicio = contexto === 'inicio';
const rutaTipo = tipo?.slug ? `/${tipo.slug}` : null;
const fecha = fechaCorta(lista?.fecha);

/**
 * Las plataformas de una canción, solo las que tienen enlace.
 *
 * Recibe `unknown` y no un tipo: `canciones[].cancion` es `number | Cancione`
 * según el `depth`, y el parámetro suelto evita un cast dentro de la plantilla —
 * que Astro no parsea cuando el cast lleva una unión.
 */
/**
 * El mp3 de la canción, si lo tiene.
 *
 * ⚠️ Recibe `unknown` y lee el campo a mano porque `canciones.audio` **todavía no
 * existe en el CMS**: es la pieza que falta para que Bonus Beat suene (una
 * relación a `media`, que ya acepta audio sin tocarlo — `Media.ts` no restringe
 * tipos y Sharp solo procesa imágenes).
 *
 * 🔴 Escrito así a propósito, y no esperando a que el campo exista: mientras no
 * esté, esto devuelve `null` y la fila se pinta EXACTAMENTE como hoy, con sus
 * enlaces a plataformas. El día que se capture el primer mp3 aparece el botón de
 * reproducir, sin desplegar nada. Lo contrario —dar por hecho el campo— dejaría la
 * página en blanco hasta que el CMS se moviera.
 */
function audioDe(c: unknown): string | null {
  if (!c || typeof c !== 'object') return null;
  const doc = c as Record<string, unknown>;
  return urlArchivo(doc.audio as Parameters<typeof urlArchivo>[0]);
}

function plataformasDe(c: unknown): Array<[string, string]> {
  if (!c || typeof c !== 'object') return [];
  const campos: Array<[string, string]> = [
    ['SPOTIFY', 'spotify'],
    ['APPLE', 'appleMusic'],
    ['YOUTUBE', 'youtube'],
    ['DEEZER', 'deezer'],
  ];
  const doc = c as Record<string, unknown>;
  return campos
    .map(([etiqueta, campo]): [string, unknown] => [etiqueta, doc[campo]])
    .filter((par): par is [string, string] => typeof par[1] === 'string' && par[1].length > 0);
}
---

{
  lista && (
    <section class:list={['bb', `es-${contexto}`]} data-pistas>
      {enInicio && (
      <div class="bb-cabeza">
        <h2 class="beat-display bb-seccion">{(tipo?.nombre ?? lista.titulo).toUpperCase()}</h2>
        {/*
          Solo la FECHA de la edición.

          ⚠️ Aquí decía «TRES TRACKS CADA VIERNES», que salía del lienzo. Se
          retiró por decisión de Carlos (2026-09-01): nadie ha comprometido esa
          periodicidad, y un rótulo fijo que promete un día de la semana se
          convierte en un desmentido el primer viernes que no haya edición. La
          fecha, en cambio, es un dato: dice cuándo es ESTA, sin prometer la
          siguiente.

          Si algún día la estación quiere anunciar una cadencia, el sitio para
          decirlo es `tipos-de-lista.descripcion` en el CMS —dato editorial— y no
          una cadena en este archivo.
        */}
        {fecha && <span class="beat-label bb-nota">{fecha}</span>}
      </div>
      )}

      {lista.canciones?.length ? (
        lista.canciones.map((c, i) => {
          const cancion = typeof c.cancion === 'object' ? c.cancion : null;
          const portada = urlMedia(cancion?.portada, 'thumbnail');
          const plataformas = plataformasDe(cancion);
          const pista = audioDe(cancion);
          return (
            <div class="bb-fila">
              <span class="beat-display bb-n">{String(i + 1).padStart(2, '0')}</span>
              {/*
                Con mp3, la portada ES el botón: es dónde se pulsa para escuchar
                una canción en cualquier sitio donde haya una portada, así que no
                hace falta enseñar un control aparte. Sin mp3 se queda como estaba
                —una imagen— en vez de un botón que no reproduce nada.

                🔴 `data-pista-*` es todo lo que `pista.ts` necesita: no hay una
                lista de canciones duplicada en el JavaScript, la página la declara.
              */}
              {pista ? (
                <button
                  type="button"
                  class="bb-portada bb-portada-btn"
                  data-pista-src={pista}
                  data-pista-titulo={cancion?.titulo ?? ''}
                  data-pista-artista={cancion?.artista ?? ''}
                  aria-pressed="false"
                  aria-label={`Reproducir ${cancion?.titulo ?? 'la pista'}`}
                >
                  {portada && <img src={portada} alt="" loading="lazy" decoding="async" />}
                  <div class="beat-grid bb-trama" />
                  <span class="bb-play">
                    <span class="bb-play-icono" data-icono="play">
                      <Icono nombre="play" tamano={16} />
                    </span>
                    <span class="bb-play-icono bb-play-pausa" data-icono="pause">
                      <Icono nombre="pause" tamano={16} />
                    </span>
                  </span>
                </button>
              ) : (
                <div class="bb-portada">
                  {portada && <img src={portada} alt="" loading="lazy" decoding="async" />}
                  <div class="beat-grid bb-trama" />
                </div>
              )}
              <div class="bb-texto">
                <span class="bb-titulo">{cancion?.titulo ?? '—'}</span>
                <span class="bb-linea">
                  {cancion?.artista}
                  {/* La viñeta es lo que distingue a Bonus Beat de una playlist
                      cualquiera: es el comentario editorial, no un dato del track. */}
                  {c.comentario && (
                    <>
                      {cancion?.artista && ' · '}
                      <span class="bb-vineta">{c.comentario}</span>
                    </>
                  )}
                </span>
              </div>
              {plataformas.length > 0 && (
                <div class="bb-plataformas">
                  {plataformas.map(([etiqueta, url]) => (
                    <a
                      href={url}
                      class="beat-label bb-plataforma"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {etiqueta}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })
      ) : (
        <p class="bb-vacio">
          Esta edición todavía no tiene canciones cargadas.
        </p>
      )}

      {enInicio && rutaTipo && (
        <div class="bb-pie">
          <a href={rutaTipo} class="beat-label bb-mas">
            VER TODAS LAS EDICIONES
          </a>
        </div>
      )}
    </section>
  )
}

<style>
  .bb {
    padding: 44px 24px 0;
  }
  /*
    En la sección propia el bloque no pone NADA de margen: ni arriba (el
    encabezado ya está ahí) ni a los lados (la página tiene el suyo). Con el
    padding puesto se sumaban los dos y las canciones quedaban 48px adentro
    mientras el titular empezaba a 24 — un escalón que no dice nada.
  */
  .bb.es-edicion {
    padding: 0;
  }
  .bb-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .bb-seccion {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
    margin: 0;
  }
  .bb-nota {
    color: var(--text-muted);
    text-align: right;
  }
  .bb-fila {
    display: grid;
    grid-template-columns: 44px 92px minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border-hairline);
  }
  .bb-n {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-faint);
  }
  .bb-portada {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--grad-noche);
    overflow: hidden;
  }
  .bb-portada img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bb-trama {
    position: absolute;
    inset: 0;
  }
  .bb-portada-btn {
    padding: 0;
    border: 0;
    cursor: pointer;
    color: inherit;
  }
  /*
    El play aparece al apuntar, y se queda puesto en la que suena.

    En reposo NO se ve: tres iconos de reproducir en fila son ruido, no
    información — la misma razón por la que las cápsulas del Fenómeno esconden el
    suyo. Lo que sí está siempre es el cursor de mano y el nombre accesible.
  */
  .bb-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(5 7 6 / 0.45);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .bb-portada-btn:hover .bb-play,
  .bb-portada-btn:focus-visible .bb-play,
  .bb-portada-btn[data-sonando] .bb-play {
    opacity: 1;
  }
  .bb-play-icono {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-pill);
    background: var(--mist-0);
    color: var(--noche-0);
  }
  /* Los dos iconos viven en el marcado y se alterna cuál se ve, como en la barra:
     no se reconstruye SVG en cada cambio de estado. */
  .bb-play-pausa {
    display: none;
  }
  .bb-portada-btn[data-sonando] .bb-play-icono[data-icono='play'] {
    display: none;
  }
  .bb-portada-btn[data-sonando] .bb-play-pausa {
    display: grid;
  }
  .bb-portada-btn[data-sonando] ~ .bb-texto .bb-titulo {
    color: var(--mist-0);
  }
  .bb-portada-btn:focus-visible {
    outline: 2px solid var(--mist-0);
    outline-offset: 2px;
  }
  .bb-texto {
    min-width: 0;
  }
  .bb-titulo {
    display: block;
    font: 600 19px / 1.24 var(--font-text);
    color: var(--mist-2);
  }
  .bb-linea {
    display: block;
    font: 500 14px / 1.4 var(--font-text);
    color: var(--text-muted);
    margin-top: 6px;
    text-wrap: pretty;
  }
  .bb-vineta {
    color: var(--text-body);
  }
  .bb-plataformas {
    display: flex;
    gap: 8px;
  }
  .bb-plataforma {
    padding: 9px 13px;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    color: var(--text-body);
    font-size: 9px;
    white-space: nowrap;
  }
  .bb-plataforma:hover {
    background: var(--mist-0);
    color: var(--noche-0);
  }
  .bb-vacio {
    font: var(--type-body-sm);
    color: var(--text-muted);
    padding: 20px 0 0;
  }
  .bb-pie {
    display: flex;
    justify-content: center;
    padding: 26px 0 0;
  }
  .bb-mas {
    padding: 13px 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--border-strong);
    color: var(--mist-2);
    font-size: 9px;
    white-space: nowrap;
  }
  .bb-mas:hover {
    background: var(--mist-0);
    color: var(--noche-0);
  }

  @media (max-width: 899px) {
    .bb {
      padding: 32px 16px 0;
    }
    .bb.es-edicion {
      padding: 0;
    }
    .bb-cabeza {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .bb-seccion {
      font-size: 20px;
    }
    .bb-nota {
      text-align: left;
      font-size: 8.5px;
    }
    /* La portada y el número se juntan arriba; las plataformas bajan a su fila. */
    .bb-fila {
      grid-template-columns: 30px 64px minmax(0, 1fr);
      gap: 12px;
      padding: 14px 0;
    }
    .bb-n {
      font-size: 17px;
    }
    .bb-titulo {
      font-size: 16px;
    }
    .bb-linea {
      font-size: 13px;
    }
    .bb-plataformas {
      grid-column: 2 / -1;
      margin-top: 10px;
      flex-wrap: wrap;
    }
    .bb-plataforma {
      padding: 8px 11px;
      font-size: 8px;
    }
  }
</style>
