---
/**
 * Un tema del Fenómeno Residente (o cualquier otro especial).
 *
 * La ruta es por COLECCIÓN y no por sección (`/especiales/<slug>`, decisión 10
 * del plan): un especial puede pertenecer a otra serie el día de mañana sin que
 * su URL cambie.
 *
 * La maqueta del tema es LA MISMA que la del Inicio y la de la sección — el
 * mismo componente, en su tercer contexto. Lo que aporta esta página es el marco:
 * el titular como `h1`, la migaja hacia la serie y los temas vecinos al pie.
 */
import Base from '@/layouts/Base.astro';
import CabezaSeccion from '@/components/CabezaSeccion.astro';
import Fenomeno from '@/components/inicio/Fenomeno.astro';
import ArchivoTemas from '@/components/inicio/ArchivoTemas.astro';
import Anuncio from '@/components/Anuncio.astro';
import { obtenerEspecial, obtenerEspeciales } from '@/lib/cms/especiales';
import { SERIE_FENOMENO } from '@/config/site';

const { slug } = Astro.params;

let especial = null;
try {
  especial = slug ? await obtenerEspecial(slug) : null;
} catch {
  /*
    Si el CMS no responde no se puede saber si el especial existe. Un 404 sería
    una mentira CACHEABLE —se queda pegado en el borde y en el índice—; un 503 es
    la verdad y no se indexa. Mismo reparto que en la nota.
  */
  return new Response('El CMS no responde. Vuelve a intentarlo en un momento.', {
    status: 503,
    headers: { 'cache-control': 'no-store', 'retry-after': '30' },
  });
}

if (!especial) return Astro.rewrite('/404');

/*
  La serie a la que pertenece, para saber a dónde vuelve la migaja. Si no es la del
  Fenómeno, la tira marca Fenómeno igual —no hay otra sección donde vivan los
  especiales— pero el archivo de abajo se pide de SU serie, no de otra.
*/
const serieSlug =
  especial.serie && typeof especial.serie === 'object' ? (especial.serie.slug ?? null) : null;

const vecinos = await obtenerEspeciales(serieSlug ?? SERIE_FENOMENO, 8);
const otros = vecinos.filter((t) => t.id !== especial.id);

/*
  ⚠️ Aquí se armaba el rótulo del encabezado —«TEMA 03 · 1 SEP 2026 — 7 SEP 2026»—
  y se retiró con el rótulo (2026-09-07). El número y el rango del tema siguen
  visibles donde importan: los pinta `Fenomeno.astro` en el bloque del tema.
*/
---

{/*
  🔴 El respaldo de la descripción YA NO es `etiquetaPublica`.

  Ese campo es un RÓTULO, no una frase: en el único tema capturado vale
  «Kraftwerk», nueve caracteres, y eso era la `<meta description>` y la bajada de
  la tarjeta de compartir de la página entera. Una descripción de una palabra no
  dice qué es la página, y al compartirse se lee como un error.

  Lo que va en su lugar se COMPONE con el título del tema, igual que ya hacen
  `/etiqueta/<slug>` y el índice de un tipo de lista. Y dice qué ES la página sin
  prometer qué trae: las cápsulas, el especial y la playlist se pintan solo si
  existen, así que enumerarlos aquí sería una lista que a veces miente.
*/}
<Base
  titulo={`${especial.titulo} — El Fenómeno Residente — Beat 100.9`}
  descripcion={
    especial.descripcion ??
    `${especial.titulo}, el tema de la semana de El Fenómeno Residente en Beat 100.9.`
  }
>
  <div class="es-pagina">
    <CabezaSeccion titulo={especial.titulo} activa="/fenomeno-residente" />

    {/*
      Mismo hueco y misma maqueta que `/fenomeno-residente` —la columna de la
      playlist— con nombre propio: son dos superficies distintas para quien compra,
      y con un solo nombre no se podría saber cuál de las dos entregó.

      ⚠️ En móvil esta columna baja y el box queda 32px por encima del leaderboard
      de esta página. Les pasa a las cuatro páginas de detalle con riel y está
      anotado en `agents/ads.md`: la salida sería mover el leaderboard debajo de
      «OTROS TEMAS», y mover un hueco que ya se vendió no es decisión de aquí.
    */}
    <Fenomeno especial={especial} contexto="tema" anuncio="especial-box" />

    <div class="es-franja-anuncio">
      <Anuncio formato="leaderboard" nombre="especial-leader" />
    </div>

    {
      otros.length > 0 && (
        <>
          <div class="es-corte" data-barrido>
            <span class="beat-display es-corte-titulo">OTROS TEMAS</span>
            <a href="/fenomeno-residente" class="beat-label es-corte-todo">
              VER EL ARCHIVO
            </a>
          </div>
          <ArchivoTemas temas={otros} limite={6} riel={false} />
        </>
      )
    }
  </div>
</Base>

<style>
  .es-pagina {
    max-width: var(--grid-max);
    margin: 0 auto;
  }
  .es-corte {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin: 12px 24px 0;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .es-corte-titulo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
  }
  .es-corte-todo {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .es-corte-todo:hover {
    color: var(--mist-0);
  }
  .es-franja-anuncio {
    padding: 44px 24px 32px;
  }

  @media (max-width: 899px) {
    .es-corte {
      margin: 8px 16px 0;
    }
    .es-corte-titulo {
      font-size: 19px;
    }
    .es-franja-anuncio {
      padding: 32px 16px 24px;
    }
  }
</style>
