---
/**
 * ⏳ PROVISIONAL — no es el Inicio.
 *
 * Es la prueba de humo de la capa de datos: resuelve la estación contra
 * `cms-estaciones` por `codigo`, y pide el "qué suena" a la bitácora. Sirve para
 * verificar de punta a punta que el SSR habla con el CMS, que el filtro por
 * estación se está inyectando, y que todo degrada en vez de tronar cuando el CMS
 * no está.
 *
 * El Inicio de verdad (§1 del mapa de sitio: "responde en 3 segundos: qué suena,
 * qué se cuenta, qué viene") llega con el design system — B3/B4 del plan.
 */
import Base from '@/layouts/Base.astro';
import { obtenerEstacion } from '@/lib/cms/estacion';
import { queSuena } from '@/lib/cms/aire';
import { CMS_URL, ESTACION_CODIGO } from '@/config/site';

let estacion = null;
let error: string | null = null;

try {
  estacion = await obtenerEstacion();
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const alAire = estacion ? await queSuena() : null;

// El mapa de sitio del relanzamiento, con su estado. Se queda mientras el sitio
// se construye: es la lista de trabajo visible.
const SECCIONES = [
  { n: 1, nombre: 'Inicio', ruta: '/', coleccion: '—', listo: false },
  { n: 2, nombre: 'Escuchar en vivo', ruta: '/en-vivo', coleccion: 'transmisiones + bitacora', listo: false },
  { n: 3, nombre: 'El Fenómeno Residente', ruta: '/fenomeno-residente', coleccion: 'especiales', listo: false },
  { n: 4, nombre: 'Bonus Beat', ruta: '/bonus-beat', coleccion: 'bonus-beat (falta en el CMS)', listo: false },
  { n: 5, nombre: 'Agenda / Eventos', ruta: '/eventos', coleccion: 'eventos (falta en el CMS)', listo: false },
  { n: 6, nombre: 'Comunidad', ruta: '/comunidad', coleccion: 'oyentes + playlists (faltan)', listo: false },
  { n: 7, nombre: 'Tienda', ruta: '/tienda', coleccion: 'productos (fase 2)', listo: false },
  { n: 8, nombre: 'Beat para marcas', ruta: '/marcas', coleccion: 'paginas (falta en el CMS)', listo: false },
  { n: 9, nombre: 'Programación', ruta: '/programacion', coleccion: 'programas', listo: false },
];
---

<Base titulo="web-beat v2 — scaffold" descripcion="Front Astro SSR de Beat 100.9 sobre cms-estaciones.">
  <main class="mx-auto max-w-3xl px-6 py-12 font-sans text-neutral-100 antialiased">
    <p class="mb-2 text-xs uppercase tracking-widest text-neutral-500">web-beat · rama beat</p>
    <h1 class="mb-8 text-3xl font-bold">Scaffold del relanzamiento</h1>

    <section class="mb-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-neutral-400">
        Conexión con el CMS
      </h2>
      {error ? (
        <div class="rounded border border-amber-600/40 bg-amber-950/30 p-4 text-sm">
          <p class="mb-2 font-semibold text-amber-300">Sin datos del CMS</p>
          <p class="mb-2 text-neutral-300">{error}</p>
          <p class="text-neutral-400">
            {CMS_URL
              ? 'El CMS no respondió. Comprueba que esté arriba y que la estación esté sembrada.'
              : 'Falta CMS_URL. Copia .env.example a .env — en desarrollo puedes apuntar al CMS de producción: su read es público.'}
          </p>
        </div>
      ) : (
        <dl class="grid grid-cols-[10rem_1fr] gap-y-2 text-sm">
          <dt class="text-neutral-500">codigo</dt>
          <dd><code>{estacion!.codigo}</code> <span class="text-neutral-500">(pedido: {ESTACION_CODIGO})</span></dd>
          <dt class="text-neutral-500">id resuelto</dt>
          <dd><code>{estacion!.id}</code></dd>
          <dt class="text-neutral-500">nombre</dt>
          <dd>{estacion!.nombre}</dd>
          <dt class="text-neutral-500">publicación</dt>
          <dd>{estacion!.nombrePublicacion}</dd>
          <dt class="text-neutral-500">dominio</dt>
          <dd>{estacion!.dominio}</dd>
          <dt class="text-neutral-500">mount de Triton</dt>
          <dd><code>{estacion!.tritonMount ?? '—'}</code></dd>
        </dl>
      )}
    </section>

    <section class="mb-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-neutral-400">
        Al aire
      </h2>
      {alAire ? (
        <p class="text-sm">
          <strong>{alAire.titulo}</strong>
          {alAire.artista && <span class="text-neutral-400"> — {alAire.artista}</span>}
        </p>
      ) : (
        <p class="text-sm text-neutral-400">
          La bitácora está vacía. Es lo esperado: ninguna estación tiene cargada la lista blanca
          <code class="mx-1">categoriasMusicales</code>, y la ingesta <strong>falla cerrado</strong>,
          así que descarta todo lo que manda el playout. Es la tarea A6 del plan.
        </p>
      )}
    </section>

    <section>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-neutral-400">
        Mapa de sitio
      </h2>
      <ul class="divide-y divide-neutral-800 text-sm">
        {SECCIONES.map((s) => (
          <li class="flex items-baseline gap-3 py-2">
            <span class="w-5 shrink-0 tabular-nums text-neutral-600">{s.n}</span>
            <span class="w-52 shrink-0 font-medium">{s.nombre}</span>
            <code class="w-40 shrink-0 text-neutral-500">{s.ruta}</code>
            <span class="text-neutral-500">{s.coleccion}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<style is:global>
  /* Provisional, solo para que el scaffold sea legible. Lo sustituye el DS. */
  body {
    background: #0b0b0c;
  }
</style>
