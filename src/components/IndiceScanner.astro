---
/**
 * El interior de una sección editorial. Pantallas 14b (1280) y 14e (390).
 *
 * Es un COMPONENTE y no una página porque CUATRO rutas lo usan con el mismo
 * marcado: las dos secciones editoriales —`/scanner` y `/editorial`—, una
 * categoría y una etiqueta. Duplicarlo significaría mantener 400 líneas de CSS en
 * cuatro archivos, que es exactamente como el sitio viejo terminó con los tokens
 * de marca repartidos.
 *
 * 🔴 Desde el 2026-09-07 recibe la SECCIÓN, y con ella filtra. Antes `/scanner`
 * lo usaba sin nada y traía todas las notas del sitio; ahora Beat Scanner (el día
 * a día) y Editorial (las elaboradas) son dos secciones distintas, cada una con su
 * categoría del CMS. Ver `SECCIONES_EDITORIALES` en `config/navegacion.ts`.
 */
import CabezaSeccion from '@/components/CabezaSeccion.astro';
import TarjetaNota from '@/components/TarjetaNota.astro';
import Anuncio from '@/components/Anuncio.astro';
import Icono from '@/components/Icono.astro';
import Paginador from '@/components/Paginador.astro';
import { obtenerScanner, filtroDeCategoria, type FiltroScanner } from '@/lib/cms/noticias';
import { nombreCategoria, fechaCorta } from '@/lib/nota';
import { urlMedia } from '@/lib/cms/client';
import type { SeccionEditorial } from '@/config/navegacion';

interface Props {
  /**
   * La sección editorial que se está pintando. La pone `/scanner` y `/editorial`.
   *
   * Con `filtro` puesto encima, ya no filtra —el filtro es más estrecho— y solo
   * sirve para marcar la tira de secciones y rotular «MÁS EN …».
   */
  seccion?: SeccionEditorial | null;
  /**
   * Un filtro MÁS ESTRECHO que la sección: una categoría (`/beat-scanner/<cat>`) o una
   * etiqueta (`/etiqueta/<slug>`). Cuando viene, manda él.
   */
  filtro?: FiltroScanner | null;
  /**
   * La página pedida, ya validada con `leerPagina`. La lee la PÁGINA y la pasa,
   * no se saca aquí de `Astro.url`: la misma cifra la necesita `<Base>` para su
   * canónica y su `<title>`, y dos lecturas de la URL en dos archivos distintos
   * es como se acaba con una canónica que apunta a otra página que la servida.
   */
  pagina?: number;
}

const { seccion = null, filtro = null, pagina = 1 } = Astro.props;

/*
  🔴 Si no hay un filtro más estrecho, filtra la SECCIÓN por su categoría.

  Y si esa categoría no existe en el CMS, `filtroDeCategoria` devuelve `null` — que
  NO se puede pasar tal cual a `obtenerScanner`, porque ahí `null` significa «sin
  filtro» y traería el sitio entero. Se marca aparte y la página se pinta vacía con
  su aviso: una sección que de pronto trae todas las notas se ve llena y nadie la
  reporta, mientras que una vacía con un texto que dice qué revisar se arregla el
  mismo día.
*/
const deLaSeccion = !filtro && seccion ? await filtroDeCategoria(seccion.categoria) : null;
const categoriaPerdida = Boolean(!filtro && seccion && !deLaSeccion);
const efectivo = filtro ?? deLaSeccion;

/**
 * Once por página: en la primera, 1 destacada + 6 de rejilla + 4 de las filas de
 * abajo; de la segunda en adelante, 6 + 5. Es una sola consulta repartida en
 * memoria, para que las zonas no puedan quedar desfasadas entre sí (ver el
 * comentario de `obtenerScanner`).
 */
const { destacada, rejilla, paginas } = categoriaPerdida
  ? { destacada: null, rejilla: [], paginas: 1 }
  : await obtenerScanner(10, efectivo, null, pagina);

/*
  El MISMO reparto en todas las páginas —seis en la cuadrícula y el resto en
  filas—, para que la sección no cambie de forma al pasar de página y el
  leaderboard no se mueva de sitio.

  ⚠️ `slice(6)` y no `slice(6, 10)`: en la página 1 son diez (la destacada salió
  de la tanda) y da lo mismo, pero de la 2 en adelante son ONCE, y el tope de 10
  se habría comido una nota por página sin decir nada. Es justo el fallo que este
  componente venía a arreglar, escrito en pequeño.
*/
const enRejilla = rejilla.slice(0, 6);
const enLista = rejilla.slice(6);
const hayNotas = Boolean(destacada) || rejilla.length > 0;

/*
  La ruta sobre la que cuelga el `?pagina=`: la de ESTA petición. Las cuatro
  vistas que usan este componente tienen path distinto —dos de ellas dinámico— y
  ninguna lleva otro parámetro en la URL.
*/
const rutaAqui = Astro.url.pathname;

/**
 * La fecha de la nota principal — el sello que sustituyó a sus minutos de lectura
 * (ver `TarjetaNota.astro`).
 *
 * ⚠️ Con este dato se rotulaba también «ACTUALIZADO <fecha>» encima del titular,
 * y ese rótulo se retiró el 2026-09-07: contaba el estado de la página que el
 * lector ya tiene delante. Ver `CabezaSeccion.astro`.
 */
const fechaDestacada = fechaCorta(destacada?.fecha ?? destacada?.createdAt);

const catDestacada = destacada ? nombreCategoria(destacada) : null;
const fotoDestacada = urlMedia(destacada?.imagen, 'large');

/*
  El titular cambia con el filtro: una categoría no se anuncia como si fuera la
  sección entera. La BAJADA se retiró —era relleno; ver `CabezaSeccion.astro`— y
  lo que describía sigue en la `<meta description>` de cada ruta.

  El rótulo de la sección sale de `SECCIONES_EDITORIALES` y NO del nombre de su
  categoría en el CMS: así la redacción puede renombrar la categoría sin que cambie
  el titular de una sección del sitio.
*/
const titulo = filtro ? filtro.nombre.toUpperCase() : (seccion?.rotulo ?? 'NOTAS');
/** Cómo se llama esto en los textos de dentro: «MÁS EN …», el aviso de vacío. */
const nombreAqui = filtro ? filtro.nombre : (seccion?.rotulo ?? 'esta sección');
---

  <div class="sc-envoltura">
    <CabezaSeccion titulo={titulo} activa={seccion?.href ?? null} />

    {
      hayNotas ? (
        <>
          {/*
            ── La nota principal, a dos columnas ──

            🔴 Solo en la PÁGINA 1. Antes toda esta rama colgaba de `destacada`, y
            con el paginador eso habría dejado la página 2 en blanco: `obtenerScanner`
            devuelve `destacada: null` de la segunda en adelante a propósito —no hay
            ninguna nota que sea «la principal» entre las once más viejas—. Lo que
            manda ahora es `hayNotas`.
          */}
          {destacada && (
          <a href={`/noticias/${destacada.slug}`} class="sc-lead" data-luz>
            <div class="sc-lead-foto" transition:name={`foto-nota-${destacada.id}`}>
              {fotoDestacada && (
                <img
                  src={fotoDestacada}
                  alt={
                    destacada.imagen && typeof destacada.imagen === 'object'
                      ? (destacada.imagen.alt ?? '')
                      : ''
                  }
                  fetchpriority="high"
                  decoding="async"
                />
              )}
              <div class="beat-grid sc-lead-trama" />
              {/* Las estelas del DS: son el motivo de marca, no decoración suelta. */}
              <div class="beat-streak sc-estela" />
              <div class="beat-streak is-soft sc-estela-suave" />
            </div>

            <div class="sc-lead-texto">
              <div class="sc-lead-meta">
                {catDestacada && <span class="beat-label sc-lead-cat">{catDestacada}</span>}
                {fechaDestacada && (
                  <span class="beat-label sc-lead-fecha">{fechaDestacada}</span>
                )}
              </div>
              <h2 class="sc-lead-titulo">{destacada.titulo}</h2>
              {destacada.resumen && <p class="sc-lead-bajada">{destacada.resumen}</p>}
              <span class="sc-lead-cta" data-flecha>
                Leer la nota
                <Icono nombre="arrow-up-right" tamano={16} />
              </span>
            </div>
          </a>
          )}

          {/* ── La rejilla de seis ── */}
          {enRejilla.length > 0 && (
            <div class:list={['sc-rejilla', { 'es-cabeza': !destacada }]}>
              {/*
                ⚠️ Sin destacada —página 2 en adelante— la primera fila de la
                cuadrícula es lo que está sobre el pliegue, así que le toca a ella
                el `fetchpriority` que en la página 1 lleva la foto del lead. Sin
                esto la página 2 empieza con tres huecos en degradado.
              */}
              {enRejilla.map((n, i) => (
                <TarjetaNota nota={n} variante="rejilla" prioridad={!destacada && i < 3} />
              ))}
            </div>
          )}

          {/* ── Publicidad: el leaderboard ── */}
          <div class="sc-franja-anuncio">
            <Anuncio formato="leaderboard" nombre="scanner-leader" />
          </div>

          {/* ── Segunda tanda + riel ── */}
          <div class="sc-abajo">
            {/*
              📖 Sin segunda tanda no se pinta NADA de esta columna — ni el rótulo.
              Hasta el 2026-09-09 aquí salía «MÁS EN …» con su línea debajo y, de
              relleno, «Por ahora no hay más notas publicadas…». El rótulo anunciaba
              una tanda que no existía y el aviso le contaba al lector el calendario
              de la redacción. Con una sola nota publicada —el caso de hoy— era lo
              único que se veía bajo el leaderboard.

              El rótulo y su CSS siguen aquí —vuelven en cuanto haya una octava
              nota—, y `.sc-vacio` también: la usa el aviso de categoría perdida.
            */}
            {enLista.length > 0 && (
              <div>
                <div class="sc-mas-cabeza">
                  <span class="beat-display sc-mas-titulo">MÁS EN {nombreAqui.toUpperCase()}</span>
                </div>
                {enLista.map((n) => <TarjetaNota nota={n} variante="fila" />)}
              </div>
            )}

            <aside class="sc-riel">
              <Anuncio formato="box" nombre="scanner-box" unidad="Box" />
            </aside>
          </div>
        </>
      ) : (
        /*
          Degrada en vez de tronar. Es la regla de la casa: `web-enfoque` responde
          200 con cero notas cuando su CMS no está, y eso es lo correcto.

          📖 Y degradar es quedarse en BLANCO desde el 2026-09-09. Aquí salían dos
          textos más —«Todavía no hay notas publicadas en …», uno para el filtro y
          otro para la sección, este último con la lista de lo que revisar en el
          CMS—. Se fueron: una sección sin notas se explica sola vacía, y el aviso
          le enseñaba al lector el estado de la redacción y el nombre del campo.

          Lo que SÍ se queda es este, porque no dice «no hay notas»: dice que el
          front pide una categoría que el CMS no tiene. Eso es una avería, no un
          hueco editorial, y sin el texto se ve idéntica a una sección vacía y nadie
          la reporta. Ver el comentario de `categoriaPerdida` arriba.
        */
        categoriaPerdida && (
          <p class="sc-vacio sc-vacio-grande">
            {`La sección ${nombreAqui} no encuentra su categoría en el CMS (slug «${seccion?.categoria}»). Revisa que exista en «Categorías» y con ese slug exacto.`}
          </p>
        )
      )
    }

    {/*
      La tira de páginas. Va FUERA de la rama de arriba a propósito: si la página
      pedida se queda sin notas —`?pagina=9` tecleado a mano en una sección de
      cinco—, lo único que se pinta es la tira, y con ella el lector vuelve. Dentro
      de la rama habría acabado en un callejón sin salida.

      Con una sola página no pinta nada; la regla vive en `Paginador.astro`.
    */}
    <Paginador actual={pagina} paginas={paginas} ruta={rutaAqui} />
  </div>

<style>
  .sc-envoltura {
    max-width: var(--grid-max);
    margin: 0 auto;
  }

  /* ── nota principal ── */
  .sc-lead {
    display: grid;
    grid-template-columns: 700px minmax(0, 1fr);
    gap: 36px;
    align-items: center;
    padding: 28px 24px 0;
    color: inherit;
    text-decoration: none;
  }
  .sc-lead-foto {
    position: relative;
    /* La proporción del sitio. El porqué, en `src/styles/beat.css`. */
    aspect-ratio: var(--proporcion-foto);
    background: var(--grad-noche);
    overflow: hidden;
  }
  .sc-lead-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sc-lead-trama {
    position: absolute;
    inset: 0;
  }
  .sc-estela {
    left: 8%;
    right: 34%;
    top: 26%;
  }
  .sc-estela-suave {
    left: 22%;
    right: 12%;
    top: 62%;
  }
  .sc-lead-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sc-lead-cat {
    padding: 8px 13px;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    color: var(--text-body);
    white-space: nowrap;
  }
  .sc-lead-fecha {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .sc-lead-titulo {
    font: var(--type-title-1);
    letter-spacing: -0.024em;
    color: var(--mist-1);
    margin: 18px 0 0;
    text-wrap: pretty;
  }
  .sc-lead-bajada {
    font: var(--type-body);
    color: var(--text-muted);
    margin: 14px 0 0;
    max-width: 44ch;
    text-wrap: pretty;
  }
  .sc-lead-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--mist-0);
    color: var(--noche-0);
    font: 600 12.5px/1 var(--font-text);
  }
  .sc-lead:hover .sc-lead-cta {
    background: var(--mist-1);
  }
  .sc-lead:hover .sc-lead-titulo {
    color: var(--mist-0);
  }

  /* ── rejilla: la línea entre tarjetas ES el fondo asomando ── */
  .sc-rejilla {
    display: grid;
    /* 🔴 `minmax(0, 1fr)` y no `1fr`: `1fr` es `minmax(auto, 1fr)`, así que un
       hijo indivisible ensancha SU columna y las demás se encogen. Medido: la
       tarjeta de «Fenómeno Residente» pedía 191px de mínimo por el rótulo con
       `nowrap`, y dejaba a su vecina en 178. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    background: var(--border-hairline);
    padding: 2px;
    margin: 32px 24px 0;
  }
  /*
    Sin destacada encima —página 2 en adelante— la cuadrícula es lo primero bajo el
    titular, y hereda el aire que en la página 1 pone el lead (`.sc-lead`, 28px /
    20px). Sin esto la sección arranca 4px más arriba al pasar de página, que es
    poco pero se ve como un salto al volver atrás.
  */
  .sc-rejilla.es-cabeza {
    margin-top: 28px;
  }

  .sc-franja-anuncio {
    padding: 32px 24px;
  }

  /* ── segunda tanda ── */
  .sc-abajo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 32px;
    align-items: start;
    padding: 0 24px 44px;
  }
  .sc-mas-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .sc-mas-titulo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
  }
  .sc-riel {
    /* 🔴 Fijo en SU columna: cuando no hay segunda tanda el riel es el único hijo
       de `.sc-abajo`, y sin esto caería en la de `1fr` y estiraría el box a 700px.
       Se reinicia en 14e, donde la retícula es de una sola columna. */
    grid-column: 2;
    position: sticky;
    top: calc(var(--chrome-h) + 16px);
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .sc-vacio {
    font: var(--type-body-sm);
    color: var(--text-muted);
    max-width: 60ch;
    padding: 26px 0 0;
    text-wrap: pretty;
  }
  .sc-vacio-grande {
    padding: 40px 24px 64px;
    font: var(--type-body);
  }

  /* ── 14e: móvil ── */
  @media (max-width: 899px) {
    .sc-lead {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 20px 16px 0;
    }
    .sc-lead-meta {
      gap: 10px;
      margin-top: 14px;
    }
    .sc-lead-cat {
      padding: 7px 12px;
      font-size: 8.5px;
    }
    .sc-lead-fecha {
      color: var(--text-faint);
      font-size: 8.5px;
    }
    .sc-lead-titulo {
      font: 700 25px/1.12 var(--font-text);
      letter-spacing: -0.02em;
      margin-top: 12px;
    }
    .sc-lead-bajada {
      font: 400 14.5px/1.5 var(--font-text);
      margin-top: 10px;
      max-width: none;
    }
    .sc-lead-cta {
      margin-top: 18px;
    }

    .sc-rejilla {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      margin: 22px 0 0;
    }
    .sc-rejilla.es-cabeza {
      margin-top: 20px;
    }

    /*
      📖 Aquí había tres reglas de publicidad —`.sc-anuncio`, `.sc-anuncio-rotulo`
      y `.sc-anuncio-leader`— y se fueron el 2026-09-09: **ningún elemento de este
      archivo las usaba**. Sobrevivían de cuando esta página pintaba su propio
      marcado de anuncio; hoy usa `<Anuncio formato="leaderboard" …>`, que trae su
      marco y sus medidas.

      ⚠️ Y no eran inocuas: `.sc-anuncio-leader` reservaba `320 / 100`, o sea que
      guardaba una copia MUERTA de una medida equivocada. El día que alguien
      volviera a usar esa clase habría heredado el fallo, y buscando «320 × 100»
      para corregirlo aparecía aquí sin que este archivo tuviera nada que ver.
    */

    .sc-abajo {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 0 16px 34px;
    }
    .sc-mas-titulo {
      font-size: 19px;
    }
    .sc-riel {
      grid-column: auto;
      position: static;
    }
  }
</style>
