<div id="modal">
	<input type="checkbox" id="cerrar">
	<label for="cerrar" id="btn-cerrar">X</label>
	<div class="modals">
		<div class="contenido" style="text-align: center;">
			<div class="container-iframe">
				<div class="video-wrapper">
					<video id="videopromo" loop autoplay muted playsinline>
          <source src="https://storage.googleapis.com/nrm-web/beat/videos/Takeover_break25_sonido.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
					<button id="audio-toggle" class="audio-toggle" type="button" aria-label="Activar audio" aria-pressed="false">
						<svg class="audio-icon" viewBox="0 0 24 24" aria-hidden="true">
							<path class="speaker-body" d="M3 10v4h4l5 5V5L7 10H3z"/>
							<path class="audio-wave wave-1" d="M14.5 8.5a4.5 4.5 0 0 1 0 7"/>
							<path class="audio-wave wave-2" d="M17.5 5.5a8 8 0 0 1 0 13"/>
							<path class="audio-wave wave-3" d="M20.5 2.5a11.5 11.5 0 0 1 0 19"/>
							<path class="audio-slash" d="M16 8l7 8M23 8l-7 8"/>
						</svg>
					</button>
				</div>
			</div>
			
			
		</div>
	</div>
</div>


<script is:inline>
  const now = new Date();
  const targetDate = new Date('2026-08-7T17:00:00');
  const videoElement = document.getElementById('videopromo');
  const audioToggle = document.getElementById('audio-toggle');

  if (now >= targetDate && videoElement) {
    const sourceElement = videoElement.querySelector('source');
    if (sourceElement) {
      sourceElement.src = 'https://storage.googleapis.com/nrm-web/beat/videos/Takeover_break24.mp4';
    }
    videoElement.load();
  }

  if (videoElement && audioToggle) {
    const updateAudioButton = () => {
      const isMuted = videoElement.muted;
      audioToggle.setAttribute('aria-label', isMuted ? 'Activar audio' : 'Silenciar audio');
      audioToggle.setAttribute('aria-pressed', String(!isMuted));
      audioToggle.classList.toggle('is-muted', isMuted);
      audioToggle.classList.toggle('is-active', !isMuted);
    };

    const disableAudio = () => {
      videoElement.muted = true;
      videoElement.volume = 0;
      videoElement.pause();
      updateAudioButton();
    };

    audioToggle.addEventListener('click', async () => {
      videoElement.muted = !videoElement.muted;
      videoElement.volume = 1;

      if (!videoElement.muted) {
        try {
          await videoElement.play();
        } catch (error) {
          console.warn('No se pudo reproducir el video con audio:', error);
        }
      }

      updateAudioButton();
    });

    const modalElement = document.getElementById('modal');
    if (modalElement) {
      modalElement.addEventListener('animationend', (event) => {
        if (event.animationName === 'modal') {
          disableAudio();
        }
      });
    }

    document.getElementById('cerrar')?.addEventListener('change', (event) => {
      if (event.target.checked) {
        disableAudio();
      }
    });

    updateAudioButton();
  }
</script>

