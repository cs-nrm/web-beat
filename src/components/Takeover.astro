---
/**
 * El TAKEOVER: la publicidad a pantalla completa que el equipo llama «el modal».
 *
 * Tres variantes y **el interruptor está en el CMS**, no aquí: la colección
 * `publicidad` con `tipo: 'takeover'`, y dentro `fuente` decide de dónde sale la
 * pieza (ver `src/lib/cms/publicidad.ts`).
 *
 *   · `admanager` — el caso NORMAL (Carlos, 2026-09-11). El CMS no trae pieza ni
 *     enlace: solo dice durante qué días pedirle el modal a Google. El creativo lo
 *     pone GAM en el slot que declara este archivo.
 *   · `propia` con imagen — imagen del anunciante con su enlace.
 *   · `propia` con video — un mp4 corto, con la imagen de respaldo detrás.
 *
 * SIN CAMPAÑA NO SE EMITE NADA. Ni overlay, ni slot, ni marco vacío. Es la
 * diferencia con `Anuncio.astro`, que sí reserva su hueco: una franja vacía en el
 * Inicio es fea, pero un rectángulo vacío TAPANDO el Inicio es el sitio roto.
 *
 * Y NO SE PINTA CON `Anuncio.astro` a propósito. Aquel reserva alto, escribe el
 * rótulo «PUBLICIDAD» y colapsa su marco cuando GAM no tiene: dentro de un overlay
 * eso sería la peor versión de todas, una pantalla completa que dice «PUBLICIDAD ·
 * 600×800». Aquí el slot se declara a mano y quien decide si el overlay se ve es el
 * creativo, no el reloj.
 *
 * Solo en el Inicio (`src/pages/index.astro`). Un modal encima de una nota que
 * alguien vino a LEER es otra conversación, y no está tenida.
 *
 * Este formato SÍ afecta el LCP mientras hay campaña, y no hay forma de que no:
 * un overlay que tapa la pantalla es lo que el lector ve, así que su imagen pasa a
 * ser el elemento de LCP del Inicio. Lo que se hace es que llegue rápido, no fingir
 * que no está.
 *
 * 📖 El diseño viene de `web-enfoque/src/components/ads/Takeover.astro`, que lo
 * resolvió primero (campaña `leap auto`, 8-9 sep 2026) y midió en producción lo que
 * aquí se da por sabido. Las diferencias con aquel están anotadas donde aparecen.
 */
import { urlMedia } from '@/lib/cms/client';
import type { Takeover } from '@/lib/cms/publicidad';
import { HOST_CANONICO } from '@/config/site';

interface Props {
  /** `src/lib/cms/publicidad.ts` → `obtenerTakeover()`. `null` = no hay campaña. */
  takeover: Takeover | null;
}

const { takeover } = Astro.props;

/**
 * Id FIJO, no generado por render. Enfoque lo generaba con un `randomUUID` por
 * render y le costó una tarde: su oyente de `slotRenderEnded` quedaba capturado
 * sobre el id de la primera vista, así que en la segunda navegación no volvía a
 * dispararse nunca y el modal no se abría. Aquí no hace falta ninguna unicidad
 * generada —hay un solo takeover por página— y un id estable no puede
 * desincronizarse de nada.
 */
const ID_SLOT = 'beat-takeover-slot';

/**
 * Las medidas del takeover en Ad Manager.
 *
 * Salen del sitio viejo, no del lienzo: `src/js/ads.js` declaraba el
 * `ad-slot14` con estas dos mismas medidas, y es el slot del modal de siempre. El
 * lienzo `publicidad` no dice nada de este formato.
 *
 * Y el corte mira el ALTO del viewport, no solo el ancho — es el único formato
 * del sitio que lo hace, y por una razón medida en Enfoque el 2026-09-08: un
 * creativo de 600×800 en una laptop de 720px de alto NO CABE, así que el lector
 * tendría que hacer scroll dentro del overlay para ver el final del anuncio. Se
 * pide la pieza grande solo cuando de verdad entra: ≥768 de ancho **y** ≥860 de
 * alto (los 800 del creativo más el rótulo, la cruz y el aire de la caja).
 *
 * `addSize` recibe el viewport como `[ancho, alto]`. Los 860 tienen que coincidir
 * con el `@media (min-height:)` de `.tk-slot` de abajo, que es quien reserva el
 * hueco: si el CSS reservara 320×480 y GPT pidiera 600×800, el creativo llegaría a
 * un hueco que no lo espera.
 *
 * Y la advertencia de siempre de `agents/ads.md`: una medida que no está dada de
 * alta en el ad unit NUNCA se llena, y desde el sitio se ve igual que «no había
 * demanda». Antes de dar por muerto un takeover que no sale, confirmar 600×800 y
 * 320×480 en GAM.
 */
const TAMANOS: Array<[number, number]> = [
  [600, 800],
  [320, 480],
];
const MAPPING: Array<[[number, number], Array<[number, number]>]> = [
  [[768, 860], [[600, 800]]],
  [[768, 0], [[320, 480]]],
  [[0, 0], [[320, 480]]],
];

/**
 * La sub-unidad de Ad Manager.
 *
 * **Hoy NO existe bajo el ad unit de Beat** (verificado por la sesión de Enfoque
 * el 2026-09-09 en la consola de GAM, donde sí la crearon para el suyo). Pedir una
 * ruta que no existe no falla: GAM atiende la petición contra el padre y el modal
 * se llena igual. Lo que se pierde mientras tanto es el REPORTE —el takeover cae en
 * la misma bolsa que el resto del inventario y no se puede medir por separado—, así
 * que se pide desde ya: el día que ad ops cree el bloque, empieza a reportarse solo
 * y sin desplegar.
 *
 * Y el aviso que va con esto, porque es dinero: si alguien va a poner en GAM una
 * protección para bloquearle la programática al takeover, **el bloque hijo tiene que
 * existir primero**. Aplicada sobre el padre, esa protección apaga la programática
 * de TODO el sitio.
 */
const UNIDAD = 'Takeover';

/** La pieza, ya resuelta. `null` con Ad Manager, que no trae ninguna. */
const creatividad = (() => {
  if (!takeover || takeover.fuente !== 'propia') return null;

  const escritorio = urlMedia(takeover.imagen, 'large');
  if (!escritorio) return null;
  const movil = urlMedia(takeover.imagenMovil ?? takeover.imagen, 'card') ?? escritorio;
  const video = urlMedia(takeover.video);

  /*
    El `alt` sale de la media, y si viniera vacío se nombra al anunciante: una pieza
    con `alt=""` desaparece para quien navega con lector de pantalla, y lo que se
    vendió es una presencia. Mismo criterio que `Anuncio.astro`.
  */
  const media = typeof takeover.imagen === 'object' ? takeover.imagen : null;
  const alt = media?.alt?.trim() || 'Publicidad';

  /*
    Fuera del sitio se abre en pestaña nueva, dentro no. `sponsored` es obligado —es
    un enlace pagado— y `noopener` cierra el acceso a `window.opener` desde el
    destino. El `href` va a NUESTRO proxy y no al anunciante: es lo que permite
    contar el clic de servidor a servidor (`src/pages/api/anuncio/[id].ts`).
  */
  let externo = false;
  try {
    externo = new URL(takeover.enlace ?? '', `https://${HOST_CANONICO}`).host !== HOST_CANONICO;
  } catch {
    externo = false;
  }

  return { escritorio, movil, video, alt, externo };
})();

/*
  Una campaña de creatividad propia que no dio pieza utilizable no se pinta como
  overlay vacío: se descarta entera. `obtenerTakeover` ya lo filtra, y esto es el
  segundo cerrojo por si alguien llama al componente con otra cosa.
*/
const hayQuePintar = Boolean(takeover && (takeover.fuente === 'admanager' || creatividad));
const enlaceProxy = takeover ? `/api/anuncio/${takeover.id}` : '';
---

{
  hayQuePintar && takeover && (
    <div
      class="tk-capa tk-esperando"
      id="beat-takeover"
      data-id={takeover.id}
      data-clave={takeover.clave}
      data-frecuencia={takeover.frecuencia}
      data-fuente={takeover.fuente}
      data-slot={takeover.fuente === 'admanager' ? ID_SLOT : undefined}
      inert
    >
      {/*
        El velo cierra al pulsar fuera. `aria-hidden` porque la cruz ya expone esa
        misma acción a quien no usa ratón, y anunciarla dos veces solo estorba.
      */}
      <div class="tk-velo" data-cerrar aria-hidden="true" />

      <div class="tk-caja" role="dialog" aria-modal="true" aria-label="Publicidad">
        <div class="tk-barra">
          <span class="beat-label tk-rotulo">PUBLICIDAD</span>
          <button type="button" class="tk-cerrar" data-cerrar aria-label="Cerrar publicidad">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                d="M6 6l12 12M18 6L6 18"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>

        <div class="tk-pieza">
          {takeover.fuente === 'admanager' ? (
            /*
              El slot de GPT. Lo define y lo pinta `src/scripts/anuncios.ts`, que
              descubre los huecos por `data-anuncio` — el mismo motor que el resto
              del inventario, así que este takeover entra en la MISMA petición
              agrupada (`singleRequest`) que los demás huecos de la página. Eso es lo
              que hace posible un roadblock y la exclusión competitiva de verdad.

              Y NO va envuelto en `.anuncio`: el motor colapsa el marco de un
              hueco vacío buscando ese ancestro, y aquí colapsar el marco sería
              esconder la caja dejando el overlay puesto. Quien abre y cierra este
              overlay es el script de abajo.
            */
            <div
              id={ID_SLOT}
              class="tk-slot"
              data-anuncio="takeover"
              data-unidad={UNIDAD}
              data-tamanos={JSON.stringify(TAMANOS)}
              data-mapping={JSON.stringify(MAPPING)}
            />
          ) : creatividad?.video ? (
            <>
              {/*
                Arranca SILENCIADO, y no es una preferencia: es la única forma de
                que el navegador deje auto-reproducir. Y además el radio puede estar
                sonando — si el lector le sube el volumen al spot, el árbitro de
                audio para el radio (lo engancha el script de abajo).

                La imagen va de `poster`: es lo que se ve mientras el mp4 carga y lo
                que queda si el navegador no lo deja arrancar. Por eso el CMS sigue
                exigiéndola aunque el video sea el protagonista.
              */}
              <video
                class="tk-video"
                src={creatividad.video}
                poster={creatividad.escritorio}
                autoplay
                muted
                playsinline
                controls
                preload="metadata"
              />
              <a
                class="tk-enlace"
                href={enlaceProxy}
                data-salir
                target={creatividad.externo ? '_blank' : undefined}
                rel={creatividad.externo ? 'sponsored noopener' : 'sponsored'}
              >
                Más información
              </a>
            </>
          ) : (
            /*
              `data-salir`: al pulsar el anuncio el overlay se cierra a mano. Si no,
              se queda tapando la página mientras el ClientRouter hace el swap de la
              navegación.
            */
            <a
              class="tk-creatividad"
              href={enlaceProxy}
              data-salir
              target={creatividad?.externo ? '_blank' : undefined}
              rel={creatividad?.externo ? 'sponsored noopener' : 'sponsored'}
            >
              <picture>
                <source media="(max-width: 767px)" srcset={creatividad?.movil} />
                <img src={creatividad?.escritorio} alt={creatividad?.alt} decoding="async" />
              </picture>
            </a>
          )}
        </div>
      </div>
    </div>
  )
}

{/*
  EN LÍNEA Y SÍNCRONO, y es lo único de este archivo que no puede ser un módulo.

  Si el lector ya vio esta campaña en esta sesión, el nodo se va del DOM AQUÍ MISMO,
  mientras el navegador todavía está leyendo el `<body>` — antes de que corra ningún
  módulo y, sobre todo, antes de que `anuncios.ts` descubra el slot y le pida el
  anuncio a Google. Pedirlo primero y decidir después es facturarle al anunciante un
  modal que nadie vio, y sus números no van a cuadrar nunca.

  Un módulo no puede hacer este trabajo: va diferido, así que GPT podría haberse
  adelantado, y el orden entre los módulos de la página y el del layout depende de
  cómo empaquete el bundler. Esto no depende de nada. Es el mismo reparto que
  `Intro.astro`, por la misma razón y con el mismo resultado.

  Sin `sessionStorage` (navegación privada, cookies bloqueadas, un iframe) se
  muestra: es el lado seguro para lo que está vendido.
*/}
<script is:inline>
  (function () {
    try {
      var capa = document.getElementById('beat-takeover');
      if (!capa) return;
      if (capa.dataset.frecuencia === 'siempre') return;
      if (sessionStorage.getItem('takeover:' + capa.dataset.clave) === '1') capa.remove();
    } catch (e) {
      /* Sin almacenamiento se muestra. Ver arriba. */
    }
  })();
</script>

<script>
  import { olvidarAudio, registrarAudio, reclamarAudio } from '@/scripts/audio';

  /**
   * Cuánto dura en pantalla antes de irse solo.
   *
   * 10 s es el número de la casa (Carlos, 2026-09-09, para el takeover de Enfoque:
   * «10 segundos y se quita solo»). No afecta al cobro: la impresión se cuenta
   * cuando el creativo se pinta, y 10 s están muy por encima del umbral de
   * visibilidad de la industria (1 s con el 50% a la vista).
   */
  const SEGUNDOS_EN_PANTALLA = 10;

  /**
   * Tope duro para la variante de VIDEO. Un spot no se corta a la mitad —el
   * anunciante pagó el spot completo, no diez segundos de él—, así que si sigue
   * corriendo cuando vence el plazo se le deja terminar. Esto es la red para cuando
   * el video no arranca, se cuelga o dura de más.
   */
  const TOPE_VIDEO_MS = 40_000;

  /**
   * Lo que se espera a que Ad Manager conteste antes de retirar el overlay.
   *
   * 10 s y no 3. Medido en producción por la sesión de Enfoque el 2026-09-09: GAM
   * contestó entre **1700 y 2659 ms** con red de cable. Con un plazo de 3 s, un
   * teléfono en 3G se pasa y se cierra en firme una impresión que venía en camino.
   * Y esperar no le cuesta nada al lector, porque mientras espera NO SE VE NADA.
   *
   * Existe por el BLOQUEADOR DE ANUNCIOS, que es uno de cada cuatro o cinco
   * lectores: con `gpt.js` bloqueado el evento de GAM no llega nunca y sin este
   * plazo el nodo se quedaría montado para siempre. Es el mismo patrón de «bandera
   * que solo se suelta en el callback» que ya costó una radio entera.
   */
  const PLAZO_GAM = 10_000;

  /** Lo que dura el intro más su margen (`src/scripts/intro.ts`: 3400 ms). */
  const RED_INTRO = 4000;

  /**
   * Hace algo cuando el intro haya terminado, o ya mismo si no está corriendo.
   *
   * Los dos tapan la pantalla, los dos salen una vez por sesión y los dos viven
   * en el Inicio, así que en la primera visita de una sesión coinciden. Van EN FILA
   * y no a la vez: el intro hace su entrada, se va, y ahí arranca el takeover con
   * sus diez segundos. Revelarlo debajo del intro sería regalarle al anunciante los
   * primeros 2.5 s de su campaña contra una pantalla negra.
   *
   * En la variante de Ad Manager esto casi nunca cuesta tiempo: los 1700-2659 ms
   * que tarda GAM en contestar transcurren MIENTRAS el intro corre.
   *
   * El respaldo por tiempo no es adorno: si el módulo del intro no llegara a correr,
   * `data-intro` se quedaría puesto y el takeover esperaría para siempre.
   */
  function alTerminarElIntro(hacer: () => void): void {
    if (document.documentElement.dataset.intro !== 'corre') {
      hacer();
      return;
    }
    let hecho = false;
    const seguir = (): void => {
      if (hecho) return;
      hecho = true;
      observador.disconnect();
      clearTimeout(red);
      hacer();
    };
    const observador = new MutationObserver(() => {
      if (document.documentElement.dataset.intro !== 'corre') seguir();
    });
    observador.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-intro'],
    });
    const red = window.setTimeout(seguir, RED_INTRO);
  }

  function iniciarTakeover(): void {
    const capa = document.getElementById('beat-takeover');
    if (!capa || capa.dataset.listo) return;
    capa.dataset.listo = '1';

    const esDeAdManager = capa.dataset.fuente === 'admanager';
    const unaVez = capa.dataset.frecuencia !== 'siempre';
    const clave = `takeover:${capa.dataset.clave ?? ''}`;
    const video = capa.querySelector<HTMLVideoElement>('.tk-video');
    /** A dónde vuelve el foco al cerrar. */
    const foco = document.activeElement as HTMLElement | null;

    let cerrado = false;
    let visible = false;
    /*
      Se declaran aquí, aunque solo los use la rama de Ad Manager, porque `cerrar()`
      tiene que poder desmontarlos: un oyente en `document` que nadie quita sobrevive
      a la navegación de Astro y se acumula uno por vista.
    */
    let plazoGam: ReturnType<typeof setTimeout> | undefined;
    let alRenderizar: ((e: Event) => void) | undefined;

    /**
     * De «montado pero invisible» a visible.
     *
     * Existe SEPARADO del montaje por la variante de Ad Manager. Enfoque la
     * revelaba de inmediato y la cerraba al recibir «vacío», así que en una carga en
     * frío el lector veía **una caja vacía durante ~1.5 s** antes de que
     * desapareciera — y con `frecuencia: siempre`, en cada visita. Aquí ese caso
     * espera invisible y solo se revela cuando hay creativo de verdad: o se ve un
     * anuncio, o no se ve nada.
     *
     * La llave de sesión se escribe AL MOSTRAR, no al cerrar. Al cerrar, un
     * recargar a media pantalla lo vuelve a abrir y quien se va sin cerrarlo lo
     * recibe en cada página. Y un takeover que nunca llegó a verse no debe gastarle
     * la sesión al lector.
     */
    const mostrar = (): void => {
      if (cerrado || visible) return;
      visible = true;
      capa.classList.remove('tk-esperando');
      capa.removeAttribute('inert');
      document.documentElement.classList.add('tk-abierto');
      capa.querySelector<HTMLElement>('.tk-cerrar')?.focus();

      try {
        if (unaVez) sessionStorage.setItem(clave, '1');
      } catch {
        /* Sin almacenamiento se volverá a ver en la siguiente carga. */
      }

      /*
        La impresión se cuenta AQUÍ, y es lo que distingue a este formato del
        banner de portada —que la cuenta en el render del servidor—. El takeover sale
        una vez por sesión, así que contar renders multiplicaría por cinco lo que se
        le factura a quien abre el Inicio cinco veces.

        Va a NUESTRO servidor, que es quien habla con el CMS: el token no puede salir
        del proceso. Y no se cuenta con Ad Manager, donde el número que se factura lo
        lleva Google (el endpoint lo vuelve a comprobar; esto solo evita el viaje).
      */
      if (!esDeAdManager && capa.dataset.id) {
        try {
          navigator.sendBeacon(`/api/anuncio/${capa.dataset.id}`);
        } catch {
          /* Un contador que falla no puede estorbar a un anuncio que ya se ve. */
        }
      }

      /*
        El plazo cuenta desde que SE VE, no desde que se monta. Con Ad Manager la
        espera invisible puede ser de 2.5 s, y esos no son segundos de anuncio.

        Se decide UNA vez, al revelar, y no se sondea:
          · imagen y Ad Manager → los 10 s de siempre;
          · video con duración conocida → lo que dure el spot (mínimo 10 s, tope
            `TOPE_VIDEO_MS`), y si termina antes lo cierra su propio `ended`;
          · video que aún no sabe cuánto dura → 10 s, como una imagen.

        Enfoque sondeaba `video.paused` cada segundo para «dejarlo terminar» y era
        frágil por los dos lados: si el lector PAUSA el spot (tiene controles) el
        overlay se cerraba un segundo después, y en una pestaña que el navegador no
        está pintando Chrome pausa el video solo, así que el plazo saltaba a mitad del
        spot. Un plazo fijo no tiene ninguno de los dos problemas.
      */
      let plazo = SEGUNDOS_EN_PANTALLA * 1000;
      if (video) {
        video.addEventListener('ended', cerrar, { once: true });
        const dura = video.duration;
        if (Number.isFinite(dura) && dura > 0) {
          plazo = Math.min(Math.max(plazo, dura * 1000 + 500), TOPE_VIDEO_MS);
        }
      }
      window.setTimeout(cerrar, plazo);
    };

    const cerrar = (): void => {
      if (cerrado) return;
      cerrado = true;
      document.documentElement.classList.remove('tk-abierto');
      if (video) {
        try {
          video.pause();
        } catch {
          /* Nada que pausar. */
        }
      }
      /*
        Se QUITA del DOM, no se esconde: un `destroySlots()` posterior de GPT podría
        revivir un slot invisible, y un nodo escondido con un creativo dentro es una
        impresión servida que nadie ve.
      */
      capa.remove();
      document.removeEventListener('keydown', alTeclear);
      clearTimeout(plazoGam);
      if (alRenderizar) document.removeEventListener('beat:anuncio-render', alRenderizar);
      /*
        Y se da de baja del árbitro de audio. `registrarAudio` reemplaza en vez de
        acumular, así que esto no evita que el registro crezca — evita otra cosa: que
        quede una fuente apuntando a un `<video>` que ya no está en el DOM, y que el
        siguiente `reclamarAudio` la recorra creyendo que hay algo que pausar.
      */
      if (video) olvidarAudio('takeover');
      /*
        El foco vuelve a donde estaba. Sin esto, cerrar el modal deja el foco en el
        `<body>` y quien navega con teclado tiene que recorrer el sitio otra vez
        desde arriba.
      */
      if (foco?.isConnected) foco.focus();
    };

    const alTeclear = (e: KeyboardEvent): void => {
      if (e.key === 'Escape') {
        cerrar();
        return;
      }
      /*
        Trampa de foco: con un overlay `aria-modal` el tabulador no puede irse al
        Inicio que está detrás.
      */
      if (e.key !== 'Tab' || !visible) return;
      const focos = capa.querySelectorAll<HTMLElement>('button, a[href], video[controls]');
      if (!focos.length) return;
      const primero = focos[0];
      const ultimo = focos[focos.length - 1];
      if (e.shiftKey && document.activeElement === primero) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primero.focus();
      }
    };

    capa.querySelectorAll('[data-cerrar]').forEach((el) => el.addEventListener('click', cerrar));
    capa.querySelectorAll('[data-salir]').forEach((el) => el.addEventListener('click', cerrar));
    document.addEventListener('keydown', alTeclear);

    /** El video se registra en el árbitro para no sonar encima del radio. */
    if (video) {
      registrarAudio('takeover', () => {
        try {
          video.pause();
        } catch {
          /* Nada que pausar. */
        }
      });
      const reclamar = (): void => {
        if (!video.muted && !video.paused) reclamarAudio('takeover');
      };
      video.addEventListener('play', reclamar);
      video.addEventListener('volumechange', reclamar);
    }

    if (!esDeAdManager) {
      alTerminarElIntro(mostrar);
      return;
    }

    /*
      Ad Manager: **el overlay lo abre el creativo, no el reloj.**

      El hueco existe con su tamaño real desde el servidor —GPT necesita medirlo para
      pintar dentro— pero la capa está en `tk-esperando`: invisible y sin interceptar
      clics. De ahí sale por una de tres puertas:

        1. render con creativo → se revela (en fila detrás del intro);
        2. render vacío → se retira sin que el lector vea nada;
        3. el plazo → la red del bloqueador de anuncios. Ver `PLAZO_GAM`.

      El evento lo reemite `anuncios.ts`, que es quien tiene el oyente de GPT
      registrado ANTES de `enableServices()`. Enganchar aquí un segundo
      `addEventListener` de `googletag` significaría hacerlo DESPUÉS —este módulo se
      evalúa después del `cmd.push` del layout— y el primer render, que es el que
      importa, ya se habría perdido.
    */
    plazoGam = window.setTimeout(cerrar, PLAZO_GAM);
    /*
      Se desmonta con la PRIMERA respuesta de este slot, y las dos mitades hacen
      falta:

      · Un render posterior ya no manda. GPT puede volver a emitir sobre el mismo
        slot —un `refresh`, una redefinición— y con el oyente puesto un «vacío» que
        llegara después habría cerrado un modal YA ABIERTO, delante del lector y a
        media campaña. Medido el 2026-09-13 en el build servido: revelado a mano y
        retirado 110 ms después por el render real de GAM.
      · Y lo que no se desmonta, se acumula. Esto vive en `document`, que sobrevive
        a la navegación de Astro; sin quitarlo quedaría un oyente por cada visita al
        Inicio, cada uno apuntando a un nodo que ya no existe.

      `{ once: true }` no serviría: el evento se emite para TODOS los huecos de la
      página, así que se descarta más de uno antes de llegar al nuestro.
    */
    alRenderizar = (e: Event): void => {
      const detalle = (e as CustomEvent<{ id: string; vacio: boolean }>).detail;
      if (detalle?.id !== capa.dataset.slot) return;
      clearTimeout(plazoGam);
      document.removeEventListener('beat:anuncio-render', alRenderizar!);
      if (detalle.vacio) cerrar();
      else alTerminarElIntro(mostrar);
    };
    document.addEventListener('beat:anuncio-render', alRenderizar);
  }

  iniciarTakeover();
  /*
    Idempotente para los swaps de View Transitions: el nodo se recrea en cada
    navegación, así que su `data-listo` viene limpio y se evalúa de nuevo. Al volver
    al Inicio, con la llave de sesión ya escrita, el script en línea lo retira antes
    de que esto llegue a mirarlo.
  */
  document.addEventListener('astro:page-load', iniciarTakeover);
</script>

<style>
  .tk-capa {
    position: fixed;
    inset: 0;
    /*
      Por encima de todo lo del sitio menos el intro, y el número sale de la
      escala del design system (`ds/tokens/layout.css`): cabecera 200, player 300,
      overlay 400, diálogo 500, toast 600. El takeover va arriba de los seis.

      Se queda DEBAJO del intro (9999) a propósito, que es lo que hace visible el
      orden: primero la entrada de marca, después el anuncio. Y por debajo también
      del modal del pre-roll VAST del player, que solo puede aparecer si alguien le
      dio play — y para darle play, este overlay ya se fue.

      Enfoque puso 500 aquí creyendo que el máximo del sitio era 100, y su barra
      de radio (9999) se pintaba ENCIMA del modal y seguía siendo clickeable a través
      del velo. Lo cazaron con `elementFromPoint`, no a ojo. En Beat el player va en
      `--z-player` y respeta la escala, pero la lección se queda escrita: esto se
      mide, no se supone.
    */
    z-index: calc(var(--z-toast) + 10);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow-y: auto;
    /*
      **Sin animación de entrada, a propósito**, y esto es una trampa medida, no
      una preferencia estética. Con `animation: … both`, el fotograma inicial
      (`opacity: 0`) se aplica ANTES de que la animación arranque, y en una pestaña
      que el navegador no está pintando Chrome la deja pausada justo ahí: la capa
      montada, el scroll del Inicio bloqueado y nada visible. `forwards` no lo
      arregla —los modos de relleno no gobiernan una animación pausada—.

      La regla es la simple: **si está montada, se ve**. Es una invariante que se
      puede comprobar con `getComputedStyle` en cualquier pestaña, y en este repo eso
      importa el doble, porque el panel del navegador reporta `visibilityState:
      hidden` siempre. Quien espera es la variante de Ad Manager, y para eso está
      `.tk-esperando`, que es una clase y no un fotograma.
    */
  }

  /*
    La espera de Ad Manager: el hueco del slot EXISTE y mide lo que tiene que medir
    —GPT necesita eso para pintar dentro— pero no se ve ni intercepta clics. Es el
    estado con el que llega del servidor; revelarlo es quitar esta clase.

    `opacity: 0` y no `display: none` ni `hidden`: los dos dejarían el slot en
    0×0 y GPT no tendría dónde pintar.
  */
  .tk-capa.tk-esperando {
    opacity: 0;
    pointer-events: none;
  }

  .tk-velo {
    position: absolute;
    inset: 0;
    background: rgb(5 7 6 / 0.86);
    backdrop-filter: blur(6px);
  }

  .tk-caja {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 100%;
  }

  .tk-barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tk-rotulo {
    font-size: 8px;
    letter-spacing: 0.22em;
    color: var(--text-faint);
  }

  .tk-cerrar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--noche-4);
    border-radius: 50%;
    background: var(--noche-1);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }
  .tk-cerrar:hover,
  .tk-cerrar:focus-visible {
    color: var(--text-primary);
    border-color: var(--noche-5);
  }

  .tk-pieza {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  /*
    El overlay CONTIENE: es `position: fixed` con `overflow-y: auto`, así que un
    creativo que llegara más grande de lo pedido hace scroll dentro del velo y no
    puede romper el Inicio que está detrás. Por eso aquí no hace falta el `encajar()`
    de `anuncios.ts`, que existe para los huecos que sí viven dentro del flujo.
  */
  .tk-creatividad img,
  .tk-video {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 96px);
    width: auto;
    height: auto;
  }

  @supports (height: 100dvh) {
    .tk-creatividad img,
    .tk-video {
      /* En móvil, `vh` cuenta la barra del navegador que luego se esconde. */
      max-height: calc(100dvh - 96px);
    }
  }

  .tk-enlace {
    padding: 8px 18px;
    border: 1px solid var(--noche-5);
    border-radius: 999px;
    color: var(--text-primary);
    font: var(--type-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  /*
    El hueco del slot se reserva con las MISMAS medidas que pide el `sizeMapping`
    de arriba, y el corte por alto tiene que ser el mismo par (768 × 860). Si el CSS
    reservara 320×480 donde GPT pide 600×800, el creativo llegaría a un hueco que no
    lo espera.
  */
  .tk-slot {
    width: 320px;
    height: 480px;
    max-width: 100%;
  }

  @media (min-width: 768px) and (min-height: 860px) {
    .tk-slot {
      width: 600px;
      height: 800px;
    }
  }

  /* El scroll del Inicio se bloquea mientras el overlay está abierto. */
  :global(html.tk-abierto),
  :global(html.tk-abierto body) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-cerrar {
      transition: none;
    }
  }
</style>
