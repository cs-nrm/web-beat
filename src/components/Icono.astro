---
/**
 * Iconos inline.
 *
 * El DS los expone como componente de su bundle JS
 * (`Beat1009DesignSystem.Icon`), que no se puede usar desde Astro. Los nombres que
 * pide el lienzo —`pause`, `play`, `volume-2`, `chevron-down`, `menu`, `search`,
 * `x`— son de **Lucide**, así que van inline con sus trazos.
 *
 * Inline y no un paquete: así no hay una petición más ni una dependencia que
 * actualizar. Es el mismo criterio de `web-enfoque`.
 *
 * ⚠️ `x` es la CRUZ de cerrar (Lucide). La marca de la red se llama `x-marca`,
 * para que no se confundan: uno cierra un menú y el otro comparte una nota.
 *
 * guarda-ok set:html: `TRAZOS` son constantes de ESTE archivo (trazos de Lucide).
 * Nunca entra contenido del CMS, así que aquí no hay vía de XSS. Es el único uso
 * legítimo de `set:html` en el proyecto — el contenido editorial se pinta como
 * texto en `Lexical.astro`.
 */
interface Props {
  nombre:
    | 'play'
    | 'pause'
    | 'volume-2'
    | 'chevron-down'
    | 'menu'
    | 'search'
    | 'x'
    | 'arrow-up-right'
    | 'link'
    | 'facebook'
    | 'x-marca';
  /** Píxeles. El lienzo usa 14, 16, 18 y 20. */
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 16, class: clase } = Astro.props;

const TRAZOS: Record<Props['nombre'], string> = {
  play: '<polygon points="6 3 20 12 6 21 6 3"/>',
  pause: '<rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/>',
  'volume-2':
    '<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
  search: '<path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>',
  x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  /* ⚠️ Aquí estaba `clock`, el reloj del «3 MIN». Se fue con el tiempo de lectura
     (2026-09-07): las tarjetas, la portada y la firma llevan la fecha, y una fecha
     no lleva reloj. Se quita del mapa en vez de dejarlo huérfano — un icono que
     nadie pide es un icono que alguien vuelve a usar por costumbre. */
  // El remate de "Leer la nota" y el botón redondo de las filas de «Más en Scanner».
  'arrow-up-right': '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
  // Los tres de compartir (14c). `link` es "copiar enlace".
  link:
    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  // Las dos marcas van RELLENAS, no de trazo: un logo de trazo se ve roto a 16px.
  facebook:
    '<path fill="currentColor" stroke="none" d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12"/>',
  'x-marca':
    '<path fill="currentColor" stroke="none" d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.64l-5.2-6.8-5.96 6.8H1.71l7.74-8.84L1.3 2.25h6.8l4.71 6.23zm-1.16 17.52h1.83L5.7 4.13H3.74z"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill={nombre === 'play' || nombre === 'pause' ? 'currentColor' : 'none'}
  stroke={nombre === 'play' || nombre === 'pause' ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={clase}
  aria-hidden="true"
  set:html={TRAZOS[nombre]}
/>
