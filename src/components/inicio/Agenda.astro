---
/**
 * «AGENDA» en el Inicio — §5 del mapa de sitio, bloque final de 13a.
 *
 * El próximo evento va grande a la izquierda; los siguientes, en filas. El lienzo
 * pide DOS acciones distintas —`RSVP` y `BOLETOS`— y el CMS lo modeló como
 * `accion` + `enlace`, así que el botón dice lo que corresponde en vez de un
 * genérico «Ver más».
 */
import Remate from '@/components/Remate.astro';
import { urlMedia } from '@/lib/cms/client';
import type { Evento } from '@/types/payload';

interface Props {
  eventos: Evento[];
  /**
   * `inicio` pinta la barra «AGENDA» con su remate a la sección; `seccion` no,
   * porque el encabezado de la página ya lo dice.
   */
  contexto?: 'inicio' | 'seccion';
}

const { eventos, contexto = 'inicio' } = Astro.props;

const enInicio = contexto === 'inicio';

const [proximo, ...siguientes] = eventos;

/** Las partes de la fecha, en hora de México y ya separadas para pintarlas. */
function partes(iso: string | null | undefined) {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  const f = (opts: Intl.DateTimeFormatOptions) =>
    new Intl.DateTimeFormat('es-MX', { timeZone: 'America/Mexico_City', ...opts }).format(d);
  return {
    dia: f({ day: 'numeric' }),
    mes: f({ month: 'short' }).replace('.', '').toUpperCase(),
    diaSemana: f({ weekday: 'long' }).toUpperCase(),
    hora: f({ hour: '2-digit', minute: '2-digit', hour12: false }),
    iso: d.toISOString(),
  };
}

const ETIQUETA_ACCION: Record<string, string> = { rsvp: 'RSVP', boletos: 'BOLETOS' };
const ETIQUETA_TIPO: Record<string, string> = {
  propio: 'PROPIO',
  cobertura: 'COBERTURA',
  festival: 'FESTIVAL',
};

const p = partes(proximo?.inicio);
const fotoProximo = urlMedia(proximo?.portada, 'large');
---

{
  proximo && (
    <section class:list={['ag', `es-${contexto}`]}>
      {/*
        ⚠️ Aquí había una tira de píldoras `TODOS · PROPIOS · COBERTURAS ·
        FESTIVALES`, igualita a la de las secciones. Se cambió por el remate de
        siempre (decisión de Carlos, 2026-09-01): dos tiras de píldoras idénticas
        en la misma página, una para navegar el sitio y otra para filtrar una
        lista, enseñan al lector que la forma no significa nada. El filtro por
        tipo vive donde sirve, en `/eventos`, y con otra pinta.
      */}
      {enInicio && (
        <div class="ag-cabeza" data-barrido>
          <h2 class="beat-display ag-seccion">AGENDA</h2>
          <Remate href="/eventos" texto="VER LA AGENDA" clase="ag-todo" />
        </div>
      )}

      <div class="ag-destacado">
        <a href={`/eventos/${proximo.slug}`} class="ag-foto">
          {fotoProximo && <img src={fotoProximo} alt="" loading="lazy" decoding="async" />}
          <div class="beat-grid ag-trama" />
          <span class="beat-label ag-insignia">{ETIQUETA_TIPO[proximo.tipo] ?? proximo.tipo}</span>
        </a>

        <div class="ag-texto">
          {p && (
            <div class="ag-cuando">
              <span class="beat-display ag-dia">{p.diaSemana}</span>
              <span class="beat-label ag-hora">
                <time datetime={p.iso}>
                  {p.dia} {p.mes} · {p.hora}
                </time>
              </span>
            </div>
          )}
          <h3 class="ag-titulo">
            <a href={`/eventos/${proximo.slug}`}>{proximo.titulo}</a>
          </h3>
          {proximo.descripcion && <p class="ag-bajada">{proximo.descripcion}</p>}
          <div class="ag-pie">
            {(proximo.lugar || proximo.ciudad) && (
              <span class="beat-label ag-lugar">
                {[proximo.lugar, proximo.ciudad].filter(Boolean).join(' · ')}
              </span>
            )}
            {proximo.accion && proximo.accion !== 'ninguna' && proximo.enlace && (
              <a
                href={proximo.enlace}
                class="beat-label ag-accion"
                target="_blank"
                rel="noopener noreferrer"
              >
                {ETIQUETA_ACCION[proximo.accion] ?? 'VER MÁS'}
              </a>
            )}
          </div>
        </div>
      </div>

      {siguientes.length > 0 && (
        <div class="ag-filas">
          {siguientes.map((e) => {
            const q = partes(e.inicio);
            return (
              <a href={`/eventos/${e.slug}`} class="ag-fila">
                <span class="ag-fecha">
                  <span class="beat-display ag-fecha-dia">{q?.dia ?? '—'}</span>
                  <span class="beat-label ag-fecha-mes">{q?.mes ?? ''}</span>
                </span>
                <span class="ag-fila-titulo">{e.titulo}</span>
                <span class="beat-label ag-fila-lugar">
                  {[e.lugar, e.ciudad].filter(Boolean).join(' · ')}
                </span>
                <span class="beat-label ag-fila-tipo">{ETIQUETA_TIPO[e.tipo] ?? e.tipo}</span>
                <span class="beat-label ag-fila-accion">
                  {e.accion && e.accion !== 'ninguna' ? (ETIQUETA_ACCION[e.accion] ?? '') : ''}
                </span>
              </a>
            );
          })}
        </div>
      )}
    </section>
  )
}

<style>
  .ag {
    padding: 44px 24px 40px;
  }
  /* Dentro de la sección propia el marco lo pone la página. */
  .ag.es-seccion {
    padding: 0;
  }
  .ag-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .ag-seccion {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
    margin: 0;
  }
  .ag-todo {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .ag-todo:hover {
    color: var(--mist-0);
  }

  /*
    La columna del banner baja de 420 a 340: al pasar a cuadrado, 420px de ancho
    son 420 de ALTO, y eso convertía el bloque en una pared que empujaba el texto
    y la acción fuera del pliegue. `align-items: center` porque un cuadrado y un
    bloque de texto de distinta altura se leen mejor alineados por el medio que
    colgando del borde superior.
  */
  .ag-destacado {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    margin-top: 24px;
  }
  .ag-destacado:first-child {
    margin-top: 0;
  }
  /*
    🔴 CUADRADO. Los eventos de la Agenda no traen una foto de cobertura: traen un
    BANNER diseñado, y viene cuadrado (Carlos, 2026-09-03).
  */
  .ag-foto {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--grad-noche);
    overflow: hidden;
  }
  /*
    🔴 `contain`, no `cover`, y por la misma razón que la creatividad de un
    anuncio: un banner es arte con texto dentro, y recortarlo se come justo el
    nombre del evento o la fecha. Si el archivo llega cuadrado —que es lo
    acordado— las dos se comportan igual; la diferencia solo aparece el día que
    alguien suba uno apaisado, y ahí `contain` lo enseña entero con bandas en vez
    de decapitarlo.
  */
  .ag-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ag-trama {
    position: absolute;
    inset: 0;
  }
  .ag-insignia {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 7px 11px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(14px);
    color: var(--mist-0);
    font-size: 9px;
    white-space: nowrap;
  }
  .ag-cuando {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .ag-dia {
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
    color: var(--mist-2);
  }
  .ag-hora {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .ag-titulo {
    font: 700 30px / 1.1 var(--font-text);
    letter-spacing: -0.016em;
    color: var(--mist-2);
    margin: 14px 0 0;
    text-wrap: pretty;
  }
  .ag-titulo a {
    color: inherit;
    text-decoration: none;
  }
  .ag-titulo a:hover {
    color: var(--mist-0);
  }
  .ag-bajada {
    font: var(--type-body);
    color: var(--text-muted);
    margin: 10px 0 0;
    max-width: 48ch;
    text-wrap: pretty;
  }
  .ag-pie {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
  }
  .ag-lugar {
    color: var(--text-muted);
  }
  .ag-accion {
    padding: 11px 18px;
    border-radius: 999px;
    background: var(--mist-0);
    color: var(--noche-0);
    font-size: 9px;
    white-space: nowrap;
  }
  .ag-accion:hover {
    background: var(--mist-1);
  }

  .ag-filas {
    margin-top: 26px;
  }
  .ag-fila {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 180px 130px auto;
    align-items: center;
    gap: 20px;
    padding: 15px 10px;
    margin: 0 -10px;
    border-bottom: 1px solid var(--border-hairline);
    color: inherit;
    text-decoration: none;
  }
  .ag-fila:hover {
    background: var(--surface-card-hover);
  }
  .ag-fecha {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .ag-fecha-dia {
    font-size: 22px;
    font-weight: 800;
    color: var(--mist-2);
  }
  .ag-fecha-mes {
    margin-top: 5px;
    font-size: 9px;
    color: var(--text-faint);
  }
  .ag-fila-titulo {
    font: 500 17px / 1.3 var(--font-text);
    color: var(--mist-2);
    text-wrap: pretty;
  }
  .ag-fila-lugar {
    color: var(--text-muted);
    font-size: 9px;
  }
  .ag-fila-tipo {
    color: var(--text-faint);
    font-size: 9px;
  }
  .ag-fila-accion {
    color: var(--mist-0);
    font-size: 9px;
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .ag {
      padding: 32px 16px 30px;
    }
    .ag.es-seccion {
      padding: 0;
    }
    .ag-seccion {
      font-size: 20px;
    }
    .ag-destacado {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 18px;
    }
    .ag-dia {
      font-size: 26px;
    }
    .ag-titulo {
      font: 700 22px / 1.14 var(--font-text);
      margin-top: 10px;
    }
    .ag-bajada {
      font: 400 14.5px / 1.5 var(--font-text);
      max-width: none;
    }
    /* Las filas pierden lugar y tipo: a 390px son cinco columnas imposibles. */
    .ag-fila {
      grid-template-columns: 48px minmax(0, 1fr) auto;
      gap: 14px;
      padding: 13px 0;
      margin: 0;
    }
    .ag-fila-lugar,
    .ag-fila-tipo {
      display: none;
    }
    .ag-fila-titulo {
      font-size: 15px;
    }
    .ag-fecha-dia {
      font-size: 18px;
    }
  }
</style>
