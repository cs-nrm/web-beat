---
/**
 * Cascarón del sitio.
 *
 * ⏳ Provisional en su estructura: el layout de verdad —con el header que lleva el
 * player persistente— llega con B4. Lo que ya es definitivo es el cableado del
 * design system y las dos reglas de indexación.
 */
import '@/styles/base.css';
import { IDIOMA, NOINDEX_SITIO, SITE_URL, noIndexarHost } from '@/config/site';

interface Props {
  titulo: string;
  descripcion?: string;
  /** `neblina` es el único set claro del DS: para momentos de respiro (una nota
   *  larga, una sección de deck). Nunca una interfaz completa. */
  tema?: 'oscuro' | 'neblina';
}

const { titulo, descripcion, tema = 'oscuro' } = Astro.props;

// Las dos reglas de indexación, igual que en el middleware. La cabecera la pone el
// middleware (protege TODA respuesta); el `<meta>` es la segunda capa.
const noIndexar = NOINDEX_SITIO || noIndexarHost(Astro.url.hostname);
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang={IDIOMA} data-theme={tema === 'neblina' ? 'neblina' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta name="robots" content={noIndexar ? 'noindex, nofollow' : 'index, follow'} />

    {/*
      ⏳ INTERINO — las fuentes se auto-hospedarán en `.woff2` (B3.2 del plan), con
      solo los subsets `latin`/`latin-ext` y solo los pesos que el sitio pinte de
      verdad, medidos en el navegador.

      Por ahora van por `<link>` y no por el `@import` que traía el DS: un `@import`
      dentro del CSS bundleado obliga al navegador a bajar y parsear la hoja ANTES
      de enterarse de que necesita las fuentes — cascada render-blocking. Un `<link>`
      en el `<head>` sale en paralelo, y con `preconnect` se adelanta el handshake.

      🔴 Y son SUSTITUTOS, no las tipografías de marca: el propio DS lo dice ("no
      licensed brand fonts were provided"). Archivo hace de voz display expandida
      del wordmark, Schibsted Grotesk de texto, Martian Mono de metadata técnica.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=Martian+Mono:wdth,wght@75..112.5,100..800&display=swap"
    />
  </head>
  <body class="min-h-screen bg-surface-canvas font-text text-body text-text-body antialiased">
    <slot />
  </body>
</html>
