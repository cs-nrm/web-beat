---
/**
 * Cómo escuchar Beat 100.9 en Alexa.
 *
 * 🔴 Existe porque el pie la enlazaba y no existía. `APPS` tenía «Alexa» en `null`
 * —pintada apagada— con una nota que decía que la página del v1 no se había
 * portado. Portada (Carlos, 2026-09-07), y con eso el pie se queda sin un solo
 * enlace apagado.
 *
 * Los tres pasos son los del sitio actual (`beatdigital.mx/alexa/`). (El v1 repetía
 * el paso 2 dos veces por un error de su plantilla; aquí van los tres que son.)
 *
 * 🔴 Las capturas 2 y 3 son LOCALES desde el 2026-09-10, y es un cambio de criterio
 * a propósito: las del bucket enseñan el logo VIEJO —el redondo dorado de «Beat
 * Digital»— en la ficha de la skill. No están desactualizadas por descuido, están
 * congeladas: el archivo del bucket es de julio de 2024 y responde siempre el mismo
 * `etag`. Y ahí no publicamos nosotros. Carlos las volvió a capturar con la marca
 * nueva y se copian a `public/`, que es el único sitio donde este repo puede
 * cambiarlas.
 *
 * ⚠️ El paso 1 SE QUEDA en el bucket, y no es incoherencia: es el menú de la app de
 * Alexa, no sale ningún logo y sigue siendo exacta. Copiarla solo por uniformidad
 * añadiría 220 KB al repo para clonar una imagen que no tiene nada que arreglar.
 *
 * ⚠️ Lo que se pierde con las locales es lo que decía la nota anterior: ya NO se
 * actualizan solas cuando el corporativo toque el bucket. Si la app de Alexa cambia
 * de aspecto, estas dos hay que volver a capturarlas a mano.
 */
import Base from '@/layouts/Base.astro';
import PaginaTexto from '@/components/PaginaTexto.astro';

/** El bucket del corporativo. Mismo origen que `MARCAS_NRM` en `navegacion.ts`. */
const IMG = 'https://storage.googleapis.com/nrm-web/nrm/images/';

/*
  ⚠️ Cada captura trae SU medida, y no es un detalle: las tres declaraban 640×945
  —la del paso 1— y las otras dos no son ni de ese tamaño ni de esa forma (una es
  apaisada). El navegador reserva el hueco con lo que se le declara, así que dos de
  los tres pasos apartaban una caja vertical para meter luego una imagen ancha y
  baja: el salto de maquetado que el `width`/`height` existe para evitar.
*/
const PASOS = [
  {
    texto:
      'Desde la app de Alexa, en la parte de abajo, dale clic en el menú «Más» y selecciona la opción «Skills y juegos».',
    captura: `${IMG}IMG_5422-640x945.png`,
    ancho: 640,
    alto: 945,
    alt: 'El menú «Más» de la app de Alexa, con «Skills y juegos» remarcado.',
  },
  {
    texto: 'Busca la skill «Beat 100.9» en el icono de la lupa de la parte superior.',
    captura: '/img/alexa-buscar-la-skill.jpg',
    ancho: 300,
    alto: 226,
    alt: 'La búsqueda de «beat 100.9» en la app de Alexa, con dos resultados de Beat 100.9.',
  },
  {
    texto: 'Activa la skill.',
    captura: '/img/alexa-activar-la-skill.jpg',
    ancho: 300,
    alto: 359,
    alt: 'La ficha de la skill Beat 100.9 en la app de Alexa, con el botón «Iniciar».',
  },
];
---

{/*
  ⚠️ El título decía «Beat 100.9 en Alexa — Beat 100.9»: la marca dos veces en una
  línea que Google recorta a unos 60 caracteres. El patrón de la casa es
  `<lo específico> — Beat 100.9`, y lo específico de esta página es Alexa.
*/}
<Base
  titulo="Escúchanos en Alexa — Beat 100.9"
  descripcion="Activa la skill de Beat 100.9 en tu Alexa y escucha la señal en vivo diciendo «Alexa, reproduce Beat 100.9»."
>
  <PaginaTexto
    titulo="BEAT 100.9 EN ALEXA"
    entrada="Activa la skill una sola vez y la señal queda a una frase de distancia."
  >
    <ol class="al-pasos">
      {
        PASOS.map((p, i) => (
          <li class="al-paso">
            <span class="beat-display al-n">{String(i + 1).padStart(2, '0')}</span>
            <p class="al-texto">{p.texto}</p>
            {/*
              Con medidas y `lazy`: son capturas de teléfono y sin `width`/`height`
              cada una provoca un salto de maquetado al llegar. El `alt` describe lo
              que se ve, no repite el paso —quien usa un lector de pantalla ya leyó
              la instrucción justo encima—.
            */}
            <img
              class="al-captura"
              src={p.captura}
              alt={p.alt}
              width={p.ancho}
              height={p.alto}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ol>

    <p class="al-remate">
      Y para escuchar, solo tienes que decir:
      <strong class="al-frase">«Alexa, reproduce Beat 100.9»</strong>
    </p>
  </PaginaTexto>
</Base>

<style>
  .al-pasos {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    gap: 34px;
  }
  .al-paso {
    display: grid;
    /* El número en su columna, y el texto y la captura compartiendo la otra: así
       la numeración queda alineada aunque el texto ocupe dos líneas. */
    grid-template-columns: 46px minmax(0, 1fr);
    align-items: start;
    gap: 0 16px;
    padding-top: 26px;
    border-top: 1px solid var(--border-hairline);
  }
  .al-paso:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .al-n {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-faint);
    line-height: 1.2;
  }
  .al-texto {
    /* Gana a la regla genérica de `PaginaTexto`: aquí el párrafo abre el paso y no
       lleva el margen superior que separa un párrafo del anterior. */
    margin: 0 !important;
    align-self: center;
  }
  .al-captura {
    grid-column: 2;
    display: block;
    width: min(100%, 260px);
    height: auto;
    margin-top: 16px;
    border-radius: var(--r-media);
    /* Las capturas son del sitio viejo y llegan con su propio fondo claro: el
       filete las asienta sobre el negro en vez de dejarlas flotando. */
    box-shadow: inset 0 0 0 1px var(--border-hairline);
  }
  .al-remate {
    margin-top: 38px !important;
    padding-top: 24px;
    border-top: 1px solid var(--border-quiet);
  }
  .al-frase {
    display: block;
    margin-top: 10px;
    font: 700 22px / 1.3 var(--font-text);
    letter-spacing: -0.015em;
    color: var(--mist-1);
  }

  @media (max-width: 899px) {
    .al-pasos {
      gap: 26px;
    }
    .al-paso {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 0 12px;
    }
    .al-n {
      font-size: 18px;
    }
    .al-captura {
      width: min(100%, 220px);
    }
    .al-frase {
      font-size: 18px;
    }
  }
</style>
