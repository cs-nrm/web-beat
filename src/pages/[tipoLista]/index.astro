---
/**
 * El índice de un tipo de lista — hoy, `/bonus-beat`.
 *
 * La ruta es DINÁMICA y no `src/pages/bonus-beat/`. El primer segmento es el
 * `slug` de un documento de `tipos-de-lista`, que es dato editorial: la estación
 * crea «Bonus Beat» hoy y «Beat Ten» mañana, y las dos secciones tienen que
 * existir sin que nadie despliegue. Escribir la carpeta a mano habría dejado la
 * segunda en 404 el día que la crearan, y nadie se entera hasta que un lector lo
 * reporta.
 *
 * Por eso `bonus-beat` NO está en `SEGMENTOS_RESERVADOS` — está explicado
 * allí. Las rutas estáticas del sitio ganan igual a esta por especificidad, así
 * que lo único que hay que descartar aquí son los segmentos reservados que
 * todavía no tienen página.
 */
import Base from '@/layouts/Base.astro';
import CabezaSeccion from '@/components/CabezaSeccion.astro';
import BonusBeat from '@/components/inicio/BonusBeat.astro';
import Anuncio from '@/components/Anuncio.astro';
import { obtenerTipoDeLista, obtenerListaReciente } from '@/lib/cms/listas';
import { MEDIDA_TARJETA, SEGMENTOS_RESERVADOS } from '@/config/site';

const { tipoLista: slug } = Astro.params;

/*
  Descarte barato antes de tocar el CMS. `comunidad`, `tienda`, `marcas`,
  `programacion`… todavía no tienen página propia, así que caerían aquí y
  dispararían una consulta por cada visita a una sección que no existe.
*/
if (!slug || (SEGMENTOS_RESERVADOS as readonly string[]).includes(slug)) {
  return Astro.rewrite('/404');
}

const tipo = await obtenerTipoDeLista(slug);
if (!tipo) return Astro.rewrite('/404');

/*
  UNA consulta, y con `depth: 2`.

  Aquí había dos —`obtenerListas(slug, 24)` para la retícula del archivo y
  `obtenerListaReciente` para la edición vigente— y la primera se fue con el
  archivo el 2026-09-23.

  Conviene no perder el porqué de que fueran dos, por si el archivo vuelve:
  `obtenerListas` pide `depth: 1`, que es lo correcto para 24 ediciones, y a esa
  profundidad `canciones[].cancion` llega poblada pero su `portada` sigue siendo
  un id. `urlMedia` devuelve `null` con un id, así que la edición vigente se
  pintaba sin una sola imagen. La solución no era subir esa consulta a `depth: 2`
  —arrastraría el documento de media de cada canción de las 24 ediciones para
  pintar una retícula que solo necesita la portada de la lista—, sino pedir la
  vigente aparte, que es lo que se quedó.

  Y es la MISMA consulta que ya hace el Inicio para este tipo, así que acierta su
  entrada de caché y en la práctica no cuesta nada.
*/
const reciente = await obtenerListaReciente(slug);

/**
 * La tarjeta de compartir de esta sección, por SLUG.
 *
 * Es la única de las seis que no puede escribir su imagen en el `<Base>`: la ruta
 * es dinámica, así que el archivo depende de qué tipo de lista se esté sirviendo.
 * Se declara igual —escrito, no detectado en disco— y quien no esté en la lista
 * cae al respaldo de marca, que es lo que tenían todas hasta ahora. Un tipo nuevo
 * en el CMS no rompe nada; solo comparte sin su nombre hasta que alguien le genere
 * la tarjeta (`scripts/favicon.mjs`) y la agregue aquí.
 *
 * El `alt` viaja EN la lista y no se arma con `tipo.nombre`. Parece lo mismo y
 * no lo es: el texto está horneado en el PNG el día que se generó, así que si la
 * estación renombra el tipo en el admin, `tipo.nombre` cambiaría y la imagen no —y
 * el `alt` acabaría describiendo unas letras que no están en la foto. Un `alt` que
 * miente es peor que ninguno, porque solo lo lee quien no puede verificarlo.
 */
const TARJETAS_POR_TIPO: Record<string, { ruta: string; alt: string }> = {
  'bonus-beat': {
    ruta: '/img/og-bonus-beat.png',
    alt: 'El wordmark de Beat 100.9 y el rótulo BONUS BEAT, en blanco sobre el negro de la marca.',
  },
};

const tarjeta = TARJETAS_POR_TIPO[slug] ?? null;

---

{/*
  El respaldo de la descripción decía «Bonus Beat en Beat 100.9.» — el nombre de
  la sección seguido del de la casa, que no dice qué es la página. Y es el texto que
  se ve HOY: `tipos-de-lista.descripcion` está vacía en el CMS, así que nunca cae la
  de la redacción. Lo que se describe ahora es lo que la página hace: el índice de
  ediciones, con la más reciente pintada entera.

  Las tres etiquetas de la imagen van JUNTAS o no van: sin tarjeta propia se
  pasa `null` en las tres y el layout pone el respaldo con SUS medidas y su `alt`.
  Mezclarlas —la imagen de marca con el `alt` de una sección— es el fallo que estas
  etiquetas vienen a evitar. Ver `tarjeta` en el frontmatter.
*/}
<Base
  titulo={`${tipo.nombre} — Beat 100.9`}
  descripcion={
    tipo.descripcion ??
    `Las ediciones de ${tipo.nombre} en Beat 100.9, con la más reciente completa.`
  }
  imagen={tarjeta?.ruta ?? null}
  imagenAlt={tarjeta?.alt ?? null}
  imagenAncho={tarjeta ? MEDIDA_TARJETA.ancho : null}
  imagenAlto={tarjeta ? MEDIDA_TARJETA.alto : null}
>
  <div class="tl-pagina">
    <CabezaSeccion titulo={tipo.nombre.toUpperCase()} activa={`/${slug}`} />

    {
      /*
        📖 Sin ediciones la página se queda en su rótulo y el leaderboard —decisión
        del 2026-09-09—. Aquí salía «Todavía no hay ediciones publicadas de …. Cada
        edición es un documento de “listas” con este tipo y sus canciones»: media
        instrucción de captura, delante de quien venía a oír música. Se fue con él
        su `.tl-vacio` y la copia de 14e.
      */
      reciente && (
        <>
          {/*
            La última edición va ENTERA, no como una miniatura más de la retícula.
            Es lo que alguien viene a ver: quien entra a Bonus Beat quiere las
            canciones de esta semana, no un índice desde el que dar otro clic.
          */}
          {/*
            Aquí iba el nombre de la edición con su fecha al otro extremo —«Top Ten
            22 de sept» y «22 SEP 2026»—, y se fue el 2026-09-22 (Carlos). Repetía
            debajo del titular lo que el titular ya dice, y la fecha de la edición
            vigente no es un dato que nadie venga a buscar: quien entra quiere las
            canciones. Sigue estando donde sí informa, en cada pieza de la retícula
            de ediciones anteriores.

            Con él se va su hueco de 32px, y eso ALINEA esta página con el resto:
            medido en el build servido, `/beat-scanner`, `/editorial`,
            `/microambiente` y `/eventos` pegan su primer bloque a la cabecera de
            sección sin separación ninguna. Estas dos páginas de lista eran las
            únicas que metían aire ahí, y lo metían por este bloque.
          */}
          {/*
            DOS columnas a partir de diez canciones, y el umbral es por LONGITUD y
            no por tipo de lista: Bonus Beat trae tres y en dos columnas quedarían
            dos arriba y una suelta debajo, mientras que el Top Ten trae veinte y en
            una sola columna es una página que solo se recorre con el dedo. La
            regla mira el dato, así que el día que la estación cree otro tipo de
            lista se reparte sola.
          */}
          <div class="tl-ultima">
            <BonusBeat
              lista={reciente}
              tipo={tipo}
              contexto="edicion"
              columnas={(reciente.canciones?.length ?? 0) >= 10 ? 2 : 1}
            />
          </div>

          {/*
            Aquí iba el archivo —«EDICIONES ANTERIORES» con su retícula— y se
            retira el 2026-09-23 (Carlos): «quitamos ediciones anteriores, no
            tendremos histórico».

            Se lleva con él el hueco de publicidad «box», y no es un descuido: ese
            box existía para marcar el CORTE entre la edición vigente y el archivo,
            y así estaba escrito aquí mismo. Sin archivo no hay corte, y dejarlo
            pondría el box pegado al leaderboard del pie con solo aire entre los
            dos — una página que termina en dos anuncios seguidos, que es justo lo
            que ese comentario decía evitar. Si se quiere recuperar el inventario,
            es una decisión de `agents/ads.md` y hay que buscarle un sitio que no
            sea ese.

            Con el archivo desaparece también la única forma de LLEGAR a
            `/top-ten/<edición>` desde el sitio. Las ediciones viejas siguen
            respondiendo 200 por su URL y siguen siendo indexables; si eso no se
            quiere, es otro encargo — una redirección o un noindex, no este
            borrado.
          */}
        </>
      )
    }

    <div class="tl-franja-anuncio">
      <Anuncio formato="leaderboard" nombre="lista-leader" />
    </div>
  </div>
</Base>

<style>
  .tl-pagina {
    max-width: var(--grid-max);
    margin: 0 auto;
  }
  .tl-ultima {
    padding: 0 24px;
  }
  .tl-franja-anuncio {
    padding: 44px 24px;
  }

  @media (max-width: 899px) {
    .tl-ultima {
      padding: 0 16px;
    }
    .tl-franja-anuncio {
      padding: 32px 16px;
    }
  }
</style>
