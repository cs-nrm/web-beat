---
/**
 * ⏳ PROVISIONAL — no es el Inicio.
 *
 * Es la prueba de humo de la capa de datos: resuelve la estación contra
 * `cms-estaciones` por `codigo`, y pide el "qué suena" a la bitácora. Sirve para
 * verificar de punta a punta que el SSR habla con el CMS, que el filtro por
 * estación se está inyectando, y que todo degrada en vez de tronar cuando el CMS
 * no está.
 *
 * El Inicio de verdad (§1 del mapa de sitio: "responde en 3 segundos: qué suena,
 * qué se cuenta, qué viene") llega con el design system — B3/B4 del plan.
 */
import Base from '@/layouts/Base.astro';
import { obtenerEstacion } from '@/lib/cms/estacion';
import { queSuena } from '@/lib/cms/aire';
import { CMS_URL, ESTACION_CODIGO } from '@/config/site';

let estacion = null;
let error: string | null = null;

try {
  estacion = await obtenerEstacion();
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const alAire = estacion ? await queSuena() : null;

// El mapa de sitio del relanzamiento, con su estado. Se queda mientras el sitio
// se construye: es la lista de trabajo visible.
const SECCIONES = [
  { n: 1, nombre: 'Inicio', ruta: '/', coleccion: '—', listo: false },
  { n: 2, nombre: 'Escuchar en vivo', ruta: '/en-vivo', coleccion: 'transmisiones + bitacora', listo: false },
  { n: 3, nombre: 'El Fenómeno Residente', ruta: '/fenomeno-residente', coleccion: 'especiales', listo: false },
  { n: 4, nombre: 'Bonus Beat', ruta: '/bonus-beat', coleccion: 'listas + tipos-de-lista', listo: false },
  { n: 5, nombre: 'Agenda / Eventos', ruta: '/eventos', coleccion: 'eventos', listo: false },
  { n: 6, nombre: 'Comunidad', ruta: '/comunidad', coleccion: 'oyentes + playlists (faltan)', listo: false },
  { n: 7, nombre: 'Tienda', ruta: '/tienda', coleccion: 'productos (fase 2)', listo: false },
  { n: 8, nombre: 'Beat para marcas', ruta: '/marcas', coleccion: 'paginas (falta en el CMS)', listo: false },
  { n: 9, nombre: 'Programación', ruta: '/programacion', coleccion: 'programas', listo: false },
  { n: 10, nombre: 'Beat Scanner', ruta: '/scanner', coleccion: 'noticias + categorias', listo: true },
  { n: 11, nombre: 'Nota', ruta: '/noticias/<slug>', coleccion: 'noticias', listo: true },
];
---

<Base titulo="web-beat v2 — scaffold" descripcion="Front Astro SSR de Beat 100.9 sobre cms-estaciones.">
  <div class="mx-auto max-w-grid px-contenedor py-13">
    <p class="t-label mb-4 text-text-faint">web-beat · rama beat</p>
    <h1 class="t-display-3 mb-11 text-text-primary">Scaffold del relanzamiento</h1>

    <section class="mb-12">
      <h2 class="t-label mb-6 text-text-accent">
        Conexión con el CMS
      </h2>
      {error ? (
        <div class="rounded-card border-hairline border-borde-quiet bg-surface-card p-card text-body-sm">
          <p class="mb-4 font-semibold text-state-warning">Sin datos del CMS</p>
          <p class="mb-4 text-text-body">{error}</p>
          <p class="text-text-muted">
            {CMS_URL
              ? 'El CMS no respondió. Comprueba que esté arriba y que la estación esté sembrada.'
              : 'Falta CMS_URL. Copia .env.example a .env — en desarrollo puedes apuntar al CMS de producción: su read es público.'}
          </p>
        </div>
      ) : (
        <dl class="grid grid-cols-[11rem_1fr] gap-y-4 text-body-sm">
          <dt class="text-text-faint">codigo</dt>
          <dd><code class="t-mono">{estacion!.codigo}</code> <span class="text-text-faint">(pedido: {ESTACION_CODIGO})</span></dd>
          <dt class="text-text-faint">id resuelto</dt>
          <dd><code class="t-mono">{estacion!.id}</code></dd>
          <dt class="text-text-faint">nombre</dt>
          <dd>{estacion!.nombre}</dd>
          <dt class="text-text-faint">publicación</dt>
          <dd>{estacion!.nombrePublicacion}</dd>
          <dt class="text-text-faint">dominio</dt>
          <dd>{estacion!.dominio}</dd>
          <dt class="text-text-faint">mount de Triton</dt>
          <dd><code class="t-mono">{estacion!.tritonMount ?? '—'}</code></dd>
        </dl>
      )}
    </section>

    <section class="mb-12">
      <h2 class="t-label mb-6 text-text-accent">
        Al aire
      </h2>
      {alAire ? (
        <p class="text-body">
          <strong>{alAire.titulo}</strong>
          {alAire.artista && <span class="text-text-muted"> — {alAire.artista}</span>}
        </p>
      ) : (
        <p class="max-w-[62ch] text-body-sm text-text-muted">
          La bitácora está vacía. Es lo esperado: ninguna estación tiene cargada la lista blanca
          <code class="t-mono mx-1">categoriasMusicales</code>, y la ingesta <strong>falla cerrado</strong>,
          así que descarta todo lo que manda el playout. Es la tarea A6 del plan.
        </p>
      )}
    </section>

    <section>
      <h2 class="t-label mb-6 text-text-accent">
        Mapa de sitio
      </h2>
      <ul class="divide-y divide-borde-hairline text-body-sm">
        {SECCIONES.map((s) => (
          <li class="flex items-baseline gap-6 py-5">
            <span class="t-mono w-6 shrink-0 text-text-faint">{s.n}</span>
            <span class="w-52 shrink-0 font-medium text-text-primary">{s.nombre}</span>
            <code class="t-mono w-44 shrink-0 text-text-accent">{s.ruta}</code>
            <span class="text-text-faint">{s.coleccion}</span>
            {s.listo && <span class="t-mono ml-auto shrink-0 text-state-success">✓ construida</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
