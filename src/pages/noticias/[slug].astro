---
/**
 * La nota. Pantallas 14c (1280) y 14f (390).
 *
 * La URL es PLANA —`/noticias/<slug>`, no `/<seccion>/<slug>`— y es la decisión 10
 * del plan: `noticias.categorias` es `hasMany` sin categoría primaria, así que
 * derivar el path de `categorias[0]` haría que reordenar el array cambiara una URL
 * viva en silencio. De paso, es el path que el CMS ya emite en sus feeds.
 */
import Base from '@/layouts/Base.astro';
import NavSecciones from '@/components/NavSecciones.astro';
import Lexical from '@/components/Lexical.astro';
import TarjetaNota from '@/components/TarjetaNota.astro';
import Icono from '@/components/Icono.astro';
import Anuncio from '@/components/Anuncio.astro';
import { obtenerNota, obtenerRelacionadas } from '@/lib/cms/noticias';
import { urlMedia } from '@/lib/cms/client';
import {
  nombreCategoria,
  slugCategoria,
  seccionDeNota,
  firma,
  fechaCorta,
  fechaIso,
  enlacesCompartir,
} from '@/lib/nota';
import { SITE_URL } from '@/config/site';

const { slug } = Astro.params;

let nota = null;
try {
  nota = slug ? await obtenerNota(slug) : null;
} catch {
  // Si el CMS no responde no se puede saber si la nota existe. Un 404 sería una
  // mentira cacheable; un 503 es la verdad y no se indexa.
  return new Response('El CMS no responde. Vuelve a intentarlo en un momento.', {
    status: 503,
    headers: { 'cache-control': 'no-store', 'retry-after': '30' },
  });
}

if (!nota) return Astro.rewrite('/404');

const relacionadas = await obtenerRelacionadas(nota, 3);

const cat = nombreCategoria(nota);
const catSlug = slugCategoria(nota);
/*
  La sección de esta nota —Beat Scanner o Editorial— la decide su categoría. De
  aquí salen la migaja y la pastilla encendida de la tira; antes las dos decían
  «BEAT SCANNER» fijo, y con dos secciones eso era falso para la mitad.
*/
const seccion = seccionDeNota(nota);
/*
  ⚠️ La categoría se repite en la migaja SOLO si no es la de la sección. Si no,
  una nota de Editorial pintaba «EDITORIAL · Editorial»: la misma palabra dos veces
  separadas por un punto, y el segundo enlace llevando al mismo sitio que el
  primero.
*/
const catEnMigaja = cat && catSlug !== seccion.categoria ? cat : null;
const autor = firma(nota);
const publicada = fechaCorta(nota.fecha ?? nota.createdAt);
const publicadaIso = fechaIso(nota.fecha ?? nota.createdAt);
const hero = urlMedia(nota.imagen, 'large');
const canonica = new URL(`/noticias/${nota.slug}`, SITE_URL).href;
const compartir = enlacesCompartir(canonica, nota.titulo ?? '');

const pieDeFoto =
  nota.imagen && typeof nota.imagen === 'object' ? (nota.imagen.alt ?? null) : null;

// Las etiquetas del pie (14c: "etiquetas, autor y tres notas relacionadas").
const etiquetas = (nota.etiquetas ?? []).filter(
  (e): e is Exclude<typeof e, number> => typeof e === 'object' && e !== null,
);
---

{/*
  La nota es lo ÚNICO que se comparte de verdad, así que es la que pasa su propia
  ficha: su foto, su fecha y `article`. `hero` ya viene absoluta —`urlMedia` le
  pone el host público del CMS—, que es lo que Facebook exige.
*/}
<Base
  titulo={`${nota.titulo} — Beat 100.9`}
  descripcion={nota.resumen ?? undefined}
  imagen={hero}
  tipo="article"
  publicado={publicadaIso}
>
  <article class="nt">
    {/* ── Migaja: sección · tipo ── */}
    <div class="nt-cabeza">
      {/*
        🔴 La tira de secciones también AQUÍ (decisión de Carlos, 2026-09-07).

        Faltaba, y era el único interior sin ella. En un interior la barra oscura
        va recogida a propósito (`Base.astro`), y quien carga con ese trabajo es
        esta tira —lo dice `NavSecciones.astro`: «es la ÚNICA navegación visible de
        un interior»—. Las cinco secciones la ponen por `CabezaSeccion`; la nota no
        usa esa cabecera, así que se quedaba con la hamburguesa como única salida:
        el lector que termina de leer no tiene a dónde ir sin abrir un menú.

        La sección activa la decide la CATEGORÍA de la nota (`seccionDeNota`), no
        una constante: con Beat Scanner y Editorial separadas, marcar siempre la
        misma pastilla le habría dicho al lector que está en una sección en la que
        no está.
      */}
      <NavSecciones activa={seccion.href} />

      <div class="nt-migaja">
        <a href={seccion.href} class="beat-label nt-seccion">{seccion.rotulo}</a>
        {
          catEnMigaja && (
            <>
              <span class="beat-label nt-punto">·</span>
              <a
                href={catSlug ? `/beat-scanner/${catSlug}` : seccion.href}
                class="beat-label nt-cat"
              >
                {catEnMigaja}
              </a>
            </>
          )
        }
      </div>

      {/* ── Titular centrado ── */}
      <div class="nt-titular">
        <h1 class="nt-h1" data-escribir>{nota.titulo}</h1>
        {nota.resumen && <p class="nt-bajada">{nota.resumen}</p>}

        {/*
          🔴 Aquí NO va el nombre del autor (decisión de Carlos, 2026-09-07).

          Estaba en los dos sitios: aquí suelto, y otra vez abajo en la ficha con
          su foto y su línea. La misma firma dos veces en una nota no añade
          autoridad, resta — y la de abajo es la que puede llevar retrato, cargo y
          algún día un enlace a la página del autor.

          Lo que se queda arriba es lo que sí cambia por nota y se consulta de un
          vistazo: la FECHA y compartir.
        */}
        <div class="nt-credito">
          {
            publicada && (
              <time class="beat-label nt-fecha" datetime={publicadaIso ?? undefined}>
                {publicada}
              </time>
            )
          }
          <span class="nt-compartir">
            {
              compartir.map((s) =>
                s.icono === 'link' ? (
                  /*
                    «Copiar enlace» es un botón, no un enlace: no navega. Lleva el
                    href canónico en un `data-` para que funcione sin JS si el
                    lector lo copia a mano, y el script lo usa con la API del
                    portapapeles.
                  */
                  <button
                    type="button"
                    class="nt-compartir-uno"
                    data-copiar={s.href}
                    aria-label={s.etiqueta}
                    title={s.etiqueta}
                  >
                    <Icono nombre={s.icono} tamano={16} />
                  </button>
                ) : (
                  <a
                    href={s.href}
                    class="nt-compartir-uno"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.etiqueta}
                    title={s.etiqueta}
                  >
                    <Icono nombre={s.icono} tamano={16} />
                  </a>
                ),
              )
            }
          </span>
        </div>
      </div>
    </div>

    {/* ── Foto principal, 16:7 a lo ancho ── */}
    {
      hero && (
        <figure class="nt-hero-caja">
          {/* El otro extremo de la transición: comparte nombre con la foto de la
              tarjeta desde la que se llegó. Ver `TarjetaNota.astro`. */}
          <div class="nt-hero" transition:name={`foto-nota-${nota.id}`}>
            <img src={hero} alt={pieDeFoto ?? ''} fetchpriority="high" decoding="async" />
            <div class="beat-grid nt-hero-trama" />
          </div>
          {pieDeFoto && <figcaption class="beat-label nt-pie">{pieDeFoto}</figcaption>}
        </figure>
      )
    }

    {/* ── Cuerpo a 680 + riel ── */}
    <div class="nt-abajo">
      <div class="nt-cuerpo">
        <Lexical contenido={nota.contenido} />

        {
          etiquetas.length > 0 && (
            <div class="nt-etiquetas">
              {etiquetas.map((e) => (
                <a href={`/etiqueta/${e.slug}`} class="beat-label nt-etiqueta">
                  {e.nombre}
                </a>
              ))}
            </div>
          )
        }

        {
          autor && (
            <div class="nt-ficha-autor">
              {/*
                La foto de verdad cuando el CMS la trae, y el MONOGRAMA cuando no.
                Antes esto era un círculo con degradado y nada dentro, que se leía
                como una imagen que no cargó — y hoy es el caso de todas las notas,
                porque la colección `autores` está vacía y la firma viene del campo
                de texto libre. Las iniciales dicen la verdad: no hay retrato.
              */}
              <div class="nt-autor-foto">
                {autor.foto ? (
                  <img src={autor.foto} alt={autor.nombre} loading="lazy" decoding="async" />
                ) : (
                  <span class="beat-display nt-autor-monograma" aria-hidden="true">
                    {autor.monograma}
                  </span>
                )}
              </div>
              <div class="nt-autor-datos">
                <span class="nt-autor-nombre">{autor.nombre}</span>
                {/* El cargo capturado si existe; si no, la línea de la casa. */}
                <span class="nt-autor-bio">{autor.cargo ?? 'Escribe para Beat 100.9.'}</span>
              </div>
            </div>
          )
        }
      </div>

      <aside class="nt-riel">
        <Anuncio formato="box" nombre="nota-box" unidad="Box" />
      </aside>
    </div>

    {/* ── Tres relacionadas ── */}
    {
      relacionadas.length > 0 && (
        <section class="nt-relacionadas">
          <div class="nt-rel-cabeza">
            <span class="beat-display nt-rel-titulo">SIGUE LEYENDO</span>
          </div>
          <div class="nt-rel-rejilla">
            {relacionadas.map((n) => (
              <TarjetaNota nota={n} variante="relacionada" />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>

<script>
  /**
   * «Copiar enlace».
   *
   * Se registra con delegación en `document` y una sola vez, no un listener por
   * botón: con el `ClientRouter` de Astro la página se reemplaza sin recargar el
   * documento, así que los listeners por elemento se acumularían en cada
   * navegación. La delegación sobrevive sola.
   */
  // Cast local en vez de `declare global`: es el mismo criterio que `audio.ts`,
  // y un script inline no puede importar tipos de un módulo.
  const w = window as Window & { __beatCopiarListo?: boolean };
  if (!w.__beatCopiarListo) {
    w.__beatCopiarListo = true;
    document.addEventListener('click', async (ev) => {
      const boton = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-copiar]');
      if (!boton) return;
      const url = boton.dataset.copiar;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        boton.dataset.copiado = 'sí';
        setTimeout(() => delete boton.dataset.copiado, 1600);
      } catch {
        // Sin permiso de portapapeles (o sin HTTPS): no se finge que funcionó.
      }
    });
  }
</script>

<style>
  .nt {
    max-width: var(--grid-max);
    margin: 0 auto;
  }

  /* ── cabeza ── */
  .nt-cabeza {
    padding: 30px 24px 0;
  }
  /*
    ⚠️ El aire que separa la migaja de la tira va AQUÍ, en la migaja, y no en la
    tira. No es capricho: una clase pasada como prop a `NavSecciones` no recibe el
    ámbito de esta página, así que un `.nt-nav { margin-bottom }` escrito aquí no
    aplicaría — es el mismo fallo que tenía `CabezaSeccion` y que se veía como el
    «texto encimado». El aire de ARRIBA de la tira y su filete son suyos y los pone
    ella; este es el de después, y lo pone quien viene después.

    Es lo mismo que hace `CabezaSeccion` con `.cs-titular { padding-top }`.
  */
  .nt-migaja {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 22px;
  }
  .nt-seccion {
    color: var(--text-muted);
    font-size: 9px;
  }
  .nt-seccion:hover {
    color: var(--mist-1);
  }
  .nt-punto {
    color: var(--text-faint);
    font-size: 9px;
  }
  .nt-cat {
    color: var(--mist-0);
    font-size: 9px;
  }
  .nt-titular {
    max-width: 880px;
    margin: 26px auto 0;
    text-align: center;
  }
  .nt-h1 {
    font: 700 52px / 1.04 var(--font-text);
    letter-spacing: -0.026em;
    color: var(--mist-1);
    margin: 0;
    text-wrap: pretty;
  }
  .nt-bajada {
    font: var(--type-body-lg);
    color: var(--text-muted);
    margin: 20px auto 0;
    max-width: 56ch;
    text-wrap: pretty;
  }
  .nt-credito {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border-hairline);
  }
  .nt-fecha {
    color: var(--text-faint);
    font-size: 9px;
    white-space: nowrap;
  }
  .nt-compartir {
    display: flex;
    gap: 8px;
    margin-left: 8px;
  }
  .nt-compartir-uno {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    color: var(--mist-4);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition:
      color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .nt-compartir-uno:hover {
    color: var(--mist-0);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  /* Confirmación del copiado, sin toast: el botón se pone del color de acento. */
  .nt-compartir-uno[data-copiado] {
    color: var(--state-success);
    box-shadow: inset 0 0 0 1px var(--state-success);
  }

  /* ── foto principal ── */
  .nt-hero-caja {
    margin: 28px 24px 0;
  }
  .nt-hero {
    position: relative;
    /*
      🔴 3:2, y era `16 / 7` (Carlos, 2026-09-07). Una caja de 2.29 sobre una foto
      de 1.5 se come un tercio del alto: en los retratos de artista que publica la
      estación, eso es cortar la cabeza o los pies. 3:2 es lo que sale de la cámara,
      así que la foto entra entera y `cover` no recorta nada.
    */
    aspect-ratio: 3 / 2;
    background: var(--grad-noche);
    overflow: hidden;
    /* Flota sobre el fondo, así que lleva radio de media. Ver movimiento.md §6. */
    border-radius: var(--r-media);
  }
  .nt-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nt-hero-trama {
    position: absolute;
    inset: 0;
  }
  .nt-pie {
    display: block;
    padding: 10px 0 0;
    text-align: center;
    color: var(--text-faint);
    font-size: 8.5px;
  }

  /* ── cuerpo ── */
  .nt-abajo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 44px;
    align-items: start;
    padding: 40px 24px 44px;
  }
  .nt-cuerpo {
    /*
      🔴 `width` explícito, no solo `max-width`.
      Con `max-width` + `margin: 0 auto` en un ítem de rejilla, los márgenes
      automáticos ganan sobre el estirado y la caja se encoge a su CONTENIDO: una
      nota de un párrafo salía a 521px y una larga a 680, o sea que la medida de
      la columna dependía del largo del texto. Medido en dos notas reales.
    */
    width: min(100%, 680px);
    margin: 0 auto;
  }
  .nt-riel {
    position: sticky;
    top: calc(var(--chrome-h) + 16px);
  }

  .nt-etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid var(--border-hairline);
  }
  .nt-etiqueta {
    padding: 9px 13px;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    color: var(--text-body);
    font-size: 9px;
    white-space: nowrap;
    transition:
      background var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }
  .nt-etiqueta:hover {
    background: var(--mist-0);
    color: var(--noche-0);
  }

  .nt-ficha-autor {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 18px;
    margin-top: 26px;
    padding: 20px;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
  }
  .nt-autor-foto {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border-radius: 999px;
    background: var(--grad-noche);
    /* El retrato es redondo: sin esto la foto cuadrada se sale del círculo. */
    overflow: hidden;
  }
  .nt-autor-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nt-autor-monograma {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    /* `aria-hidden`: el nombre completo está al lado, y un lector de pantalla
       leyendo «FO» antes de «Fernanda Ortíz» solo estorba. */
  }
  .nt-autor-datos {
    min-width: 0;
  }
  .nt-autor-nombre {
    display: block;
    font: 600 16px/1.2 var(--font-text);
    color: var(--mist-2);
  }
  .nt-autor-bio {
    display: block;
    font: 400 14px/1.5 var(--font-text);
    color: var(--text-muted);
    margin-top: 6px;
    text-wrap: pretty;
  }

  /* ── relacionadas ── */
  .nt-relacionadas {
    padding: 0 24px 48px;
  }
  .nt-rel-cabeza {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .nt-rel-titulo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
  }
  .nt-rel-rejilla {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
    margin-top: 24px;
  }

  /* ── 14f: móvil ── */
  @media (max-width: 899px) {
    .nt-cabeza {
      padding: 22px 16px 0;
    }
    .nt-migaja {
      padding-top: 16px;
    }
    .nt-titular {
      margin-top: 18px;
      text-align: left;
    }
    .nt-h1 {
      font: 700 30px / 1.08 var(--font-text);
      letter-spacing: -0.022em;
    }
    .nt-bajada {
      font: 400 15px/1.55 var(--font-text);
      margin-top: 14px;
      max-width: none;
    }
    .nt-credito {
      justify-content: flex-start;
      gap: 10px;
      margin-top: 18px;
      padding-top: 16px;
    }
    .nt-compartir {
      margin-left: 0;
      width: 100%;
      margin-top: 4px;
    }

    .nt-hero-caja {
      margin: 20px 0 0;
    }
    .nt-pie {
      padding: 8px 16px 0;
      text-align: left;
    }

    .nt-abajo {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 26px 16px 30px;
    }
    .nt-cuerpo {
      max-width: none;
    }
    .nt-riel {
      position: static;
    }

    .nt-relacionadas {
      padding: 0 16px 36px;
    }
    .nt-rel-titulo {
      font-size: 18px;
    }
    .nt-rel-rejilla {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 18px;
    }
  }
</style>
