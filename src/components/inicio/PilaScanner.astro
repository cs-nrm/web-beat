---
/**
 * «BEAT SCANNER» en el Inicio — la PILA.
 *
 * Las notas se apilan como cartas AL HACER SCROLL: cada una queda fija mostrando
 * solo su franja de título, la siguiente se desliza encima, y las de atrás se
 * encogen para dar profundidad. La última queda arriba, completa.
 *
 * 🔴 Antes esto era un dibujo, no un comportamiento: dos tarjetas «asomadas» de
 * 88px y dos abiertas, todas quietas. Se veía como la referencia solo si nadie
 * hacía scroll. Ahora todas las tarjetas son iguales y el apilado lo produce el
 * scroll (referencia que mandó Carlos, 2026-08-24).
 *
 * 🔴 Y se hace con `position: sticky`, sin JavaScript. El apilado funciona en
 * cualquier navegador; el encogido de las de atrás va como MEJORA sobre animación
 * ligada al scroll, que Chrome y Edge ya tienen y Safari y Firefox todavía no. Sin
 * soporte, las tarjetas se apilan igual — solo no encogen.
 */
import Icono from '@/components/Icono.astro';
import Remate from '@/components/Remate.astro';
import { urlMedia } from '@/lib/cms/client';
import { minutosDeLectura } from '@/lib/cms/noticias';
import { nombreCategoria } from '@/lib/nota';
import type { Noticia } from '@/types/payload';

interface Props {
  notas: Noticia[];
}

const { notas } = Astro.props;

/*
  Cuatro como máximo. No es un tope estético: cada tarjeta de la pila ocupa una
  pantalla de scroll, así que con más de cuatro la sección se vuelve un túnel del
  que cuesta salir. El resto de las notas está a un clic en `/scanner`.
*/
const enLaPila = notas.slice(0, 4).map((n) => ({
  nota: n,
  href: `/noticias/${n.slug}`,
  foto: urlMedia(n.imagen, 'card'),
  min: minutosDeLectura(n.contenido),
  cat: nombreCategoria(n),
  alt: n.imagen && typeof n.imagen === 'object' ? (n.imagen.alt ?? '') : '',
}));
---

{
  enLaPila.length > 0 && (
    <section class="pila">
      <div class="pila-cabeza" data-barrido>
        <h2 class="beat-display pila-seccion" data-escribir>BEAT SCANNER</h2>
        <Remate href="/scanner" texto="TODAS LAS NOTAS" clase="pila-todo" />
      </div>

      <div class="pila-mazo">
        {/*
          `--i` manda cuatro cosas: a qué altura se queda fija la tarjeta, quién
          queda encima de quién, cuánto se encoge, y —con `--total`— cuántas tiene
          delante. Van como variables de CSS para no escribir una regla por cada
          posición de la pila.

          ⚠️ El comentario va AQUÍ y no entre los atributos: Astro no admite
          comentarios dentro de la lista de atributos de una etiqueta, y los parsea
          como atributos sueltos. Es el tercer tropiezo igual en este repo.
        */}
        {enLaPila.map((p, i) => (
          <a href={p.href} class="pila-carta" data-luz style={`--i:${i}; --total:${enLaPila.length}`}>
            <div class="pila-carta-foto" transition:name={`foto-nota-${p.nota.id}`}>
                            {p.foto && <img src={p.foto} alt={p.alt} loading="lazy" decoding="async" />}
              <div class="beat-grid pila-trama" />
            </div>

            <div class="pila-carta-texto">
              {/*
                El titular va PRIMERO y solo, porque es lo único que se ve cuando la
                tarjeta queda al fondo de la pila: esa franja tiene que decir de qué
                es la nota sin nada más.
              */}
              <h3 class="pila-carta-titulo">{p.nota.titulo}</h3>
              {p.nota.resumen && <p class="pila-carta-bajada">{p.nota.resumen}</p>}
              <div class="pila-carta-meta">
                {p.cat && <span class="beat-label pila-cat">{p.cat}</span>}
                <span class="beat-label pila-min">{p.min} MIN</span>
              </div>
              <span class="pila-cta" data-flecha>
                Leer la nota
                <Icono nombre="arrow-up-right" tamano={16} />
              </span>
            </div>
          </a>
        ))}

        {/*
          🔴 Un espaciador REAL, no `padding` ni `margin`.

          El rango en que una tarjeta `sticky` se queda fija termina donde termina
          la última caja del contenedor. Medido: ni el `padding-bottom` del mazo ni
          el `margin-bottom` de la cuarta tarjeta lo extendían — la pila completa se
          alcanzaba y se deshacía en 40px de scroll, o sea que el gesto terminaba en
          el mismo instante en que se completaba. Con un elemento de verdad después
          de la última carta, la pila armada se sostiene mientras se recorre.
        */}
        <div class="pila-remanso" aria-hidden="true" />
      </div>

      <div class="pila-pie">
        <a href="/scanner" class="beat-label pila-mas">VER BEAT SCANNER</a>
      </div>
    </section>
  )
}

<style>
  .pila {
    padding: 24px 24px 0;
  }
  .pila-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .pila-seccion {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
    margin: 0;
  }
  .pila-todo {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .pila-todo:hover {
    color: var(--mist-0);
  }

  .pila-mazo {
    /*
      🔴 Sin `overflow` aquí. Un `overflow: hidden` o `auto` en un ancestro anula
      el `position: sticky` de los hijos, y la pila se vuelve una lista normal sin
      que nada avise.
    */
    margin-top: 26px;
  }

  /*
    El recorrido que sostiene la pila ya armada. Es contenido, no espacio: ver el
    comentario del marcado.
  */
  .pila-remanso {
    /* Al subir las franjas de 22 a 94px la última carta se fija MÁS TARDE, así que
       necesita más recorrido detrás para sostener la pila armada. */
    height: min(115vh, 1020px);
  }

  /* ── la carta ── */
  .pila-carta {
    position: sticky;
    /*
      Se queda fija BAJO el chrome, escalonada por índice: cada tarjeta se detiene
      76px más abajo que la anterior, y ese escalón ES la franja que queda a la
      vista cuando la tapan.

      🔴 94px no es un número redondo, es la medida del titular acotado a DOS
      líneas: 24px de padding superior + 62px de dos líneas a 25px/1.24 + aire.

      Con los 22px que tenía se veía una rendija de color y nada más. Y 76px
      tampoco alcanzaban: la referencia usa títulos de una línea («Nuestros
      Ingredientes») y los nuestros son titulares de noticia — medido con el
      contenido real, ocupaban 3 líneas y 86px.
    */
    top: calc(var(--chrome-h) + 20px + var(--i) * 94px);
    /* La de más arriba en el marcado queda ABAJO en la pila. */
    z-index: calc(var(--i) + 1);
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 36px;
    /*
      🔴 `start`, no `center`. Con el contenido centrado verticalmente el titular
      queda a media altura de la tarjeta, o sea FUERA de la franja que se ve cuando
      la tapan: se apilaban cuatro franjas de color sin una palabra.
    */
    align-items: start;
    /*
      🔴 Este margen ES el recorrido de scroll entre una carta y la siguiente, no
      un respiro visual: mientras se recorre, la carta de abajo va subiendo a tapar
      a la de arriba.

      Con los 26px que tenía, medido: las cuatro pasaban de sueltas a apiladas y
      desaparecían en menos de 500px de scroll — el gesto ocurría, pero tan rápido
      que no se leía. Con ~34vh cada transición ocupa aproximadamente una pantalla,
      que es el ritmo de la referencia.

      Se acota con `min()` para que en un monitor muy alto no se vuelva un túnel.
    */
    margin-bottom: min(30vh, 265px);
    padding: 26px 36px;
    border-radius: var(--r-4);
    /*
      Fondo OPACO, no translúcido. Las cartas se tapan entre sí, así que una
      translúcida dejaría ver la de atrás y el apilado se leería como suciedad.
    */
    background: var(--noche-1);
    box-shadow:
      inset 0 0 0 1px var(--border-quiet),
      0 -18px 44px rgba(5, 7, 6, 0.55);
    color: inherit;
    text-decoration: none;
    /*
      Se encoge según cuántas tiene DELANTE: la de enfrente queda a tamaño natural
      y cada una detrás pierde 2.5%. Con cuatro son 7.5% entre la primera y la
      última — «poquito», como lo pidió Carlos, y en la misma dirección que la
      referencia (que va de 977 a 1119px de ancho entre la del fondo y la de
      enfrente).

      El origen arriba-centro es lo que mantiene alineadas las franjas: si
      encogiera desde el centro, cada tarjeta bajaría su borde superior y el
      escalonado se desordenaría.
    */
    transform: scale(calc(1 - (var(--total) - 1 - var(--i)) * 0.025));
    transform-origin: center top;
  }
  /* La última CONSERVA su margen: es el recorrido que le da su momento completo
     en pantalla antes de que la pila se suelte. */

  .pila-carta-foto {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--grad-noche);
    border-radius: var(--r-media);
    overflow: hidden;
  }
  .pila-carta-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pila-trama {
    position: absolute;
    inset: 0;
  }
  .pila-carta-texto {
    min-width: 0;
  }
  .pila-carta-titulo {
    font: 700 25px / 1.24 var(--font-text);
    letter-spacing: -0.016em;
    color: var(--mist-1);
    margin: 0;
    /* Más ancho que antes (24ch): en la franja el título es lo ÚNICO que se lee,
       así que conviene que quepa en una línea o dos, no en tres. */
    max-width: 34ch;
    text-wrap: pretty;
    /*
      Acotado a DOS líneas. La franja de la pila mide lo que miden dos líneas, así
      que un titular de tres se cortaría a media palabra sin avisar. Con el
      recorte, el corte es explícito y con puntos suspensivos.
    */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .pila-carta-bajada {
    font: var(--type-body);
    color: var(--text-muted);
    margin: 14px 0 0;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .pila-carta-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  .pila-cat {
    color: var(--mist-0);
    font-size: 9px;
    white-space: nowrap;
  }
  .pila-min {
    color: var(--text-faint);
    font-size: 9px;
    white-space: nowrap;
  }
  .pila-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--mist-0);
    color: var(--noche-0);
    font: 600 12.5px/1 var(--font-text);
  }
  .pila-carta:hover .pila-cta {
    background: var(--mist-1);
  }
  .pila-carta:hover .pila-carta-titulo {
    color: var(--mist-0);
  }


  .pila-pie {
    display: flex;
    justify-content: center;
    padding: 34px 0 0;
  }
  .pila-mas {
    padding: 13px 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--border-strong);
    color: var(--mist-2);
    font-size: 9px;
    white-space: nowrap;
  }
  .pila-mas:hover {
    background: var(--mist-0);
    color: var(--noche-0);
  }

  @media (max-width: 899px) {
    .pila {
      padding: 24px 16px 0;
    }
    .pila-seccion {
      font-size: 20px;
    }
    /*
      🔴 En móvil la pila NO se apila.
      Con el chrome ocupando 104px y una tarjeta que necesita foto + texto, el
      escalonado dejaría cada carta con menos de media pantalla útil. Vuelven a ser
      tarjetas apiladas normales, que es lo que 14a dibuja.
    */
    .pila-carta {
      position: static;
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0 0 18px;
      margin-bottom: 12px;
      top: auto;
      border-radius: var(--r-media);
      box-shadow: inset 0 0 0 1px var(--border-hairline);
      overflow: hidden;
      /* Sin apilado, el encogido por posición no significa nada: sería una
         tarjeta más chica que las otras sin motivo. */
      transform: none;
    }
    .pila-carta-foto {
      border-radius: 0;
    }
    .pila-carta-texto {
      padding: 14px 16px 0;
    }
    .pila-carta-titulo {
      font: 700 19px / 1.2 var(--font-text);
      max-width: none;
    }
    .pila-carta-bajada {
      font: 400 14.5px / 1.5 var(--font-text);
      margin-top: 10px;
      max-width: none;
    }
    .pila-cta {
      margin-top: 14px;
      padding: 11px 18px;
    }
    /* Sin apilado no hay recorrido que sostener. */
    .pila-remanso {
      display: none;
    }
  }
</style>
