---
/**
 * El formato «Inline» de Medios Federales (Smart AdServer / Equativ, red 4308):
 * un video in-read que flota abajo a la IZQUIERDA del Inicio.
 *
 * Aquí solo va el contenedor. El pedido, el render, el mostrado y la X viven en
 * `src/scripts/smart.ts`, que corre en cada `astro:page-load` y solo hace algo
 * en las páginas que traen este nodo (hoy, el Inicio).
 *
 * Es la misma receta que ya corre en Oye, Stereo Cien y Sabrosita, adaptada a
 * Beat: los ids por env (ver `SMART_SITE_ID` en `src/config/site.ts`) y la capa
 * en la escala del design system.
 *
 * No romper: el id `inline` del hueco tiene que coincidir letra por letra con el
 * `tagId` del pedido y con `sas.render()`. El fragmento que manda Medios
 * Federales trae `tagId: "inline"` y el div como `Inline`, y los ids de HTML
 * distinguen mayúsculas: así no se pinta nunca.
 */
import Icono from '@/components/Icono.astro';
import { SMART_SITE_ID, SMART_PAGE_ID, HOST_CANONICO } from '@/config/site';

const encendido = Boolean(SMART_SITE_ID && SMART_PAGE_ID);
---

{
  encendido && (
    <div
      class="smart-inline"
      data-smart-inline
      data-sitio={SMART_SITE_ID}
      data-pagina={SMART_PAGE_ID}
      data-dominio={HOST_CANONICO}
    >
      <button type="button" class="smart-inline-cerrar" data-smart-cerrar aria-label="Cerrar publicidad">
        <Icono nombre="x" tamano={14} />
      </button>
      <span class="beat-label smart-inline-rotulo">PUBLICIDAD</span>
      <div id="inline" class="smart-inline-hueco"></div>
    </div>
  )
}

<style>
  /*
    Abajo a la IZQUIERDA porque la derecha ya es de los visores que abre el
    lector: el de las canciones (`.pista-visor`) y el del Fenómeno
    (`.fr-visor-marco[data-flotante]`). El player va en la cabecera, así que abajo
    no hay nada más que esquivar.

    `z-index` justo DEBAJO de `--z-sticky`: por debajo de esos dos visores (un
    video que el lector pidió no puede quedar tapado por un anuncio), de la
    cabecera, del menú, del modal del pre-roll, del takeover y del intro.
  */
  .smart-inline {
    position: fixed;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: calc(var(--z-sticky) - 1);
    width: min(300px, calc(100vw - 32px));
    /*
      El padding va desde el principio y no solo con anuncio: el formato
      (plantilla video-read de Equativ) mide el ancho del hueco al pintar, y
      cambiarlo después dejaría el video a otra medida que su caja.
    */
    padding: 8px;
    pointer-events: none;
  }
  /*
    Sin anuncio, el contenedor está en su sitio pero TRANSPARENTE, sin rótulo ni X
    y sin atrapar clics. Trampa: no puede ir en `display: none` hasta que haya
    anuncio, porque oculto el hueco mide 0 de ancho y la plantilla no arranca.

    Y no se decide contando hijos del hueco: Smart mete ahí sus `<script>` y un
    contenedor de 1px aunque no haya video. Lo enciende `smart.ts` cuando el
    hueco mide más de 20px de alto.
  */
  .smart-inline-rotulo,
  .smart-inline-cerrar {
    display: none;
  }
  .smart-inline[data-con-anuncio] {
    background: var(--noche-0);
    box-shadow:
      0 0 0 1px var(--border-hairline),
      0 18px 48px rgb(5 7 6 / 0.55);
    pointer-events: auto;
  }
  .smart-inline[data-con-anuncio] .smart-inline-rotulo {
    display: block;
    margin-bottom: 6px;
    font-size: 8px;
    letter-spacing: 0.22em;
    color: var(--text-faint);
  }
  /* La X, igual que la del visor de las canciones. */
  .smart-inline[data-con-anuncio] .smart-inline-cerrar {
    position: absolute;
    top: -10px;
    right: -10px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 999px;
    background: var(--noche-0);
    box-shadow: 0 0 0 1px var(--border-strong);
    color: var(--mist-0);
    cursor: pointer;
  }
  .smart-inline-hueco {
    line-height: 0;
  }
</style>
