---
/**
 * «EL FENÓMENO RESIDENTE» en el Inicio — el bloque de la semana de 13a.
 *
 * Tres columnas: el video vertical 9:16, la lista de las cápsulas, y el panel de
 * la playlist. Todo sale de UN especial y sus `piezas`, que es una polimórfica
 * ORDENADA: el orden numera las cápsulas, así que no se reordena nunca.
 */
import Icono from '@/components/Icono.astro';
import Remate from '@/components/Remate.astro';
import Anuncio from '@/components/Anuncio.astro';
import { urlMedia } from '@/lib/cms/client';
import { capsulasDe, listaDe } from '@/lib/cms/especiales';
import { fuenteDeCancion, suena } from '@/lib/canciones';
import { fuenteDeVideo } from '@/lib/video';
import { fechaCorta } from '@/lib/nota';
import type { Especiale } from '@/types/payload';

interface Props {
  especial: Especiale | null;
  /**
   * Dónde se está pintando este bloque. Solo cambia cuánta presentación lleva
   * encima; el tema —visor, cápsulas y playlist— es idéntico en los tres.
   *
   * 🔴 Es UN parámetro y no dos booleanos sueltos, porque los tres casos son
   * excluyentes y con dos banderas habría cuatro combinaciones, una de ellas sin
   * sentido. Un enum de tres valores no se puede poner en un estado imposible.
   *
   *   `inicio`  — con la barra de sección y su remate al archivo, y con el
   *               titular del tema. Es un bloque entre otros seis.
   *   `seccion` — `/fenomeno-residente`: sin la barra (ya estás dentro, y el
   *               remate llevaría al archivo desde el archivo), con el titular.
   *   `tema`    — `/especiales/<slug>`: sin la barra y SIN el titular, porque el
   *               `h1` de la página ya es el nombre del tema. Repetirlo dejaba el
   *               mismo texto dos veces seguidas.
   */
  contexto?: 'inicio' | 'seccion' | 'tema';
  /**
   * El `nombre` del box de 300×250 que va bajo el panel de la playlist, o nada si
   * esta superficie no lleva uno.
   *
   * 🔴 Lo pasa la PÁGINA y no se deduce del `contexto`. El nombre es la llave con
   * la que GAM reporta el hueco y con la que se factura, así que se escribe donde
   * se decidió la colocación —`/fenomeno-residente` y `/especiales/<slug>`, dos
   * superficies distintas para el anunciante— y no en un componente del Inicio,
   * donde nadie que revise el inventario lo iría a buscar.
   *
   * ⚠️ En el Inicio va vacío A PROPÓSITO: ahí el box vive «de riel junto al
   * archivo», que es donde lo pone el lienzo (`ArchivoTemas.astro`). Dos boxes en
   * la portada serían dos peticiones a GAM compitiendo por la misma pantalla.
   */
  anuncio?: string | null;
}

const { especial, contexto = 'inicio', anuncio = null } = Astro.props;

const conCabeza = contexto === 'inicio';
const conTitular = contexto !== 'tema';

const capsulas = capsulasDe(especial);
const playlist = listaDe(especial);

/**
 * La cápsula que encabeza: la marcada como destacada si la hay, y si no la última
 * publicada. Nunca «la de hoy» calculada contra el reloj: eso exigiría una fecha de
 * emisión por cápsula que el CMS no tiene, y adivinarla pintaría «HOY» en algo que
 * no salió hoy.
 */
const destacadaId =
  especial?.piezaDestacada && typeof especial.piezaDestacada === 'object'
    ? typeof especial.piezaDestacada.value === 'object'
      ? especial.piezaDestacada.value?.id
      : especial.piezaDestacada.value
    : null;

const encabeza = capsulas.find((c) => c.doc.id === destacadaId) ?? capsulas.at(-1) ?? null;

const videoFoto = urlMedia(encabeza?.doc.imagen, 'large');

/**
 * Cada cápsula con su fuente de video ya resuelta en el SERVIDOR: el navegador
 * recibe un id validado, no una URL que tenga que interpretar.
 *
 * Las que no traen video utilizable se quedan como enlace a su nota — un botón de
 * reproducir que no reproduce es peor que no tenerlo.
 */
const capsulasConVideo = capsulas.map((c) => ({ ...c, fuente: fuenteDeVideo(c.doc.video) }));
const fuenteEncabeza = encabeza ? fuenteDeVideo(encabeza.doc.video) : null;
const rango =
  especial?.inicio && especial?.fin
    ? `${fechaCorta(especial.inicio)} — ${fechaCorta(especial.fin)}`
    : fechaCorta(especial?.inicio);

const publicadas = capsulas.length;
const patrocina = especial?.patrocinador?.nombre ? especial.patrocinador : null;
const logoPatrocinio = urlMedia(patrocina?.logo, 'thumbnail');

/** Los enlaces a plataformas de la playlist, solo los que existen. */
const tiendas = (
  [
    ['SPOTIFY', playlist?.playlistSpotify],
    ['APPLE MUSIC', playlist?.playlistAppleMusic],
  ] as Array<[string, string | null | undefined]>
).filter((t): t is [string, string] => Boolean(t[1]));
---

{
  especial && (
    <section class="fr" data-fenomeno>
      {conCabeza && (
        <div class="fr-cabeza" data-barrido>
          <h2 class="beat-display fr-seccion" data-escribir>EL FENÓMENO RESIDENTE</h2>
          <Remate href="/fenomeno-residente" texto="VER EL ARCHIVO" clase="fr-todo" />
        </div>
      )}

      {conTitular && (
        <div class="fr-tema">
          <div class="fr-tema-texto">
            <span class="beat-label fr-rango">
              TEMA DE LA SEMANA{rango && ` · ${rango}`}
            </span>
            <h3 class="fr-titulo" data-escribir>{especial.titulo}</h3>
          </div>
        </div>
      )}

      <div class="fr-columnas">
        {/* ── el video vertical ── */}
        {encabeza ? (
          /*
            EL VISOR. No es un enlace a la nota: es donde se reproduce. Al elegir
            una cápsula de la lista del centro, su video se carga AQUÍ.

            `data-orientacion` reserva la forma de la caja antes de que exista el
            video, y cambia al elegir otra cápsula. Es para lo que el CMS tiene ese
            campo: «el front no la puede adivinar antes de cargar el video, y de eso
            depende cómo reserva el espacio».
          */
          <div
            class="fr-video"
            id="fr-visor"
            data-visor
            data-estado="portada"
          >
            {/*
              El MARCO es lo que flota al salir de pantalla. El `.fr-video` de
              afuera se queda en el flujo conservando su alto, así que al despegarse
              no se abre un hueco ni salta la página — y sirve de centinela para
              saber cuándo el visor volvió a la vista.
            */}
            <div class="fr-visor-marco" data-visor-marco>
            {/*
              🔴 Un `<video>`, no un `<div>` vacío. Plyr necesita un elemento de
              MEDIOS para construirse; sobre un div sin `data-plyr-provider` se
              instancia a medias y no monta nada — el estado decía «sonando» y no
              había ni reproductor ni iframe. Al asignarle una fuente de YouTube,
              Plyr sustituye este elemento por el iframe del proveedor.
            */}
            <video class="fr-visor-montaje" data-visor-montaje playsinline />

            <div class="fr-visor-portada" data-visor-portada>
              {videoFoto && <img src={videoFoto} alt="" loading="lazy" decoding="async" />}
              <div class="beat-grid fr-video-trama" />
              <span class="beat-label fr-insignia">
                CÁPSULA {String(encabeza.n).padStart(2, '0')}
              </span>

              {fuenteEncabeza ? (
                /*
                  Es un `<button>` y no un div con onclick: tiene que alcanzarse con
                  teclado y anunciarse como control. Lleva los mismos `data-` que las
                  filas de la lista, así que el mismo manejador lo atiende.
                */
                <button
                  type="button"
                  class="fr-visor-arranque"
                  data-proveedor={fuenteEncabeza.proveedor}
                  data-fuente={fuenteEncabeza.src}
                  data-titulo={encabeza.doc.titulo}
                >
                  <span class="fr-play">
                    <Icono nombre="play" tamano={20} />
                  </span>
                  <span class="fr-video-texto">
                    <span class="fr-video-titulo">{encabeza.doc.titulo}</span>
                    {fuenteEncabeza.duracion && (
                      <span class="beat-label fr-video-dur">{fuenteEncabeza.duracion}</span>
                    )}
                  </span>
                </button>
              ) : (
                /* Sin video utilizable: se degrada a enlace a la nota. */
                <a href={`/noticias/${encabeza.doc.slug}`} class="fr-visor-arranque es-enlace">
                  <span class="fr-video-texto">
                    <span class="fr-video-titulo">{encabeza.doc.titulo}</span>
                  </span>
                </a>
              )}
            </div>

            {/*
              Solo se ve cuando el visor está flotando: devuelve el video a su
              lugar. Sin esta salida, un reproductor fijo que el lector no quiere
              es una trampa.
            */}
              <button
                type="button"
                class="fr-visor-cerrar"
                data-visor-cerrar
                aria-label="Cerrar el video"
              >
                <Icono nombre="x" tamano={16} />
              </button>
            </div>
          </div>
        ) : (
          <div class="fr-video es-vacio" />
        )}

        {/* ── las cápsulas ── */}
        <div class="fr-lista" data-capsulas data-cascada>
          <div class="fr-lista-cabeza">
            <span class="beat-label fr-lista-titulo">LAS CÁPSULAS</span>
            <span class="beat-label fr-lista-nota" data-contar>
              {publicadas} PUBLICADA{publicadas === 1 ? '' : 'S'}
            </span>
          </div>
          {/*
            📖 Sin cápsulas la lista no se pinta — decisión del 2026-09-09. Aquí
            salía «Las cápsulas de este tema todavía no se cargan. Se agregan al
            especial como piezas», que le explicaba al lector cómo se captura en el
            CMS. El contador «N PUBLICADAS» de arriba ya dice que son cero.
          */}
          {capsulas.length > 0 && (
            capsulasConVideo.map((c) =>
              /*
                La que TIENE video es un botón: carga el visor de la izquierda sin
                salir de la página. La que no, sigue siendo un enlace a su nota, que
                es lo honesto — no se ofrece reproducir algo que no se puede.
              */
              c.fuente ? (
                <button
                  type="button"
                  class:list={['fr-capsula', { 'es-destacada': c.n === encabeza?.n }]}
                  data-proveedor={c.fuente.proveedor}
                  data-fuente={c.fuente.src}
                  data-titulo={c.doc.titulo}
                  data-activa={c.n === encabeza?.n ? 'sí' : undefined}
                  aria-pressed="false"
                >
                  <span class="beat-label fr-capsula-n">{String(c.n).padStart(2, '0')}</span>
                  <span class="fr-capsula-titulo">{c.doc.titulo}</span>
                  {/*
                    Los DOS iconos van en el marcado y `video.ts` alterna cuál se
                    ve — el mismo patrón que el botón del directo en la cabecera.
                    Así el cambio de estado no reconstruye SVG.
                  */}
                  <span class="fr-capsula-icono">
                    <span data-icono="play" class="contents"><Icono nombre="play" tamano={14} /></span>
                    <span data-icono="pause" class="contents hidden">
                      <Icono nombre="pause" tamano={14} />
                    </span>
                  </span>
                  {c.fuente.duracion && (
                    <span class="beat-label fr-capsula-dur">{c.fuente.duracion}</span>
                  )}
                </button>
              ) : (
                <a href={`/noticias/${c.doc.slug}`} class="fr-capsula">
                  <span class="beat-label fr-capsula-n">{String(c.n).padStart(2, '0')}</span>
                  <span class="fr-capsula-titulo">{c.doc.titulo}</span>
                </a>
              ),
            )
          )}

          {patrocina && (
            <div class="fr-patrocinio">
              <span class="beat-label fr-patrocinio-rotulo">CON EL APOYO DE</span>
              {logoPatrocinio ? (
                <img src={logoPatrocinio} alt={patrocina.nombre ?? ''} class="fr-patrocinio-logo" />
              ) : (
                <span class="fr-patrocinio-nombre">{patrocina.nombre}</span>
              )}
            </div>
          )}
        </div>

        {/* ── la playlist y, debajo, el box ── */}
        <div class="fr-lateral">
          {/*
            🔴 `data-pistas` es el CONTRATO de la cola de `pista.ts`: el módulo sube
            desde la fila pulsada hasta este atributo para saber qué canciones van
            detrás. Sin él —y estuvo sin él hasta el 2026-09-10— cada fila era una
            lista de UNA, así que las dos canciones ocupaban la posición 0 de su
            propia cola y pulsar la segunda se leía como volver a pulsar la primera:
            play/pausa en vez de cambiar de canción. Lo tenía Bonus Beat y aquí se
            copió el marcado sin él.
          */}
          <div class="fr-playlist" data-pistas>
            <div class="fr-playlist-cabeza">
              <span class="beat-label fr-playlist-titulo">PLAYLIST ASOCIADO</span>
              {playlist?.canciones && (
                <span class="beat-label fr-playlist-nota">{playlist.canciones.length} TRACKS</span>
              )}
            </div>
            {/*
              📖 Sin playlist no se pinta la columna — decisión del 2026-09-09. Aquí
              caía «Sin playlist todavía. Se agrega al especial en “Lista de
              canciones”», que nombraba un campo del CMS delante del lector.
            */}
            {playlist?.canciones && playlist.canciones.length > 0 && (
              <>
                {playlist.canciones.slice(0, 6).map((c, i) => {
                  const cancion = typeof c.cancion === 'object' ? c.cancion : null;
                  const fuente = fuenteDeCancion(cancion);
                  /*
                    🔴 La fila es un BOTÓN cuando hay algo que reproducir, y era un
                    `<div>` inerte hasta el 2026-09-09: sin cursor, sin foco, sin
                    nada que pulsar. Se leía como una lista de nombres cuando lo que
                    hay detrás es música.

                    ⚠️ Y sigue degradando a `<div>` sin fuente. Un botón que no
                    reproduce es peor que un texto: promete y no cumple.

                    ⚠️ `Etiqueta` en vez de duplicar la fila entera en las dos ramas
                    —el contenido es idéntico y solo cambia el envoltorio—. Duplicarla
                    sería mantener dos veces el mismo marcado.
                  */
                  const Etiqueta = suena(fuente) ? 'button' : 'div';
                  return (
                    <Etiqueta
                      class:list={['fr-track', { 'es-pulsable': suena(fuente) }]}
                      {...(suena(fuente)
                        ? {
                            type: 'button' as const,
                            'data-pista-src': fuente.audio ?? undefined,
                            'data-pista-yt': fuente.youtube ?? undefined,
                            'data-pista-titulo': cancion?.titulo ?? '',
                            'data-pista-artista': cancion?.artista ?? '',
                            'aria-pressed': 'false',
                            'aria-label': `Reproducir ${cancion?.titulo ?? 'la canción'}`,
                          }
                        : {})}
                    >
                      <span class="beat-label fr-track-n">{String(i + 1).padStart(2, '0')}</span>
                      <span class="fr-track-texto">
                        <span class="fr-track-titulo">{cancion?.titulo ?? '—'}</span>
                        {cancion?.artista && (
                          <span class="fr-track-artista">{cancion.artista}</span>
                        )}
                      </span>
                      {cancion?.duracion && (
                        <span class="beat-label fr-track-dur">{cancion.duracion}</span>
                      )}
                      {suena(fuente) && (
                        <span class="fr-track-icono">
                          {/*
                            El alternado play/pausa es CSS sobre `[data-sonando]`,
                            no clases movidas por JavaScript — el mismo patrón que
                            Bonus Beat. `pista.ts` solo pone el atributo en la fila
                            que está al aire y el resto lo decide la hoja.
                          */}
                          <span class="fr-track-glifo" data-icono="play">
                            <Icono nombre="play" tamano={12} />
                          </span>
                          <span class="fr-track-glifo" data-icono="pause">
                            <Icono nombre="pause" tamano={12} />
                          </span>
                        </span>
                      )}
                    </Etiqueta>
                  );
                })}
                {tiendas.length > 0 && (
                  <div class="fr-tiendas">
                    {tiendas.map(([etiqueta, url]) => (
                      <a
                        href={url}
                        class="beat-label fr-tienda"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {etiqueta}
                      </a>
                    ))}
                  </div>
                )}
              </>
            )}
          </div>

          {/*
            El box CIERRA la columna, no la abre: la playlist es contenido del tema
            y el anuncio es lo que viene después de haberlo leído.

            🔴 Y va en el DOM donde se ve, sin `order`. En móvil esta columna baja
            entera y el orden visual es el de lectura, así que quien navegue con
            teclado se encuentra el hueco en el mismo sitio que quien lo ve. Un
            reordenado por CSS habría puesto el anuncio antes de la playlist para la
            vista y después para el foco.
          */}
          {anuncio && <Anuncio formato="box" nombre={anuncio} unidad="Box" />}
        </div>
      </div>
    </section>
  )
}

<style>
  /* La piel de Plyr. Va aquí y no en la hoja base para que solo pese en las
     páginas que de verdad tienen un visor. */
  /*
    📖 Aquí estaba `@import 'plyr/dist/plyr.css'` y se fue a `Base.astro` el
    2026-09-09, porque desde aquí **no alcanzaba**.

    Astro ESCOPA lo que importa un `<style>` de componente: las reglas de Plyr
    salían con el `data-astro-cid` de este archivo, así que solo vestían al visor
    del Fenómeno. El visor flotante de las canciones vive en el layout, fuera de
    este ámbito, y le llegaba Plyr SIN hoja: medido, los controles ocupaban 1049px
    de alto, los iconos salían a 300×150 y el iframe a 640 de ancho desbordando un
    marco de 360. La prueba de que estaba escopada son los `:global(.plyr …)` de
    más abajo, que existen justo para atravesar ese ámbito.

    ⚠️ El coste conocido: la piel de Plyr pasa a bajar en TODAS las páginas y no
    solo en las que tienen visor. Es inevitable en cuanto el reproductor vive en el
    cromo — tiene que seguir sonando al navegar—, así que se asume a la vista.
  */

  .fr {
    padding: 32px 24px 0;
  }
  .fr-cabeza,
  .fr-lista-cabeza,
  .fr-playlist-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .fr-seccion {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
    margin: 0;
  }
  .fr-todo {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .fr-todo:hover {
    color: var(--mist-0);
  }

  .fr-tema {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-top: 26px;
  }
  /* Sin la barra de sección no hay de qué separarse: el margen de arriba lo pone
     quien envuelve. `:first-child` y no una clase, para que no haya dos formas de
     decir lo mismo. */
  .fr-tema:first-child {
    margin-top: 0;
  }
  .fr-tema-texto {
    min-width: 0;
  }
  .fr-rango {
    color: var(--mist-0);
  }
  .fr-titulo {
    font: 700 26px / 1.1 var(--font-text);
    letter-spacing: -0.016em;
    color: var(--mist-2);
    margin: 8px 0 0;
    text-wrap: pretty;
  }

  .fr-columnas {
    display: grid;
    grid-template-columns: 296px minmax(0, 1fr) 320px;
    gap: 24px;
    align-items: start;
    margin-top: 20px;
  }
  .fr-columnas:first-child {
    margin-top: 0;
  }

  /* ── el visor ── */
  .fr-video {
    position: relative;
    display: block;
    /*
      🔴 9:16 SIEMPRE. Las cápsulas se publican como reels, así que el formato es
      del formato de la serie, no de cada archivo.

      Antes la caja seguía `video.orientacion` del CMS. Se quitó por decisión de
      Carlos: el material horizontal que había era una prueba, y adaptar la caja a
      cada pieza significaba que un archivo mal capturado deformaba el layout de la
      portada. Con la medida fija, un horizontal se ve con bandas —que es correcto—
      y nada se mueve.
    */
    aspect-ratio: 9 / 16;
    background: var(--grad-noche);
    box-shadow: inset 0 0 0 1px var(--border-quiet);
  }
  .fr-visor-marco {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--grad-noche);
    /* Flota sobre el fondo, así que lleva radio de media. Ver movimiento.md §6. */
    border-radius: var(--r-media);
  }
  .fr-visor-montaje,
  .fr-visor-portada {
    position: absolute;
    inset: 0;
  }
  .fr-visor-portada[hidden] {
    display: none;
  }
  /*
    Plyr tiene que LLENAR la caja del visor.

    ⚠️ Los selectores cuelgan de `.fr-video` y no de `.fr-visor-montaje`: al
    construirse, Plyr REEMPLAZA el `<video>` que llevaba esa clase por su propio
    marcado, así que cualquier regla anclada ahí deja de aplicar. Se vio como un
    iframe de 640×360 dentro de un panel de 296×526.

    Y hay que anular el `padding-bottom` con el que Plyr fija la proporción del
    proveedor: aquí la proporción la manda el panel (`data-orientacion`), que es
    la que el CMS declara para cada cápsula.
  */
  .fr-video :global(.plyr) {
    width: 100%;
    height: 100%;
    /* 🔴 Blanco, no coral. Es la barra de progreso y el realce de los controles
       del visor: naranja a pantalla completa era el otro sitio donde sobrevivía
       el acento cálido. movimiento.md §8. */
    --plyr-color-main: var(--mist-0);
  }
  .fr-video :global(.plyr__video-wrapper) {
    height: 100%;
    padding-bottom: 0 !important;
  }
  /* Un video horizontal dentro de una caja vertical: se ve entero con bandas, en
     vez de recortarse. `contain` y no `cover` porque en una cápsula lo que importa
     es lo que se ve, no llenar la caja. */
  .fr-video :global(.plyr iframe),
  .fr-video :global(.plyr video) {
    object-fit: contain;
  }
  .fr-video :global(.plyr iframe),
  .fr-video :global(.plyr video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fr-visor-arranque {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 56px 16px 16px;
    background: var(--grad-scrim-b);
    border: 0;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  /* Mientras carga Plyr (110 KB), el botón dice que algo está pasando. */
  .fr-video[data-estado='cargando'] .fr-play {
    opacity: 0.6;
  }
  .fr-video[data-estado='error']::after {
    content: 'No se pudo cargar el video';
    position: absolute;
    inset: auto 0 0 0;
