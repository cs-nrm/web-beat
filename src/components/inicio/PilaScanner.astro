---
/**
 * «BEAT SCANNER» en el Inicio — la PILA de 13a.
 *
 * Es el gesto más particular del diseño: las notas se apilan como cartas. Las de
 * abajo asoman en 88px con solo su titular; las dos de arriba están abiertas, con
 * foto y bajada, y cada nivel sube su fondo (.078 → .092) y su radio. Lee como un
 * mazo del que se está sacando la de arriba.
 *
 * ⚠️ El orden visual va AL REVÉS del orden de lectura: en el marcado las asomadas
 * van primero (arriba en pantalla) y las abiertas después, porque cada una se monta
 * sobre la anterior. Así que la nota MÁS reciente es la última del bloque, no la
 * primera. Se ordena aquí, una vez, y no en la plantilla.
 */
import Icono from '@/components/Icono.astro';
import { urlMedia } from '@/lib/cms/client';
import { minutosDeLectura } from '@/lib/cms/noticias';
import { nombreCategoria } from '@/lib/nota';
import type { Noticia } from '@/types/payload';

interface Props {
  notas: Noticia[];
}

const { notas } = Astro.props;

/*
  Cuatro piezas: dos asomadas y dos abiertas. Las abiertas son las DOS PRIMERAS del
  listado (las más recientes), y van al final del marcado para quedar encima de la
  pila. Con menos de cuatro notas la pila se acorta sola en vez de dejar huecos.
*/
const abiertas = notas.slice(0, 2);
const asomadas = notas.slice(2, 4);

const preparar = (n: Noticia) => ({
  nota: n,
  href: `/noticias/${n.slug}`,
  foto: urlMedia(n.imagen, 'card'),
  min: minutosDeLectura(n.contenido),
  cat: nombreCategoria(n),
  alt: n.imagen && typeof n.imagen === 'object' ? (n.imagen.alt ?? '') : '',
});
---

{
  notas.length > 0 && (
    <section class="pila">
      <div class="pila-cabeza">
        <h2 class="beat-display pila-seccion">BEAT SCANNER</h2>
        <a href="/scanner" class="beat-label pila-todo">TODAS LAS NOTAS</a>
      </div>

      <div class="pila-mazo">
        {asomadas.map(preparar).map((p) => (
          <a href={p.href} class="pila-asomada">
            <div class="pila-asomada-foto">
              {p.foto && <img src={p.foto} alt={p.alt} loading="lazy" decoding="async" />}
              <div class="beat-grid pila-trama" />
            </div>
            <span class="pila-asomada-titulo">{p.nota.titulo}</span>
          </a>
        ))}

        {abiertas.map(preparar).map((p, i) => (
          <a href={p.href} class:list={['pila-abierta', i === 1 && 'es-cima']}>
            <div class="pila-abierta-foto">
              {p.foto && <img src={p.foto} alt={p.alt} loading="lazy" decoding="async" />}
              <div class="beat-grid pila-trama" />
            </div>
            <div class="pila-abierta-texto">
              <h3 class="pila-abierta-titulo">{p.nota.titulo}</h3>
              {p.nota.resumen && <p class="pila-abierta-bajada">{p.nota.resumen}</p>}
              <div class="pila-abierta-meta">
                {p.cat && <span class="beat-label pila-cat">{p.cat}</span>}
                <span class="beat-label pila-min">{p.min} MIN</span>
              </div>
              <span class="pila-cta">
                Leer la nota
                <Icono nombre="arrow-up-right" tamano={16} />
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="pila-pie">
        <a href="/scanner" class="beat-label pila-mas">VER BEAT SCANNER</a>
      </div>
    </section>
  )
}

<style>
  .pila {
    padding: 24px 24px 0;
  }
  .pila-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .pila-seccion {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
    margin: 0;
  }
  .pila-todo {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .pila-todo:hover {
    color: var(--mist-0);
  }

  /* ── las asomadas: 88px, solo el titular ── */
  .pila-asomada {
    position: relative;
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 36px;
    align-items: center;
    height: 88px;
    box-sizing: border-box;
    padding: 0 36px;
    margin-top: 26px;
    background: var(--grad-noche);
    border-radius: var(--r-3) var(--r-3) 0 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }
  .pila-asomada + .pila-asomada {
    margin-top: 2px;
  }
  .pila-asomada-foto {
    display: none;
  }
  .pila-asomada-titulo {
    grid-column: 2;
    font: 700 24px / 1.2 var(--font-text);
    letter-spacing: -0.016em;
    color: var(--mist-4);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }
  .pila-asomada:hover .pila-asomada-titulo {
    color: var(--mist-2);
  }

  /* ── las abiertas: cada nivel sube el fondo y la sombra ── */
  .pila-abierta {
    position: relative;
    display: grid;
    grid-template-columns: 400px minmax(0, 1fr);
    gap: 36px;
    align-items: start;
    padding: 26px 36px 36px;
    margin-top: 2px;
    border-radius: var(--r-4);
    background: rgba(255, 255, 255, 0.078);
    box-shadow:
      inset 0 0 0 1px var(--border-quiet),
      0 -18px 40px rgba(5, 7, 6, 0.5);
    color: inherit;
    text-decoration: none;
  }
  .pila-abierta.es-cima {
    margin-top: 20px;
    background: rgba(255, 255, 255, 0.092);
    box-shadow:
      inset 0 0 0 1px var(--border-quiet),
      0 -18px 44px rgba(5, 7, 6, 0.58);
  }
  .pila-abierta-foto {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--grad-noche);
    border-radius: var(--r-3);
    overflow: hidden;
  }
  .pila-abierta-foto img,
  .pila-asomada-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pila-trama {
    position: absolute;
    inset: 0;
  }
  .pila-abierta-texto {
    min-width: 0;
    text-align: center;
    padding: 0 12px;
  }
  .pila-abierta-titulo {
    font: 700 25px / 1.24 var(--font-text);
    letter-spacing: -0.016em;
    color: var(--mist-1);
    margin: 0 auto;
    max-width: 24ch;
    text-wrap: pretty;
  }
  .pila-abierta-bajada {
    font: var(--type-body);
    color: var(--text-muted);
    margin: 16px auto 0;
    max-width: 44ch;
    text-wrap: pretty;
  }
  .pila-abierta-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 18px;
  }
  .pila-cat {
    color: var(--mist-0);
    font-size: 9px;
    white-space: nowrap;
  }
  .pila-min {
    color: var(--text-faint);
    font-size: 9px;
    white-space: nowrap;
  }
  .pila-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--mist-0);
    color: var(--noche-0);
    font: 600 12.5px/1 var(--font-text);
  }
  .pila-abierta:hover .pila-cta {
    background: var(--mist-1);
  }

  .pila-pie {
    display: flex;
    justify-content: center;
    padding: 26px 0 0;
  }
  .pila-mas {
    padding: 13px 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--border-strong);
    color: var(--mist-2);
    font-size: 9px;
    white-space: nowrap;
  }
  .pila-mas:hover {
    background: var(--mist-0);
    color: var(--noche-0);
  }

  @media (max-width: 899px) {
    .pila {
      padding: 24px 16px 0;
    }
    .pila-seccion {
      font-size: 20px;
    }
    /*
      🔴 En móvil la pila SE DESARMA, y es una decisión, no una simplificación.
      El gesto de las cartas necesita una columna de 400px para la foto y otra para
      el texto; a 390px de ancho total, apilar con sombras y radios superpuestos
      solo produce ruido. Cada nota pasa a ser una tarjeta normal, apilada.
    */
    .pila-asomada,
    .pila-abierta {
      grid-template-columns: 1fr;
      gap: 0;
      height: auto;
      padding: 0 0 18px;
      margin-top: 18px;
      border-radius: var(--r-3);
      background: var(--noche-1);
      box-shadow: inset 0 0 0 1px var(--border-hairline);
      overflow: hidden;
    }
    .pila-asomada + .pila-asomada,
    .pila-abierta.es-cima {
      margin-top: 12px;
      background: var(--noche-1);
      box-shadow: inset 0 0 0 1px var(--border-hairline);
    }
    .pila-asomada-foto {
      display: block;
      position: relative;
      aspect-ratio: 16 / 10;
      background: var(--grad-noche);
    }
    .pila-abierta-foto {
      border-radius: 0;
    }
    .pila-asomada-titulo {
      grid-column: auto;
      font: 600 16px / 1.26 var(--font-text);
      white-space: normal;
      text-align: left;
      padding: 14px 16px 0;
      color: var(--mist-2);
    }
    .pila-abierta-texto {
      text-align: left;
      padding: 14px 16px 0;
    }
    .pila-abierta-titulo {
      font: 700 19px / 1.2 var(--font-text);
      margin: 0;
      max-width: none;
    }
    .pila-abierta-bajada {
      font: 400 14.5px / 1.5 var(--font-text);
      margin: 10px 0 0;
      max-width: none;
    }
    .pila-abierta-meta {
      justify-content: flex-start;
      margin-top: 14px;
    }
    .pila-cta {
      margin-top: 16px;
      padding: 11px 18px;
    }
  }
</style>
