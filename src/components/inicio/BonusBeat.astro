---
/**
 * «BONUS BEAT» en el Inicio — el bloque de listas de 13a.
 *
 * Sale de `listas`, no de una colección propia: cada edición es una `lista` del
 * tipo «Bonus Beat», y su `canciones[].comentario` es la VIÑETA que el mapa de
 * sitio pedía («por qué está aquí, qué contar de ella»). Los enlaces a plataformas
 * salen gratis del catálogo de `canciones`.
 *
 * La ruta se construye desde el SLUG del tipo, que es dato editorial. Este
 * componente no sabe que se llama «Bonus Beat»: recibe el tipo y lo usa.
 */
import Icono from '@/components/Icono.astro';
import Anuncio from '@/components/Anuncio.astro';
import { urlMedia } from '@/lib/cms/client';
import {
  fuenteDeCancion,
  MINIMO_PARA_PORCENTAJE,
  ordenarPorVotos,
  repartirPorcentajes,
  suena,
  totalDeVotos,
} from '@/lib/canciones';
import type { Lista, TiposDeLista } from '@/types/payload';

interface Props {
  lista: Lista | null;
  tipo: TiposDeLista | null;
  /**
   * El nombre del hueco de publicidad que va al lado de las canciones, si lo hay.
   *
   * Lo pasa la PÁGINA y no se declara aquí, por lo mismo que en `Fenomeno.astro`
   * y `Agenda.astro`: este componente lo usan el Inicio y la sección, y un hueco
   * escrito dentro le aparecería a las dos. Sin prop no se pinta nada.
   */
  anuncio?: string | null;
  /**
   * Dónde se pinta.
   *
   *   `inicio`  — con su barra de sección («BONUS BEAT · <fecha>») y el remate a
   *               todas las ediciones. Es un bloque entre otros.
   *   `edicion` — dentro de la sección: solo las canciones. El nombre y la fecha
   *               los lleva ya el encabezado de la página, y repetirlos dejaba el
   *               mismo rótulo dos veces con dos tipografías distintas.
   */
  contexto?: 'inicio' | 'edicion';
  /**
   * En cuántas columnas se reparten las canciones.
   *
   * `1` es la fila ancha de siempre y es lo que usa Bonus Beat, con tres
   * canciones. El Top Ten trae VEINTE, y en una sola columna eso es una página de
   * scroll infinito: de ahí `2` en la sección (diez y diez) y `4` en el Inicio,
   * donde el bloque comparte pantalla con todo lo demás.
   *
   * Lo decide la PÁGINA y no este componente, por lo mismo que `anuncio`: el
   * mismo bloque lo pintan el Inicio y la sección, y cada uno tiene su sitio.
   */
  columnas?: 1 | 2 | 4;
}

const { lista, tipo, contexto = 'inicio', anuncio = null, columnas = 1 } = Astro.props;

const enInicio = contexto === 'inicio';
const rutaTipo = tipo?.slug ? `/${tipo.slug}` : null;

/**
 * El orden que se pinta, y el voto.
 *
 * `ordenarPorVotos` devuelve el array INTACTO mientras nadie haya votado, así que
 * Bonus Beat —que nunca pinta botón— conserva su orden editorial y el Top Ten
 * muestra el de la estación hasta el primer voto. No hace falta que este
 * componente sepa qué tipo de lista está pintando.
 *
 * El botón se pinta SOLO con la votación abierta. `agents/frontend.md`: «un
 * control que no hace nada se RETIRA, no se deja inerte» — un botón muerto es
 * alcanzable con el tabulador, se anuncia en un lector de pantalla y le enseña al
 * lector a desconfiar de los demás. Cerrada la votación, no hay botón.
 *
 * El CONTEO sí sobrevive al cierre: es lo que explica por qué la lista está en ese
 * orden. Pero si nadie ha votado no se pinta ni un cero, por la regla de las zonas
 * vacías.
 */
const canciones = lista?.canciones?.length ? ordenarPorVotos(lista.canciones) : [];

/**
 * Los tramos del carrusel: «01-04», «05-08»…
 *
 * De cuatro en cuatro porque son cuatro las que caben a la vez. El último puede
 * quedar corto —con 18 canciones sería «17-18»— y se escribe tal cual: redondear
 * a «17-20» prometería dos que no están.
 */
const POR_VISTA = 4;
const paginas =
  columnas === 4
    ? Array.from({ length: Math.ceil(canciones.length / POR_VISTA) }, (_, i) => {
        const desde = i * POR_VISTA + 1;
        const hasta = Math.min((i + 1) * POR_VISTA, canciones.length);
        const dos = (n: number) => String(n).padStart(2, '0');
        return desde === hasta ? dos(desde) : `${dos(desde)}-${dos(hasta)}`;
      })
    : [];
const votacionAbierta = Boolean(lista?.votacionAbierta);

/*
  Se pinta el PORCENTAJE, no el número de votos. Decisión de Carlos
  (2026-09-21): «así no evidenciamos si tenemos solo 5 votos».

  Y por eso hay un piso (`MINIMO_PARA_PORCENTAJE`): con pocos votos el porcentaje
  delata más que el número —un voto de un total es «100%» y nueve «0%»—, así que por
  debajo del mínimo no se pinta cifra ninguna y la lista se queda con su orden. El
  orden sí sale siempre de los votos crudos.
*/
const totalVotos = totalDeVotos(canciones);
const conPorcentaje = totalVotos >= MINIMO_PARA_PORCENTAJE;
const porcentajes = repartirPorcentajes(canciones);
const conVoto = votacionAbierta || conPorcentaje;

/**
 * Las plataformas de una canción, solo las que tienen enlace.
 *
 * Recibe `unknown` y no un tipo: `canciones[].cancion` es `number | Cancione`
 * según el `depth`, y el parámetro suelto evita un cast dentro de la plantilla —
 * que Astro no parsea cuando el cast lleva una unión.
 */
/*
  Aquí vivía `audioDe()`, que leía `canciones.audio` a mano, y se fue el
  2026-09-09 a `src/lib/canciones.ts` como `fuenteDeCancion()`.

  El motivo no fue ordenar: la playlist del Fenómeno necesita exactamente la misma
  resolución de fuentes, y tenerla duplicada en dos plantillas es cómo se llega a
  que una sepa de `embedUrl` y la otra no. Ese campo —medido: 8 de 8 canciones con
  YouTube, 0 con `audio`— se descubrió DESPUÉS de escribir esta función, y es justo
  la clase de hallazgo que hay que poder aplicar en un solo sitio.
*/


function plataformasDe(c: unknown): Array<[string, string]> {
  if (!c || typeof c !== 'object') return [];
  const doc = c as Record<string, unknown>;
  const texto = (campo: string): string | null => {
    const v = doc[campo];
    return typeof v === 'string' && v.trim() ? v : null;
  };

  /*
    Aquí iba `['YOUTUBE', texto('youtube') ?? texto('embedUrl')]`, y se fue el
    2026-09-09: la pista YA SE OYE en la página. El botón de la portada llama a
    `fuenteDeCancion()`, que lee esos dos mismos campos, así que el chip no daba
    una forma más de escuchar — daba una forma de IRSE a escucharlo a otro sitio.

    Y era el único que llegaba a pintarse. Medido contra el CMS el mismo día:
    de las 3 canciones de la lista publicada, las 3 traen `embedUrl` y NINGUNA
    trae `spotify`, `appleMusic` ni `deezer`; las 3 filas traen su botón. O sea
    que a partir de ahora `plataformas` sale vacío y la fila de chips no se pinta.

    Los tres campos que quedan NO son código muerto: es la única salida a tiendas
    que tiene la sección y vuelven solos en cuanto la redacción los capture. Por
    eso tampoco se toca `.bb-plataforma` en la hoja de estilos.

    Lo que sí sigue vivo es el detalle de los valores de YouTube: llevan
    `&list=RD…&start_radio=1`, o sea la RADIO de la pista y no la pista sola. Hoy
    eso le importa al reproductor, no a este enlace — ver `fuenteDeCancion()` en
    `src/lib/canciones.ts`; si estorba se corrige en el CMS, no aquí.
  */
  const campos: Array<[string, string | null]> = [
    ['SPOTIFY', texto('spotify')],
    ['APPLE', texto('appleMusic')],
    ['DEEZER', texto('deezer')],
  ];
  return campos.filter((par): par is [string, string] => par[1] !== null);
}
---

{
  lista && (
    <section
      class:list={['bb', `es-${contexto}`, `es-rejilla-${columnas}`]}
      data-pistas
      data-voto-lista={conVoto ? String(lista.id) : undefined}
    >
      {/*
        Solo el rótulo de la sección.

        Aquí hubo dos cosas más, y las dos se retiraron por decisión de Carlos.
        Primero «TRES TRACKS CADA VIERNES», que salía del lienzo (2026-09-01):
        nadie ha comprometido esa periodicidad, y un rótulo fijo que promete un día
        de la semana se convierte en un desmentido el primer viernes que no haya
        edición. Después la FECHA de la edición (2026-09-08): «quita la fecha de
        ahí, para que no se vea raro».

        Y tenía razón con el bloque partido en dos columnas: la fecha iba
        alineada al extremo derecho de la cabeza, que ahora es el borde de la
        columna del ANUNCIO. Quedaba un dato editorial rotulando un hueco de
        publicidad.

        La fecha no se pierde: sigue en cada edición dentro de la sección
        —`/bonus-beat`, donde el encabezado la lleva— y en la retícula de
        ediciones anteriores. Lo que se retira es repetirla en el Inicio.
      */}
      {enInicio && (
      <div class="bb-cabeza">
        <h2 class="beat-display bb-seccion">{(tipo?.nombre ?? lista.titulo).toUpperCase()}</h2>
      </div>
      )}

      {/*
        Las canciones y el anuncio COMPARTEN fila (Carlos, 2026-09-08):
        «dividamos Bonus Beat y al lado».

        Antes el bloque era una sola columna a todo lo ancho, y las tres filas de
        canciones dejaban un vacío enorme a la derecha en escritorio. Con el box al
        lado, ese aire pasa a ser inventario y las canciones quedan a una medida de
        lectura en vez de estirarse a 1280px.

        En móvil la rejilla colapsa y el box baja al final, DESPUÉS del remate de
        «ver todas las ediciones»: metido entre las canciones cortaría la lista en
        dos, y una lista de tres tracks partida por un anuncio no se lee como una
        lista.
      */}
      <div class:list={['bb-reparto', { 'con-anuncio': enInicio && anuncio }]}>
      {/*
        `bb-canciones` agrupa la lista con lo que la acompaña —el paginador, el
        modal del voto, el remate— y `bb-tira` es SOLO las tarjetas.

        Están separados porque la tira es la que se reparte en columnas y la que
        se desliza, y meter ahí dentro el paginador lo convertía en una columna
        más: salía flotando a la derecha del carrusel, fuera de la vista, y el
        modal con él. Con 20 canciones la tira tenía 22 hijos.
      */}
      <div class="bb-canciones">
      <div
        class:list={['bb-tira', `es-col-${columnas}`]}
        style={columnas === 2 ? `--filas:${Math.ceil(canciones.length / 2)}` : undefined}
        data-carrusel={columnas === 4 ? 'sí' : undefined}
      >
      {/*
        Sin canciones no se pinta nada — decisión del 2026-09-09. Aquí caía
        «Esta edición todavía no tiene canciones cargadas», que en el Inicio dejaba
        el módulo abierto con una disculpa dentro. Se fue con él su `.bb-vacio`.
      */}
      {canciones.length > 0 && (
        canciones.map((c, i) => {
          const cancion = typeof c.cancion === 'object' ? c.cancion : null;
          const idCancion = cancion?.id ?? (typeof c.cancion === 'number' ? c.cancion : null);
          const porcentaje = porcentajes[i] ?? 0;
          const portada = urlMedia(cancion?.portada, 'thumbnail');
          const plataformas = plataformasDe(cancion);
          const fuente = fuenteDeCancion(cancion);
          return (
            <div class="bb-fila">
              <span class="beat-display bb-n">{String(i + 1).padStart(2, '0')}</span>
              {/*
                La portada ES el botón: es dónde se pulsa para escuchar una canción
                en cualquier sitio donde haya una portada, así que no hace falta
                enseñar un control aparte.

                Y se pinta con mp3 **o** con YouTube. Antes solo con mp3, y como
                ninguna de las 8 canciones del CMS trae `audio`, el botón no se
                pintaba NUNCA: la carátula quedaba como un `<div>` inerte —arte que
                parece pulsable y no lo es, sin cursor de mano y sin play—. Cero
                `bb-portada-btn` en el HTML servido, comprobado con curl. Es justo lo
                que Carlos reportó el 2026-09-09.

                Sigue degradando: una canción sin ninguna de las dos fuentes se
                queda como imagen, en vez de un botón que no reproduce nada.

                `data-pista-*` es todo lo que `pista.ts` necesita: no hay una
                lista de canciones duplicada en el JavaScript, la página la declara.
                `data-pista-yt` lleva el id de 11 caracteres YA validado en el
                servidor — nunca la URL cruda.
              */}
              {suena(fuente) ? (
                <button
                  type="button"
                  class="bb-portada bb-portada-btn"
                  data-pista-src={fuente.audio ?? undefined}
                  data-pista-yt={fuente.youtube ?? undefined}
                  data-pista-sc={fuente.soundcloud ?? undefined}
                  data-pista-titulo={cancion?.titulo ?? ''}
                  data-pista-artista={cancion?.artista ?? ''}
                  aria-pressed="false"
                  aria-label={`Reproducir ${cancion?.titulo ?? 'la pista'}`}
                >
                  {portada && <img src={portada} alt="" loading="lazy" decoding="async" />}
                  <div class="beat-grid bb-trama" />
                  <span class="bb-play">
                    <span class="bb-play-icono" data-icono="play">
                      <Icono nombre="play" tamano={16} />
                    </span>
                    <span class="bb-play-icono bb-play-pausa" data-icono="pause">
                      <Icono nombre="pause" tamano={16} />
                    </span>
                  </span>
                </button>
              ) : (
                <div class="bb-portada">
                  {portada && <img src={portada} alt="" loading="lazy" decoding="async" />}
                  <div class="beat-grid bb-trama" />
                </div>
              )}
              <div class="bb-texto">
                <span class="bb-titulo">{cancion?.titulo ?? '—'}</span>
                <span class="bb-linea">
                  {cancion?.artista}
                  {/* La viñeta es lo que distingue a Bonus Beat de una playlist
                      cualquiera: es el comentario editorial, no un dato del track. */}
                  {c.comentario && (
                    <>
                      {cancion?.artista && ' · '}
                      <span class="bb-vineta">{c.comentario}</span>
                    </>
                  )}
                </span>
              </div>
              {plataformas.length > 0 && (
                <div class="bb-plataformas">
                  {plataformas.map(([etiqueta, url]) => (
                    <a
                      href={url}
                      class="beat-label bb-plataforma"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {etiqueta}
                    </a>
                  ))}
                </div>
              )}
              {conVoto && idCancion !== null && (
                <div class="bb-voto">
                  {/*
                    El porcentaje lo pinta el SERVIDOR y el script no lo toca. No
                    puede: el endpoint devuelve el conteo de UNA canción, y recalcular
                    el reparto exigiría los votos de las otras nueve — que es
                    justamente lo que no puede viajar al navegador, porque un
                    `data-votos` en el marcado se lee con ver el código fuente y
                    tiraría por tierra el motivo de poner porcentajes.

                    Así que el voto se confirma con el pulso del botón y la línea de
                    aviso, y la cifra se mueve en la siguiente carga.
                  */}
                  {/*
                    El 0% no se pinta (Carlos, 2026-09-21). Una canción que no ha
                    recibido un solo voto no necesita que se le ponga un cero al
                    lado: el sitio no rellena huecos con ceros, y su posición al
                    final de la lista ya lo dice.
                  */}
                  {conPorcentaje && porcentaje > 0 && (
                    <span class="beat-label bb-voto-conteo">{porcentaje}%</span>
                  )}
                  {votacionAbierta && (
                    <button
                      type="button"
                      class="beat-label bb-voto-btn"
                      data-voto-cancion={String(idCancion)}
                      aria-label={`Votar por ${cancion?.titulo ?? 'esta canción'}`}
                    >
                      {/*
                        Los dos rótulos viven en el marcado y se alterna cuál se
                        ve, igual que los dos iconos de `.bb-play`: no se reescribe
                        el texto del botón en cada cambio de estado.
                      */}
                      <span class="bb-voto-rotulo">VOTAR</span>
                      <span class="bb-voto-rotulo bb-voto-listo">LISTO</span>
                    </button>
                  )}
                </div>
              )}
            </div>
          );
        })
      )}
      </div>

      {/*
        La respuesta al voto, en un MODAL.

        Aquí hubo una línea de texto debajo de la lista con `aria-live`, y se
        cambió el 2026-09-21 (Carlos): «ahí hasta abajo no se ve». Tenía razón —
        quien vota está mirando el botón que acaba de pulsar, a media página, y el
        aviso aparecía fuera de su campo de visión y a veces fuera de la pantalla.

        `<dialog>` nativo con `showModal()` y no un `<div>` con `aria-modal`: trae
        de fábrica la trampa de foco, el cierre con Escape y el velo como
        `::backdrop`. `Takeover.astro` se escribió a mano, veinte líneas de trampa
        de foco incluidas, porque ahí el contenido es de un tercero y hace falta
        control; aquí no hay nada que justifique repetirlas.

        Lleva el mismo velo que el takeover para que el sitio tenga UN gesto de
        modal y no dos.

        El texto lo escribe `voto.ts`; nace vacío. No es una zona vacía con rótulo:
        el diálogo no existe en pantalla hasta que hay algo que decir.
      */}
      {votacionAbierta && (
        <dialog
          class="bb-modal"
          data-voto-modal
          aria-labelledby={`voto-titulo-${lista.id}`}
        >
          <div class="bb-modal-caja">
            <button
              type="button"
              class="bb-modal-cerrar"
              data-voto-cerrar
              aria-label="Cerrar"
            >
              <Icono nombre="x" tamano={16} />
            </button>
            <p
              class="beat-display bb-modal-titulo"
              id={`voto-titulo-${lista.id}`}
              data-voto-titulo
            />
            <p class="beat-label bb-modal-detalle" data-voto-detalle />
          </div>
        </dialog>
      )}

      {/*
        El remate solo sale en la fila ancha, o sea en Bonus Beat. En la rejilla no
        (Carlos, 2026-09-23: «hay un botón que dice ver top ten, quitémoslo»), y el
        motivo es que ahí sobra: el bloque ya enseña las veinte canciones y se puede
        votar en ellas, así que el enlace lleva a una página con lo mismo.

        Su rótulo decía «VER TODAS LAS EDICIONES» y dejó de ser verdad el mismo día,
        cuando se retiró el archivo. Ahora nombra el tipo, que es lo que hay al otro
        lado y sirve para cualquiera que la estación cree.

        Trampa de Astro, la sexta en este repo: un comentario de llaves NO puede ir
        dentro de la expresión de un `&&`, porque ahí solo cabe un elemento. Va
        antes de la llave que abre.
      */}
      {/*
        El paginador del carrusel, por TRAMOS y no con puntos.

        «Que el paginador sea intuitivo para ver las demás» (Carlos, 2026-09-23).
        Cinco puntos no dicen qué hay detrás de cada uno; «05-08» sí, y en una
        lista numerada del 01 al 20 es exactamente el dato que el lector ya está
        usando para orientarse. Es la misma idea que gobierna los rótulos de este
        sitio: se pinta el dato, no un adorno.

        Son BOTONES y no enlaces: no llevan a otra página, mueven esta. Y la tira
        se desliza igual con el dedo o con el trackpad, así que sin JavaScript el
        bloque sigue siendo recorrible — el paginador es un atajo, no la única
        puerta.
      */}
      {columnas === 4 && paginas.length > 1 && (
        <div class="bb-paginas" data-carrusel-paginas role="group" aria-label="Tramos de la lista">
          {paginas.map((t, i) => (
            <button
              type="button"
              class="beat-label bb-pagina"
              data-carrusel-ir={String(i)}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              {t}
            </button>
          ))}
        </div>
      )}

      {enInicio && rutaTipo && columnas === 1 && (
        <div class="bb-pie">
          <a href={rutaTipo} class="beat-label bb-mas">
            VER {(tipo?.nombre ?? lista.titulo).toUpperCase()}
          </a>
        </div>
      )}
      </div>

      {enInicio && anuncio && (
        <aside class="bb-riel">
          <Anuncio formato="box" nombre={anuncio} unidad="Box" />
        </aside>
      )}
      </div>
    </section>
  )
}

<style>
  .bb {
    padding: 44px 24px 0;
  }
  /*
    En la rejilla de cuatro el bloque vive FUERA del contenedor con tope de ancho
    del Inicio, para que las veinte celdas tengan sitio. El rótulo no: se limita
    aquí, solo, para seguir alineado con el resto de la portada. Es lo mismo que
    hace `.inicio-contenido`, aplicado a una sola pieza.

    La clase la pone la SECCIÓN y no se deduce con `:has()` del contenedor de
    dentro. Con `:has()` funcionaría igual en todo navegador reciente, pero donde
    no exista el rótulo se iría a lo ancho sin que nadie se entere — y un fallo
    silencioso de maquetación es el que nadie reporta. El dato ya lo tiene el
    componente; no hay que adivinarlo desde el CSS.
  */
  .bb.es-rejilla-4 .bb-cabeza {
    max-width: var(--grid-max);
    margin-inline: auto;
  }
  /*
    En la sección propia el bloque no pone NADA de margen: ni arriba (el
    encabezado ya está ahí) ni a los lados (la página tiene el suyo). Con el
    padding puesto se sumaban los dos y las canciones quedaban 48px adentro
    mientras el titular empezaba a 24 — un escalón que no dice nada.
  */
  .bb.es-edicion {
    padding: 0;
  }
  .bb-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }

  /*
    El reparto entre canciones y anuncio. Sin anuncio no hay rejilla: la clase
    `con-anuncio` solo la pone la página que pasa el hueco, así que la sección
    —que no lo pasa— sigue con las canciones a todo lo ancho, exactamente como
    antes. Un `grid` de una sola columna cambiaría el maquetado de un sitio donde
    no hace falta.
  */
  .bb-reparto.con-anuncio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: start;
    gap: 44px;
  }
  .bb-canciones {
    min-width: 0;
  }

  /*
    Las rejillas de lista larga.

    Una lista de veinte canciones en una sola columna es una página que solo se
    recorre con el dedo: por eso la sección va a DOS columnas —diez y diez— y el
    Inicio a CUATRO, donde el bloque convive con todo lo demás.

    `column-gap` con separación vertical propia y no `gap` a secas: las filas ya
    traen su línea de abajo (`border-bottom` en `.bb-fila`), y un hueco vertical
    encima de esa línea la despega del contenido que separa.

