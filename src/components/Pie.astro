---
/**
 * Pie institucional. Del artboard `Pie-Beat`.
 *
 * Cuatro columnas —secciones, radio en vivo, redes, apps—, el bloque legal y la
 * tira de marcas de NRM.
 */
import {
  SECCIONES,
  APPS,
  LEGALES,
  MARCAS_NRM,
} from '@/config/navegacion';
import type { Estacion } from '@/lib/cms/estacion';

interface Props {
  estacion: Estacion;
  /** Redes de la estación, ya resueltas desde el CMS. */
  redes: Array<{ red: string; url: string }>;
}

const { estacion, redes } = Astro.props;
const anio = new Date().getFullYear();
/*
  🔴 El nav del pie es EL MISMO que el del sitio (Carlos, 2026-09-07). Exactamente
  lo que pinta el menú a pantalla completa: las secciones vivas más Programación.

  Antes era el «mapa completo» y añadía Comunidad, Tienda y Marcas en gris. La idea
  era que quien las buscara viera que existen y que aún no están; el resultado eran
  tres palabras que no llevan a ninguna parte en el sitio donde el lector va
  precisamente a buscar a dónde ir. Y hacía que el pie y el menú dijeran cosas
  distintas, que es justo lo que este archivo existe para evitar.
*/
/*
  ⚠️ Antes era `[...SECCIONES, ...SECCIONES_PIE]`, para colar «Programación» que
  solo vivía en el pie. Desde el 2026-09-09 está en `SECCIONES` con «En vivo», así
  que la lista de arriba y la del pie vuelven a ser LA MISMA — que es lo que este
  archivo existe para garantizar.
*/
const todasLasSecciones = SECCIONES;
---

<footer class="mt-13 border-t-hairline border-borde-hairline bg-surface-base">
  <div class="px-pie py-12 pie-menu">
    <img
      src="/img/beat-blanco.svg"
      alt={estacion.nombre}
      width="126"
      height="30"
      class="mb-11 block h-[30px] w-auto"
    />

    <div class="grid gap-11 md:grid-cols-4 md:gap-grid">
      <nav aria-labelledby="pie-secciones">
        <h2 id="pie-secciones" class="t-label mb-6 font-bold text-text-primary">Nuestras Secciones</h2>
        <ul class="space-y-4 text-body-sm">
          {todasLasSecciones.map((s) => (
            <li>
              {s.pendiente ? (
                <span class="text-state-disabled-text">{s.largo}</span>
              ) : (
                <a href={s.href} class="text-text-muted transition-colors duration-2 ease-out hover:text-text-primary">
                  {s.largo}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="t-label mb-6 font-bold text-text-primary">Radio en vivo</h2>
        {/*
          ⚠️ Aquí iba «También escucha en» con la ficha de iHeartRadio. Salió el
          2026-09-11 con todo lo de iHeart, y como era la única plataforma de la
          lista se fue también el rótulo: una zona sin contenido se deja vacía y
          sin rótulo. La columna se queda con el enlace a la señal, que es lo que
          contesta la pregunta con la que alguien llega al pie.
        */}
        <p class="text-body-sm text-text-muted">
          Escucha nuestra señal <a href="/en-vivo" class="text-text-link underline decoration-borde-quiet underline-offset-4 transition-colors duration-2 ease-out hover:text-text-link-hover">aquí</a>.
        </p>
      </div>

      <div>
        <h2 class="t-label mb-6 font-bold text-text-primary">Síguenos en redes sociales</h2>
        {redes.length ? (
          <ul class="space-y-4 text-body-sm">
            {redes.map((r) => (
              <li>
                <a
                  href={r.url}
                  rel="noopener noreferrer me"
                  target="_blank"
                  class="text-text-muted transition-colors duration-2 ease-out hover:text-text-primary"
                >{r.red}</a>
              </li>
            ))}
          </ul>
        ) : (
          /* Degrada en silencio: hoy las cinco redes de la estación están en `null`
             en el CMS. Un hueco es mejor que cinco enlaces roto. */
          <p class="text-body-sm text-text-faint">Próximamente.</p>
        )}
      </div>

      <div>
        <h2 class="t-label mb-6 font-bold text-text-primary">Descarga nuestras apps</h2>
        <ul class="space-y-4 text-body-sm">
          {APPS.map((a) => (
            <li>
              {a.url ? (
                <a href={a.url} rel="noopener noreferrer" target="_blank" class="text-text-muted transition-colors duration-2 ease-out hover:text-text-primary">
                  {a.tienda}
                </a>
              ) : (
                /* Sin enlace hasta cerrar C1: las 4 estaciones tienen app en
                   tiendas y todavía no sabemos qué consume la de Beat del
                   WordPress viejo. Enlazar a algo que va a romperse en el corte es
                   peor que no enlazarlo. */
                <span class="text-state-disabled-text">{a.tienda}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  {/* LEGAL */}
  <div class="border-t-hairline border-borde-hairline">
    <div class="space-y-4 px-pie py-9">
      <p class="t-label max-w-[110ch] leading-relaxed text-text-faint">
        © {anio} {estacion.nombrePublicacion}. Todos los derechos reservados. El material de este
        sitio no puede reproducirse, distribuirse, transmitirse, almacenarse en caché ni utilizarse de
        otro modo, excepto con el permiso previo por escrito de NRM Comunicaciones.
      </p>
      <p class="t-label text-text-faint">
        {estacion.nombrePublicacion} y {estacion.nombre} son marcas registradas con derechos de autor
        de NRM Comunicaciones.
      </p>
    </div>
  </div>

  {/* TIRA DE MARCAS DE NRM */}
  <div class="border-t-hairline border-borde-hairline bg-surface-canvas">
    <div class="flex flex-wrap items-baseline justify-between gap-8 px-pie py-9">
      {MARCAS_NRM.map((m) => (
        <a
          href={m.url}
          rel="noopener noreferrer"
          target="_blank"
          aria-label={`${m.nombre} ${m.sub}`}
          class="marca-nrm"
        >
          {/*
            🔴 `loading="lazy"` y con medidas: el pie está al final de la página, así
            que estos cinco logos no tienen por qué competir por el ancho de banda con
            lo que el lector está mirando. Y sin `width`/`height` cada uno provocaría
            un salto de maquetado al llegar.

            El `alt` va vacío porque el nombre ya lo dice el `aria-label` del enlace:
            repetirlo haría que un lector de pantalla anunciara la marca dos veces.
          */}
          <img src={m.logo} alt="" width="150" height="150" loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </div>

  {/* ÚLTIMA LÍNEA */}
  <div class="border-t-hairline border-borde-hairline">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4 px-pie py-6">
      {/*
        🔴 Aquí había un `<a href="/marcas">Ventas</a>` escrito a mano, y era un
        bug doble: `/marcas` no existe todavía —está en `SECCIONES_FUTURAS` con
        `pendiente: true`, precisamente para que nadie la enlace— y además
        `LEGALES` YA trae «Ventas», apuntando al contacto de NRM. O sea que el pie
        pintaba la palabra dos veces: una a un 404 y otra al sitio correcto.

        ⚠️ La lección no es el enlace, es el atajo: la config marca lo que no
        existe y el bucle de abajo lo respeta, pero un `<a>` a mano se salta el
        mecanismo entero. Lo que va al pie sale de `navegacion.ts` o no va.
      */}
      {LEGALES.map((l) =>
        l.pendiente ? (
          <span class="t-label text-state-disabled-text">{l.largo}</span>
        ) : (
          <a href={l.href} class="t-label text-text-muted transition-colors duration-2 ease-out hover:text-text-primary">{l.largo}</a>
        ),
      )}
      <span class="t-label ml-auto text-text-faint">
        NRM Comunicaciones © {anio}. Todos los derechos reservados.
      </span>
    </div>
  </div>
</footer>

<style>
</style>

<style>
  /* ── La tira de marcas del corporativo ── */
  .marca-nrm img {
    display: block;
    width: auto;
    /*
      🔴 56px de caja, no 26. Los cinco archivos son lienzos CUADRADOS de 150x150
      con el logo dentro y aire alrededor: a 26px de alto, el trazo real quedaba en
      unos 13 y la tira parecía una fila de motas. Medido antes de subirlo.
    */
    height: 56px;
    /*
      🔴 A escala de grises, y no por capricho: el sitio va en blanco y negro
      (movimiento.md §8) y estos son cinco logos de marcas distintas, cada uno con
      su color. Puestos tal cual, la tira sería la única mancha de color del sitio
      — y además la más ruidosa, porque son cinco paletas que no conversan entre sí.

      Al pasar el cursor recupera brillo pero NO color: se ilumina, que es como
      responde todo lo demás en el sitio.
    */
    filter: grayscale(1) brightness(1.7) contrast(0.85);
    opacity: 0.55;
    transition:
      opacity var(--dur-2) var(--ease-out),
      filter var(--dur-2) var(--ease-out);
  }
  .marca-nrm:hover img {
    opacity: 1;
    filter: grayscale(1) brightness(2.1) contrast(0.9);
  }

  /*
    ── Marca de agua ──

    Del pie de v1, donde era el wordmark al 2% abajo a la derecha. Se conserva la
    idea y sube a 3.5%: aquí el fondo es más oscuro y al 2% no se distinguía.

    ⚠️ `z-index: -1` la deja DETRÁS del contenido del pie, y `pointer-events: none`
    evita que capture clics. Es textura, no contenido: no debe estorbar ni al ratón
    ni a un lector de pantalla —por eso es un pseudo-elemento y no un `<img>`—.

    ⚠️ Y el `isolation: isolate` del pie es lo que impide que ese `z-index: -1` se
    escape del pie y acabe detrás del fondo de la página, donde no se vería.
  */
  /*
    ⚠️ La marca de agua va en el bloque del MENÚ, no en el pie entero.
    Puesta en el pie, caía sobre el bloque legal —el texto más pequeño y menos
    contrastado de la página— y competía justo donde peor. Aquí queda detrás de las
    cuatro columnas, que es el bloque con aire para sostenerla.
  */
  .pie-menu {
    position: relative;
    isolation: isolate;
  }
  .pie-menu::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: -1;
    width: min(65%, 760px);
    height: 80%;
    background-image: url('/img/beat-blanco.svg');
    background-repeat: no-repeat;
    background-position: right bottom;
    background-size: contain;
    opacity: 0.035;
    pointer-events: none;
  }
</style>
