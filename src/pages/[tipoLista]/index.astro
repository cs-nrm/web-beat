---
/**
 * El índice de un tipo de lista — hoy, `/bonus-beat`.
 *
 * 🔴 La ruta es DINÁMICA y no `src/pages/bonus-beat/`. El primer segmento es el
 * `slug` de un documento de `tipos-de-lista`, que es dato editorial: la estación
 * crea «Bonus Beat» hoy y «Beat Ten» mañana, y las dos secciones tienen que
 * existir sin que nadie despliegue. Escribir la carpeta a mano habría dejado la
 * segunda en 404 el día que la crearan, y nadie se entera hasta que un lector lo
 * reporta.
 *
 * ⚠️ Por eso `bonus-beat` NO está en `SEGMENTOS_RESERVADOS` — está explicado
 * allí. Las rutas estáticas del sitio ganan igual a esta por especificidad, así
 * que lo único que hay que descartar aquí son los segmentos reservados que
 * todavía no tienen página.
 */
import Base from '@/layouts/Base.astro';
import CabezaSeccion from '@/components/CabezaSeccion.astro';
import BonusBeat from '@/components/inicio/BonusBeat.astro';
import RejillaEdiciones from '@/components/RejillaEdiciones.astro';
import Anuncio from '@/components/Anuncio.astro';
import { obtenerTipoDeLista, obtenerListas, obtenerListaReciente } from '@/lib/cms/listas';
import { fechaCorta } from '@/lib/nota';
import { MEDIDA_TARJETA, SEGMENTOS_RESERVADOS } from '@/config/site';

const { tipoLista: slug } = Astro.params;

/*
  Descarte barato antes de tocar el CMS. `comunidad`, `tienda`, `marcas`,
  `programacion`… todavía no tienen página propia, así que caerían aquí y
  dispararían una consulta por cada visita a una sección que no existe.
*/
if (!slug || (SEGMENTOS_RESERVADOS as readonly string[]).includes(slug)) {
  return Astro.rewrite('/404');
}

const tipo = await obtenerTipoDeLista(slug);
if (!tipo) return Astro.rewrite('/404');

/*
  🔴 DOS consultas, y no `ediciones[0]`, por una razón medida: las portadas de las
  canciones no salían en esta página.

  `obtenerListas` pide `depth: 1` —lo correcto para 24 ediciones—, y a esa
  profundidad `canciones[].cancion` llega poblada pero su `portada` sigue siendo un
  id. `urlMedia` devuelve `null` con un id, así que la última edición se pintaba con
  los tres huecos en degradado y sin una sola imagen. Lo mismo le pasaba al `audio`,
  o sea que el botón de reproducir tampoco podía aparecer. Comprobado contra el CMS:
  a `depth: 1` esas portadas llegan como `20`, `19`, `17`.

  ⚠️ La solución NO es subir `obtenerListas` a `depth: 2`: eso arrastraría el
  documento de media de cada canción de las 24 ediciones para pintar una retícula
  que solo necesita la portada de la edición —y esa sí llega con `depth: 1`—.

  `obtenerListaReciente` ya existe, ya pide `depth: 2` y trae exactamente el mismo
  documento: mismos `where`, mismo `sort: -fecha`, `limit: 1`. Y es la MISMA
  consulta que ya hace el Inicio para este tipo, así que acierta su entrada de caché
  y en la práctica no cuesta una consulta más.
*/
const [ediciones, reciente] = await Promise.all([
  obtenerListas(slug, 24),
  obtenerListaReciente(slug),
]);

/**
 * 🔴 La tarjeta de compartir de esta sección, por SLUG.
 *
 * Es la única de las seis que no puede escribir su imagen en el `<Base>`: la ruta
 * es dinámica, así que el archivo depende de qué tipo de lista se esté sirviendo.
 * Se declara igual —escrito, no detectado en disco— y quien no esté en la lista
 * cae al respaldo de marca, que es lo que tenían todas hasta ahora. Un tipo nuevo
 * en el CMS no rompe nada; solo comparte sin su nombre hasta que alguien le genere
 * la tarjeta (`scripts/favicon.mjs`) y la agregue aquí.
 *
 * 🔴 El `alt` viaja EN la lista y no se arma con `tipo.nombre`. Parece lo mismo y
 * no lo es: el texto está horneado en el PNG el día que se generó, así que si la
 * estación renombra el tipo en el admin, `tipo.nombre` cambiaría y la imagen no —y
 * el `alt` acabaría describiendo unas letras que no están en la foto. Un `alt` que
 * miente es peor que ninguno, porque solo lo lee quien no puede verificarlo.
 */
const TARJETAS_POR_TIPO: Record<string, { ruta: string; alt: string }> = {
  'bonus-beat': {
    ruta: '/img/og-bonus-beat.png',
    alt: 'El wordmark de Beat 100.9 y el rótulo BONUS BEAT, en blanco sobre el negro de la marca.',
  },
};

const tarjeta = TARJETAS_POR_TIPO[slug] ?? null;

---

{/*
  ⚠️ El respaldo de la descripción decía «Bonus Beat en Beat 100.9.» — el nombre de
  la sección seguido del de la casa, que no dice qué es la página. Y es el texto que
  se ve HOY: `tipos-de-lista.descripcion` está vacía en el CMS, así que nunca cae la
  de la redacción. Lo que se describe ahora es lo que la página hace: el índice de
  ediciones, con la más reciente pintada entera.

  ⚠️ Las tres etiquetas de la imagen van JUNTAS o no van: sin tarjeta propia se
  pasa `null` en las tres y el layout pone el respaldo con SUS medidas y su `alt`.
  Mezclarlas —la imagen de marca con el `alt` de una sección— es el fallo que estas
  etiquetas vienen a evitar. Ver `tarjeta` en el frontmatter.
*/}
<Base
  titulo={`${tipo.nombre} — Beat 100.9`}
  descripcion={
    tipo.descripcion ??
    `Las ediciones de ${tipo.nombre} en Beat 100.9, con la más reciente completa.`
  }
  imagen={tarjeta?.ruta ?? null}
  imagenAlt={tarjeta?.alt ?? null}
  imagenAncho={tarjeta ? MEDIDA_TARJETA.ancho : null}
  imagenAlto={tarjeta ? MEDIDA_TARJETA.alto : null}
>
  <div class="tl-pagina">
    <CabezaSeccion titulo={tipo.nombre.toUpperCase()} activa={`/${slug}`} />

    {
      reciente ? (
        <>
          {/*
            La última edición va ENTERA, no como una miniatura más de la retícula.
            Es lo que alguien viene a ver: quien entra a Bonus Beat quiere las
            canciones de esta semana, no un índice desde el que dar otro clic.
          */}
          <div class="tl-ultima">
            <div class="tl-corte">
              <span class="beat-display tl-corte-titulo">{reciente.titulo}</span>
              {fechaCorta(reciente.fecha) && (
                <span class="beat-label tl-corte-fecha">{fechaCorta(reciente.fecha)}</span>
              )}
            </div>
            <BonusBeat lista={reciente} tipo={tipo} contexto="edicion" />
          </div>

          {ediciones.length > 1 && (
            <>
              {/*
                El box marca el CORTE entre la edición de esta semana y el archivo,
                que es el único que tiene la página (aprobado por Carlos el
                2026-09-08).

                🔴 Y va DENTRO de esta condición justamente porque es un corte: si
                no hay ediciones anteriores no hay nada que cortar, y el box
                acabaría pegado al leaderboard del pie con solo aire entre los dos
                —una página que termina en dos anuncios seguidos—. Hoy es el caso
                real: `bonus-beat` tiene una sola edición capturada.
              */}
              <div class="tl-franja-box">
                <Anuncio formato="box" nombre="lista-box" unidad="Box" />
              </div>

              <div class="tl-corte tl-corte-archivo" data-barrido>
                <span class="beat-display tl-corte-titulo">EDICIONES ANTERIORES</span>
              </div>
              <RejillaEdiciones
                tipoSlug={slug}
                ediciones={ediciones}
                excluir={reciente.id}
              />
            </>
          )}
        </>
      ) : (
        <p class="tl-vacio">
          Todavía no hay ediciones publicadas de {tipo.nombre}. Cada edición es un
          documento de «listas» con este tipo y sus canciones.
        </p>
      )
    }

    <div class="tl-franja-anuncio">
      <Anuncio formato="leaderboard" nombre="lista-leader" />
    </div>
  </div>
</Base>

<style>
  .tl-pagina {
    max-width: var(--grid-max);
    margin: 0 auto;
  }
  .tl-ultima {
    padding: 0 24px;
  }
  .tl-corte {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-top: 32px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-quiet);
  }
  .tl-corte-archivo {
    margin: 44px 24px 0;
  }
  .tl-corte-titulo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--mist-2);
  }
  .tl-corte-fecha {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .tl-vacio {
    font: var(--type-body);
    color: var(--text-muted);
    max-width: 62ch;
    padding: 40px 24px 0;
    text-wrap: pretty;
  }
  .tl-franja-anuncio {
    padding: 44px 24px;
  }
  /* Menos aire por abajo que por arriba: el rótulo «EDICIONES ANTERIORES» trae su
     propio margen de 44px, y sumar los dos abría un vacío del alto del box. */
  .tl-franja-box {
    padding: 40px 24px 0;
  }

  @media (max-width: 899px) {
    .tl-ultima {
      padding: 0 16px;
    }
    .tl-corte {
      margin-top: 24px;
    }
    .tl-corte-archivo {
      margin: 32px 16px 0;
    }
    .tl-corte-titulo {
      font-size: 19px;
    }
    .tl-vacio {
      padding: 28px 16px 0;
      font: var(--type-body-sm);
    }
    .tl-franja-anuncio {
      padding: 32px 16px;
    }
    .tl-franja-box {
      padding: 30px 16px 0;
    }
  }
</style>
