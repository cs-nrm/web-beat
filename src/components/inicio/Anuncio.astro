---
/**
 * El hueco de publicidad.
 *
 * ⏳ Hoy pinta el MARCO, no el anuncio: los slots de GAM llegan con B6 paso 1. El
 * marco se construye igual desde el principio a propósito — si el espacio se
 * reserva después, todo lo que hay debajo se mueve cuando el anuncio carga, y eso
 * es CLS. Con la medida puesta desde ahora, el anuncio aparece dentro de un hueco
 * que ya existía.
 *
 * 🔴 Cuando se cablee GAM: el ad unit sale del env, NUNCA del código. En los repos
 * hermanos está pegado por copy-paste (`/<network>/StereoCien`), y servir
 * impresiones de una estación a la cuenta de otra es un bug de dinero.
 */
interface Props {
  /** Los tres formatos que el lienzo usa. */
  formato: 'portada' | 'leaderboard' | 'box';
  class?: string;
}

const { formato, class: clase } = Astro.props;
---

<div class:list={['anuncio', `es-${formato}`, clase]}>
  <span class="beat-label anuncio-rotulo">PUBLICIDAD</span>
  <div class="anuncio-hueco"></div>
</div>

<style>
  .anuncio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
  }
  .anuncio-rotulo {
    font-size: 8px;
    letter-spacing: 0.22em;
    color: var(--text-faint);
  }
  .anuncio-hueco {
    position: relative;
    width: 100%;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
  }

  /* El banner de portada va a sangre y con el rótulo ENCIMA, no arriba: es lo
     primero de la página y una línea de texto suelta antes del banner se lee como
     contenido del sitio. */
  .es-portada {
    position: relative;
    display: block;
    height: 350px;
    background: var(--noche-1);
    box-shadow: inset 0 -1px 0 var(--border-hairline);
  }
  .es-portada .anuncio-rotulo {
    position: absolute;
    left: 24px;
    top: 12px;
    z-index: 1;
    pointer-events: none;
  }
  .es-portada .anuncio-hueco {
    height: 100%;
    background: none;
    box-shadow: none;
  }

  .es-leaderboard .anuncio-hueco {
    max-width: 728px;
    aspect-ratio: 728 / 90;
  }
  .es-box .anuncio-hueco {
    width: 300px;
    height: 250px;
  }

  @media (max-width: 899px) {
    .es-portada {
      height: 110px;
    }
    .es-portada .anuncio-rotulo {
      left: 12px;
      top: 8px;
      font-size: 7px;
      letter-spacing: 0.2em;
    }
    /* 320×100 en móvil: el 728×90 no cabe en 390px. */
    .es-leaderboard .anuncio-hueco {
      width: 320px;
      max-width: 100%;
      aspect-ratio: 320 / 100;
    }
    .es-box .anuncio-hueco {
      width: 300px;
      max-width: 100%;
    }
  }
</style>
