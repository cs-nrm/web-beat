---
/**
 * La tarjeta de nota. Sirve a las tres densidades que el diseño usa, para que la
 * medida de una tarjeta viva en UN archivo y no en tres pantallas:
 *
 *   `rejilla`  14b/14e — la cuadrícula (3 columnas en escritorio, 2 en móvil)
 *   `fila`     14b/14e — «Más en Scanner»: foto de 160px, texto, botón redondo
 *   `relacionada` 14c/14f — las tres del pie de la nota
 *   `mosaico`  13a/14a — las laterales del mosaico: rejilla en escritorio y FILA
 *              en móvil, porque ahí la comparación con la portada es el problema
 *
 * 🔴 `mosaico` existe como variante de ESTE archivo y no como unas reglas
 * `:global()` dentro de `Mosaico.astro`, y es justo la razón por la que este
 * componente existe: la medida de una tarjeta vive en UN sitio. Escribir la fila
 * allá habría partido las medidas de la tarjeta en dos archivos, que es lo que la
 * cabecera de arriba dice que no debe pasar.
 *
 * 🔴 La cuadrícula NO lleva `gap` de color: el diseño pone `gap:2px` con el fondo
 * en `--border-hairline` y `padding:2px`, así que la línea que separa las tarjetas
 * ES el fondo del contenedor asomando. Por eso cada tarjeta necesita su propio
 * fondo opaco (`--noche-1`); si fuera transparente, se vería la rejilla completa.
 */
import Icono from './Icono.astro';
import { urlMedia } from '@/lib/cms/client';
import { nombreCategoria, fechaCorta } from '@/lib/nota';
import type { Noticia } from '@/types/payload';

interface Props {
  nota: Noticia;
  variante?: 'rejilla' | 'fila' | 'relacionada' | 'mosaico';
  /** `eager` solo para lo que está sobre el pliegue. El resto, `lazy`. */
  prioridad?: boolean;
}

const { nota, variante = 'rejilla', prioridad = false } = Astro.props;

const href = `/noticias/${nota.slug}`;
/**
 * 🔴 La FECHA, no el tiempo de lectura (decisión de Carlos, 2026-09-07).
 *
 * El «3 MIN» era una estimación nuestra —200 palabras por minuto sobre el árbol
 * Lexical— y con notas cortas todas salían iguales: cuatro tarjetas seguidas
 * diciendo «1 MIN» no distinguen nada. La fecha sí: es un dato editorial y es lo
 * que un lector usa para decidir si ya la vio.
 *
 * `fecha ?? createdAt` es el mismo reparto que usa la nota: si la redacción no
 * capturó fecha, la de creación es lo más cercano a la verdad.
 */
const fecha = fechaCorta(nota.fecha ?? nota.createdAt);
const cat = nombreCategoria(nota);
const foto = urlMedia(nota.imagen, variante === 'fila' ? 'card' : 'card');
---

<a href={href} data-luz class:list={['tarjeta', `es-${variante}`]}>
  {/*
    🔴 `transition:name` es lo que hace que la foto de esta tarjeta CREZCA hasta
    convertirse en el hero de la nota, en vez de que la página corte en seco. El
    navegador interpola entre las dos posiciones porque las dos comparten nombre.

    El nombre lleva el id de la nota, no el índice: tiene que ser único en la
    página Y coincidir con el de la otra. Dos elementos con el mismo nombre en una
    misma página anulan la transición sin avisar.
  */}
  <div class="tarjeta-foto" transition:name={`foto-nota-${nota.id}`}>
    {
      foto ? (
        <img
          src={foto}
          alt={nota.imagen && typeof nota.imagen === 'object' ? (nota.imagen.alt ?? '') : ''}
          loading={prioridad ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : null
    }
    <div class="beat-grid tarjeta-trama"></div>
  </div>

  <div class="tarjeta-cuerpo">
    <div class="tarjeta-meta">
      {
        variante === 'rejilla' ? (
          <>
            {/* Sin icono: un reloj junto a una fecha dice menos que la fecha sola,
                y es el mismo criterio que la firma de la nota, que va limpia. */}
            {fecha && <span class="beat-label tarjeta-fecha">{fecha}</span>}
            {cat && <span class="beat-label tarjeta-cat">{cat}</span>}
          </>
        ) : (
          <>
            {cat && <span class="beat-label tarjeta-cat-plana">{cat}</span>}
            {fecha && <span class="beat-label tarjeta-fecha-plana">{fecha}</span>}
          </>
        )
      }
    </div>
    <span class="tarjeta-titulo">{nota.titulo}</span>
  </div>

  {
    variante === 'fila' && (
      <span class="tarjeta-flecha" data-flecha>
        <Icono nombre="arrow-up-right" tamano={16} />
      </span>
    )
  }
</a>

<style>
  .tarjeta {
    display: block;
    background: var(--noche-1);
    color: inherit;
    text-decoration: none;
    transition: background var(--dur-2) var(--ease-out);
  }
  .tarjeta:hover {
    background: var(--noche-2);
  }

  .tarjeta-foto {
    position: relative;
    background: var(--grad-noche);
    overflow: hidden;
  }
  .tarjeta-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tarjeta-trama {
    position: absolute;
    inset: 0;
  }

  .tarjeta-meta {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .tarjeta-fecha,
  .tarjeta-fecha-plana {
    color: var(--text-muted);
    white-space: nowrap;
  }
  .tarjeta-fecha-plana {
    color: var(--text-faint);
    font-size: 9px;
  }
  .tarjeta-cat {
    padding: 7px 12px;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    color: var(--text-body);
    font-size: 9px;
    white-space: nowrap;
  }
  .tarjeta-cat-plana {
    color: var(--mist-0);
    font-size: 9px;
    white-space: nowrap;
  }

  /*
    🔴 3:2 en TODAS las fotos del sitio (Carlos, 2026-09-07).

    Es la proporción nativa de casi cualquier cámara, así que una foto capturada tal
    cual entra ENTERA en su caja: `object-fit: cover` no tiene nada que recortar.
    Antes cada superficie tenía la suya —16/10 aquí, 16/7 en la nota, 4/3 en móvil—
    y eso significaba que la misma foto se recortaba distinto en cada sitio donde
    aparecía: en la tarjeta salía una cara y en la nota salía media.
  */
  .tarjeta-foto {
    aspect-ratio: 3 / 2;
  }

  /* ── rejilla (14b: 3 col · 14e: 2 col) ── */
  /* `es-mosaico` es una rejilla EN ESCRITORIO: comparte todo con ella y solo se
     separa en móvil, más abajo. */
  .es-rejilla .tarjeta-meta,
  .es-mosaico .tarjeta-meta {
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px 0;
  }
  .es-rejilla .tarjeta-titulo,
  .es-mosaico .tarjeta-titulo {
    display: block;
    font: 700 19px / 1.22 var(--font-text);
    color: var(--mist-2);
    padding: 14px 18px 0;
    text-wrap: pretty;
  }
  .es-rejilla,
  .es-mosaico {
    padding-bottom: 18px;
  }

  /* ── fila (14b «Más en Scanner») ── */
  .es-fila {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) auto;
    align-items: center;
    gap: 22px;
    padding: 18px 10px;
    margin: 0 -10px;
    border-bottom: 1px solid var(--border-hairline);
    background: transparent;
  }
  .es-fila:hover {
    background: var(--surface-card-hover);
  }
  .es-fila .tarjeta-cuerpo {
    min-width: 0;
  }
  .es-fila .tarjeta-meta {
    gap: 10px;
  }
  .es-fila .tarjeta-titulo {
    display: block;
    font: 600 20px / 1.24 var(--font-text);
    color: var(--mist-2);
    margin-top: 10px;
    text-wrap: pretty;
  }
  .tarjeta-flecha {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--border-quiet);
    color: var(--mist-4);
  }
  .es-fila:hover .tarjeta-flecha {
    color: var(--mist-0);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  /* ── relacionada (14c, pie de la nota) ── */
  .es-relacionada .tarjeta-meta {
    gap: 10px;
    padding: 14px 0 0;
  }
  .es-relacionada .tarjeta-titulo {
    display: block;
    font: 600 17px / 1.26 var(--font-text);
    color: var(--mist-2);
    margin-top: 8px;
    text-wrap: pretty;
  }
  .es-relacionada {
    background: transparent;
  }
  .es-relacionada:hover {
    background: transparent;
  }
  .es-relacionada:hover .tarjeta-titulo {
    color: var(--mist-0);
  }
  /* El titular se enciende al pasar el cursor. Vive aquí y no en `beat.css`
     porque los estilos de componente van sin capa y le ganan a los que sí. */
  .tarjeta:hover .tarjeta-titulo {
    color: var(--mist-0);
  }

  @media (max-width: 899px) {
    .es-rejilla .tarjeta-meta {
      justify-content: flex-start;
      gap: 8px;
      padding: 12px 14px 0;
    }
    .es-rejilla .tarjeta-cat {
      padding: 0;
      background: none;
      box-shadow: none;
      color: var(--mist-0);
      font-size: 8px;
      /* Con dos columnas iguales las categorías de hoy caben, pero una más larga
         desbordaría: se trunca en vez de empujar. */
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .es-rejilla .tarjeta-fecha {
      order: 2;
      color: var(--text-faint);
      font-size: 8px;
    }
    .es-rejilla .tarjeta-titulo {
      font: 600 14.5px / 1.26 var(--font-text);
      padding: 10px 14px 0;
    }
    .es-rejilla {
      padding-bottom: 16px;
    }
    /* La fila pierde el botón redondo y encoge la foto: a 390px no caben. */
    .es-fila {
      grid-template-columns: 108px minmax(0, 1fr);
      gap: 14px;
      padding: 14px 0;
      margin: 0;
    }
    .es-fila .tarjeta-titulo {
      font-size: 15.5px;
      margin-top: 8px;
    }

    /*
      🔴 En MÓVIL la lateral del mosaico deja de ser tarjeta y pasa a FILA
      (Carlos, 2026-09-08).

      El problema medido no era que la portada fuese grande, era que era 2.08×
      más alta que estas —4.18× en superficie— y esa es justo la tierra de nadie:
      por debajo de 3:1 no se lee como otra categoría, y por encima de 2:1 no se
      lee como una igual. Se veía como «la misma tarjeta, inflada».

      Se resuelve cambiando el TIPO, no el tamaño: contra una fila con miniatura
      no hay comparación posible, porque no son dos medidas de lo mismo. De paso
      rompe la rejilla de cuatro tarjetas idénticas, que es el otro defecto que
      tenía esta pantalla.

      ⚠️ Reusa la medida de `es-fila` —miniatura de 108px, hueco de 14— para que el
      móvil no invente una tercera fila con otras proporciones. La única diferencia
      es que aquí SÍ lleva su filete abajo: en el mosaico las dos columnas laterales
      son dos contenedores distintos, así que la línea no puede venir del `gap` del
      padre como en escritorio.
    */
    .es-mosaico {
      display: grid;
      grid-template-columns: 108px minmax(0, 1fr);
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      background: var(--noche-1);
      box-shadow: inset 0 -1px 0 var(--border-hairline);
    }
    .es-mosaico .tarjeta-cuerpo {
      min-width: 0;
    }
    .es-mosaico .tarjeta-meta {
      gap: 8px;
      padding: 0;
    }
    .es-mosaico .tarjeta-fecha {
      order: 2;
      color: var(--text-faint);
      font-size: 8px;
    }
    .es-mosaico .tarjeta-cat {
      padding: 0;
      background: none;
      box-shadow: none;
      color: var(--mist-0);
      font-size: 8px;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .es-mosaico .tarjeta-titulo {
      font: 600 15.5px / 1.26 var(--font-text);
      padding: 6px 0 0;
      /*
        🔴 TRES líneas y lo que sobre se corta (Carlos, 2026-09-08).

        Con la miniatura en 108px, al titular le quedan 221px de ancho — y los
        titulares de esta redacción son largos: «Sub Focus convierte sus próximos
        conciertos en una forma de apoyar a la música independiente» ocupaba cinco
        líneas y hacía crecer la fila hasta desarmar la retícula que la fila viene
        a crear.

        ⚠️ Tres y no dos: en 221px, tres líneas son ~40 palabras, suficiente para
        que un titular recortado siga diciendo de qué es la nota. A dos se perdía
        el sujeto en los titulares que empiezan con el nombre del artista.

        ⚠️ `-webkit-box` es obligatorio para que `line-clamp` actúe, y no rompe el
        `grid` de la fila porque esto es el HIJO, no el contenedor. Se declara la
        propiedad estándar además de la prefijada: la prefijada la entienden todos
        los navegadores hoy, y la estándar es la que va a quedar.
      */
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      overflow: hidden;
    }
    .tarjeta-flecha {
      display: none;
    }
  }
</style>
