{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-beat",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "design",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4399",
        "--directory",
        "design/Nuevo sitio de beat full"
      ],
      "port": 4399
    },
    {
      "name": "web-beat-build",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "[ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\" && nvm use --silent; set -a; . ./.env; set +a; exec node ./dist/server/entry.mjs"
      ],
      "port": 4322,
      "autoPort": true
    }
  ]
}
