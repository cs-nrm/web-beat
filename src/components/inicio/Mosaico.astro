---
/**
 * El mosaico de portada — `300px | 1fr | 300px` en 13a.
 *
 * La columna del centro es el retrato principal en 3:2, con las tres estelas del
 * DS encima; a los lados dos notas por columna, que se estiran al alto de la
 * columna. En móvil (14a) se convierte en portada a lo ancho + rejilla de 2, que es
 * lo que ya hace `TarjetaNota`.
 *
 * 🔴 Igual que en Scanner: el `gap: 2px` con el fondo en `--border-hairline` es la
 * línea que separa las piezas, así que cada pieza necesita fondo OPACO propio.
 */
import TarjetaNota from '@/components/TarjetaNota.astro';
import { urlMedia } from '@/lib/cms/client';
import { nombreCategoria, fechaCorta } from '@/lib/nota';
import type { Noticia } from '@/types/payload';

interface Props {
  portada: Noticia | null;
  izquierda: Noticia[];
  derecha: Noticia[];
}

const { portada, izquierda, derecha } = Astro.props;

const foto = urlMedia(portada?.imagen, 'large');
// La fecha, no los minutos de lectura. Ver `TarjetaNota.astro`.
const fecha = fechaCorta(portada?.fecha ?? portada?.createdAt);
const cat = portada ? nombreCategoria(portada) : null;
const alt = portada?.imagen && typeof portada.imagen === 'object' ? (portada.imagen.alt ?? '') : '';
---

{
  portada && (
    <div class="mosaico">
      <div class="mosaico-lado">
        {izquierda.map((n) => (
          <TarjetaNota nota={n} variante="mosaico" />
        ))}
      </div>

      <a href={`/noticias/${portada.slug}`} class="mosaico-centro" data-luz>
        <div class="mosaico-foto" transition:name={`foto-nota-${portada.id}`}>
          {foto && <img src={foto} alt={alt} fetchpriority="high" decoding="async" />}
          <div class="beat-grid mosaico-trama" />
          {/* Las tres estelas: el motivo de marca del DS, con las posiciones de 13a. */}
          <div class="mosaico-estelas" aria-hidden="true">
            <div class="beat-streak es-1" />
            <div class="beat-streak is-soft es-2" />
            <div class="beat-streak is-thin es-3" />
          </div>
        </div>
        <div class="mosaico-meta">
          {fecha && <span class="beat-label mosaico-fecha">{fecha}</span>}
          {cat && <span class="beat-label mosaico-cat">{cat}</span>}
        </div>
        <h2 class="mosaico-titulo" data-escribir>{portada.titulo}</h2>
        {portada.resumen && <p class="mosaico-bajada">{portada.resumen}</p>}
      </a>

      <div class="mosaico-lado">
        {derecha.map((n) => (
          <TarjetaNota nota={n} variante="mosaico" />
        ))}
      </div>
    </div>
  )
}

<style>
  .mosaico {
    display: grid;
    /*
      🔴 PROPORCIONALES, no una lateral fija con el centro elástico.

      El lienzo dibuja 300 / 676 / 300 a 1280, o sea 1 : 2.25 : 1. Con la lateral
      fija en 300px, todo el ancho extra se lo comía el centro: medido a 1920, la
      columna central llegaba a 1316px —más de cuatro veces las laterales— con una
      foto de 1316×1119. Con `fr` la composición del lienzo se conserva a cualquier
      ancho.

      El `minmax` pone piso a las laterales para que no se encojan hasta dejar de
      leerse. Con 220px las tres columnas aguantan hasta el corte móvil (900px):
      220 + 456 + 220 + gaps = 900 justo.
    */
    grid-template-columns: minmax(220px, 1fr) minmax(0, 2.25fr) minmax(220px, 1fr);
    gap: 2px;
    background: var(--border-hairline);
    padding: 2px 0;
  }
  /*
    🔴 TODO lo de la columna lateral vive dentro de `min-width: 900px`, y no fuera
    con un `@media` que lo deshaga después.

    Estaba al revés y costó una tarde: estas reglas llevan dos clases, así que le
    GANAN por especificidad a las de `TarjetaNota`. Con ellas en la base, la fila
    de móvil no se pintaba —salía una miniatura de 375×250 en vez de 108×72— y
    deshacerlas desde el bloque de móvil no funciona: `display: revert` vuelve al
    valor del NAVEGADOR, no a la regla anterior del autor, así que también mata el
    `display: grid` de la variante. Acotarlas es la única forma limpia.
  */
  @media (min-width: 900px) {
    .mosaico-lado {
      display: flex;
      flex-direction: column;
      /*
        🔴 Fondo OSCURO, y la línea como borde explícito.

        Antes esta columna usaba el truco de `gap` + fondo `--border-hairline`. El
        truco funciona cuando el gris solo asoma en 2px, pero una columna de
        rejilla se estira al alto de la fila: en cuanto el centro es más alto que
        las dos tarjetas de al lado, TODO el sobrante se pinta de gris. Medido a
        1920: la columna medía 1263px y sus tarjetas ~800.
      */
      background: var(--noche-1);
    }
    .mosaico-lado > * + * {
      border-top: 2px solid var(--border-hairline);
    }
    /*
      Las dos tarjetas se REPARTEN el alto de la columna en vez de dejar sobrante.

      Una rejilla estira sus columnas al alto de la más alta, y el centro casi
      siempre gana: antes quedaban entre 100 y 650px muertos al pie de cada
      lateral según el ancho. Con `flex: 1` en la tarjeta y en su foto, la imagen
      absorbe la diferencia recortando —ya lleva `object-fit: cover`— y el bloque
      se ve deliberado a cualquier ancho, no con un hueco al final.
    */
    .mosaico-lado > :global(.tarjeta) {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .mosaico-lado :global(.tarjeta-foto) {
      flex: 1;
      min-height: 120px;
      aspect-ratio: auto;
    }
  }
  .mosaico-centro {
    display: block;
    background: var(--noche-1);
    color: inherit;
    text-decoration: none;
    padding-bottom: 26px;
    transition: background var(--dur-2) var(--ease-out);
  }
  .mosaico-centro:hover {
    background: var(--noche-2);
  }
  .mosaico-centro:hover .mosaico-titulo {
    color: var(--mist-0);
  }
  .mosaico-foto {
    position: relative;
    /*
      3:2, como el resto del sitio (ver `TarjetaNota.astro`). Era `4 / 3.4`, más
      alta que ancha, para que la columna del centro pesara más que las de los
      lados. Ese peso ahora lo da el ANCHO de la columna, que no cambió: la portada
      sigue siendo la pieza grande, pero deja de recortar la foto por los costados.
    */
    aspect-ratio: 3 / 2;
    background: var(--grad-noche);
    overflow: hidden;
  }
  .mosaico-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mosaico-trama,
  .mosaico-estelas {
    position: absolute;
    inset: 0;
  }
  .mosaico-estelas {
    pointer-events: none;
  }
  .es-1 {
    left: 14%;
    right: 34%;
    top: 36%;
  }
  .es-2 {
    left: 26%;
    right: 12%;
    top: 44%;
  }
  .es-3 {
    left: 38%;
    right: 28%;
    top: 52%;
  }
  .mosaico-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 24px 0;
  }
  .mosaico-fecha {
    color: var(--text-muted);
    font-size: 9.5px;
    white-space: nowrap;
  }
  .mosaico-cat {
    padding: 7px 12px;
    background: var(--surface-card);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
    color: var(--text-body);
    font-size: 9px;
    white-space: nowrap;
  }
  .mosaico-titulo {
    font: var(--type-title-1);
    letter-spacing: -0.022em;
    color: var(--mist-1);
    margin: 14px 0 0;
    padding: 0 24px;
    text-wrap: pretty;
  }
  .mosaico-bajada {
    font: var(--type-body);
    color: var(--text-muted);
    margin: 12px 0 0;
    padding: 0 24px;
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* ── 14a: una columna ── */
  @media (max-width: 899px) {
    .mosaico {
      grid-template-columns: 1fr;
      padding: 0;
      gap: 0;
      background: none;
    }
    /*
      🔴 La PORTADA va primero (Carlos, 2026-09-08). En el DOM va en medio —lado,
      centro, lado— porque en escritorio esas son tres columnas y el orden es el de
      izquierda a derecha. En una sola columna ese mismo orden dejaba la nota
      principal SANDWICHADA entre dos pares de tarjetas secundarias, así que la
      foto grande no se leía como «la nota del día» sino como un bloque enorme que
      aparecía de la nada a media pantalla.

      Es además lo que la cabecera de este archivo ya decía que debía pasar
      —«portada a lo ancho + rejilla de 2»—: el código se había separado de su
      propio diseño y nadie lo notó porque en escritorio se ve bien.

      ⚠️ Se hace con `order` y NO reordenando el marcado: en escritorio el orden
      del DOM ES el orden visual, y moverlo allí para arreglar el móvil rompería la
      composición de tres columnas. `order` solo actúa dentro de esta media query.

      ⚠️ Y el orden del DOM es también el del TABULADOR, que no sigue a `order`.
      Aquí no molesta: las cinco son enlaces a notas de la misma sección y ninguna
      es un control, así que recorrerlas en un orden y verlas en otro no deja a
      nadie perdido. Si algún día entra un control en el mosaico, esto se revisa.
    */
    .mosaico-centro {
      order: -1;
    }
    .mosaico-centro {
      padding-bottom: 20px;
    }
    .mosaico-foto {
      aspect-ratio: 3 / 2;
    }
    .mosaico-meta {
      padding: 16px 16px 0;
    }
    .mosaico-cat {
      font-size: 8.5px;
    }
    .mosaico-titulo {
      font: 700 25px / 1.14 var(--font-text);
      letter-spacing: -0.016em;
      margin-top: 12px;
      padding: 0 16px;
    }
    .mosaico-bajada {
      font: 400 14.5px / 1.5 var(--font-text);
      padding: 0 16px;
      max-width: none;
    }
/*
      🔴 UNA columna, no dos (Carlos, 2026-09-08). Las laterales pasan a FILAS
      —miniatura y titular al lado— y una fila ocupa el ancho entero: partirlas en
      dos columnas de 187px dejaría una miniatura de 108 con 65px para el titular.

      La razón de fondo está en `TarjetaNota.astro`, en la regla `es-mosaico` de
      móvil: contra la portada, dos tarjetas del mismo tipo a 4.18× de superficie
      se leen como la misma pieza inflada, y el arreglo es cambiar el tipo.

      ⚠️ Se va también el truco del `gap` con fondo gris: con filas apiladas la
      línea la pone cada fila (su `box-shadow` inferior), porque las laterales son
      DOS contenedores y una línea de `gap` no cruzaría de uno al otro.
    */
    .mosaico-lado {
      display: block;
      background: none;
      padding: 0;
      gap: 0;
    }
    /* ⚠️ Nada que deshacer aquí: lo de la columna lateral está acotado a
       `min-width: 900px` a propósito. Ver el comentario de arriba. */
  }
</style>
